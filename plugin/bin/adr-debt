#!/usr/bin/env python3
"""adr-debt — surface deferred scope + open follow-ups across an ADR corpus.

Usage: adr-debt <adr-dir> [<adr-dir> ...]

Scans every *.md under each dir (ADRs and task files) for:
  - Out of Scope bullets tagged `(deferred: <pointer>)`
  - unchecked Follow-ups items (`- [ ]`)
Files named architecture.md are scanned line-by-line instead: any `(deferred: <pointer>)`
counts (rule rows whose check doesn't exist yet). Pass the arch doc's dir too when it lives
outside the ADR dir: `adr-debt docs/adr docs`.

Typed `(permanent...)` entries are either chosen boundaries or cited facts;
neither kind is reported. Legacy permanent spellings remain unswept too.
Pointers that look like a file path or an ADR id must resolve (relative to the
file, the scanned dir, or the git root); prose/URL/F-n pointers are listed as-is.

Exit: 0 = report printed, every path/ADR pointer resolves
      1 = malformed pointer (deferred with nothing after the colon) or
          a path/ADR pointer that resolves to nothing

The loop: run this at /adr-write time. Every reported item is either pulled
into the new ADR's Context, re-deferred with a fresh pointer, or classified as
`(permanent: boundary: <reason>)` / `(permanent: fact: <claim>; citation: <typed receipt>)`.
Debt that is never surfaced is debt that was silently dropped — this report is the
surfacing mechanism.
"""
import datetime
import re
import subprocess
import sys
from pathlib import Path

# --- win32 utf-8 io (D1 fix) -------------------------------------------------
# Windows defaults stdout/stderr and open() to the ANSI codepage. These tools
# print and WRITE `·` and `—`; under cp1252 a `·` lands as a bare 0xB7 byte,
# which is not valid UTF-8, so an append-only evidence file becomes undecodable.
# Child process output decodes with that same default, so the git probe below
# names its encoding rather than inheriting the codepage.
import sys as _sys
for _s in (_sys.stdout, _sys.stderr):
    try:
        _s.reconfigure(encoding="utf-8", errors="replace")
    except Exception:
        pass
# ---------------------------------------------------------------------------


def disposition_span(text):
    """The balanced `(permanent…)` / `(deferred:…)` group in `text`, as (inner, start, end).

    Scanned by paren DEPTH rather than matched with `[^)]*`, which cannot cross
    the `)` of a nested pair. Measured 2026-08-28 on one bullet reading
    `(permanent: the `archive()` helper keeps originals)`: adr-lint advised that
    it carried no disposition at all, and adr-debt reported it as a BROKEN
    [malformed] pointer — a finding about a bullet that visibly complies. The
    architecture.md scan was worse again, capturing a TRUNCATED pointer and
    resolving that, so it named a path nobody wrote.

    None when no such group is balanced. Callers apply their own keyword and
    position tests; this answers only "where does the disposition actually end".

    ONE BODY, THREE COPIES — adr-lint, adr-debt and adr-retire-check are
    standalone scripts with no import path between them (ADR-011: a shared file
    under bin/ acquires a generated forwarder). `tests/gate-regressions.py`
    holds the one truth table all three are checked against, the way ADR-009
    binds `enforcement_pointers` to `declaredEnforcement`.
    """
    for opening in re.finditer(r"\((?=permanent\b|deferred\b|external\b)", text):
        depth = 0
        for i in range(opening.start(), len(text)):
            if text[i] == "(":
                depth += 1
            elif text[i] == ")":
                depth -= 1
                if depth == 0:
                    return text[opening.start() + 1:i], opening.start(), i + 1
    return None


SCOPE_BULLET = re.compile(r"^\s*(?:[-*]|\d+\.)\s+\S")
SCOPE_CONTINUATION = re.compile(r"^\s+\S")


def scope_bullets(lines):
    """Each Out of Scope bullet WITH the indented lines that continue it.

    A DISPOSITION MAY WRAP, and reading these line by line said it did not.
    `- **Every improvement surfaced in the same session** (deferred: each\n
    needs its own issue).` shows `(deferred: each` with no closing paren on the
    line that starts the bullet, so adr-lint advised "needs a disposition" and
    adr-debt reported BROKEN [malformed] with an EMPTY pointer — about a bullet
    that is well-formed Markdown.

    THE RULE WAS ALREADY DECIDED HERE, one gate over. `adr-judge::bullets` does
    exactly this and its docstring says why, dated 2026-08-27: two well-formed
    records were flagged and "both were 'fixed' by moving words onto line one,
    which is an author reshaping prose to suit a parser. A gate with false alarms
    is one people learn to skip, and then it protects nothing." That reasoning was
    never carried to the Out of Scope readers. Reported 2026-08-29 from an
    adopting corpus, and it flagged this project's own ADR-012 the same hour.

    A blank line or an unindented line ends the bullet — the two ways Markdown
    itself ends one, so nothing swallows the paragraph that follows.
    """
    found, current, indent, subtree = [], None, 0, None
    for line in lines:
        lead = len(line) - len(line.lstrip())
        # Every bullet below the one that opened a child list belongs to that
        # list, not just the first: suppressing only the first child left the
        # second reported as an entry needing its own disposition.
        if subtree is not None and SCOPE_BULLET.match(line) and lead > subtree:
            continue
        # A DEEPER BULLET IS A CHILD, not a sibling. An Out of Scope entry may
        # enumerate what it defers as an indented list, and each child was being
        # read as an entry of its own and told it needed its own disposition —
        # four pointers to the one issue the parent already defers as a unit.
        # Reported 2026-08-29 from an adopting corpus, and checked against the
        # unedited file so it was not confused with the wrap fix shipped beside
        # it. Indentation is what Markdown uses to say "child", so it is what
        # this reads.
        if SCOPE_BULLET.match(line):
            if current is not None and lead > indent:
                # A child list ENDS the parent entry rather than extending it.
                # The parent's disposition closes the parent's own text; joining
                # the children on would put prose after it and report the entry
                # as trailing-prose, which is the same false alarm one branch
                # over. The children are not entries either — they are the
                # enumeration the parent defers as one unit.
                found.append(current)
                current = None
                subtree = indent
                continue
            subtree = None
            if current is not None:
                found.append(current)
            current = line.strip()
            indent = lead
        elif current is None:
            continue
        elif not line.strip() or not SCOPE_CONTINUATION.match(line):
            found.append(current)
            current = None
        else:
            current += " " + line.strip()
    if current is not None:
        found.append(current)
    return found


def closes_the_line(text, end):
    """Whether a parenthetical ending at `end` is the last thing on the line.

    TRAILING SENTENCE PUNCTUATION IS TOLERATED. `(deferred: notes.md).` is a
    disposition somebody ended a sentence after, and rejecting it was not merely
    strict — adr-debt then fell through to its `malformed` branch and printed
    `BROKEN [malformed] … ('')`, the vocabulary for "deferred with nothing after
    the colon", about a pointer that is right there in the line. A gate reporting
    an observation it did not make (ADR-005, CLAUDE.md §3).

    Reported 2026-08-29 against v2.31.1 by a session on an adopting corpus where
    ALL FIFTEEN of its broken-pointer findings were this shape, every one of them
    well-formed, blocking at exit 1 — the "a corpus adopting this on a tree it did
    not write lights up on day one" case ADR-011 was explicitly designed against.

    A SECOND PARENTHETICAL IS STILL NOT PUNCTUATION: `(permanent: why) (see also)`
    leaves `(see also)` behind and does not close the line. That distinction is
    what this function keeps, and it is the reason it is not simply dropped.
    """
    return text[end:].strip(" \t.,;:") == ""


def external_target_of(inner):
    """The `(external: <where>: <pointer>)` parts, or None if it is not one.

    ADR-024 T2. §82: a corpus that is one half of a cross-repo decision cites a
    record this tree cannot hold, and `adr-debt` called that BROKEN — permanently
    red, and the author ended up writing the excuse into the pointer text where no
    linter can read it.

    ⚠ `<where>` IS REQUIRED, and that is the whole value of the row: the column
    exists to answer "who owns this", and a declaration without an owner answers
    nothing. Returns None when it is missing, so the entry falls through to the
    malformed branch rather than silently counting as declared.
    """
    if inner is None or not inner.startswith("external:"):
        return None
    rest = inner[len("external:"):].strip()
    where, _, pointer = rest.partition(":")
    if not where.strip() or not pointer.strip():
        return None
    return where.strip(), pointer.strip()


def deferred_pointer_of(inner):
    """The pointer inside a `deferred: …` disposition, or None if it is not one.

    An EMPTY pointer is still a `deferred:` disposition and comes back as `""`,
    not None. The two are different findings and always have been: `""` reaches
    `resolve` and is reported BROKEN [empty] — debt recorded by someone who had
    not decided where it goes — while None means the parenthetical is not a
    deferral at all, which is the `malformed` branch.
    """
    if inner is None or not inner.startswith("deferred:"):
        return None
    return inner[len("deferred:"):].lstrip()


def deferred_pointer(line):
    """The pointer of the first balanced `(deferred: …)` anywhere in `line`.

    Unanchored, for architecture.md, whose deferrals are prose rather than
    Out of Scope bullets.
    """
    span = disposition_span(line)
    return deferred_pointer_of(span[0]) if span else None


def sections_of(text):
    out, cur, fence = {}, None, False
    for line in text.splitlines():
        if line.lstrip().startswith("```"):
            fence = not fence
        m = None if fence else re.match(r"^## (.+?)\s*$", line)
        if m:
            cur = m.group(1)
            out[cur] = []
        elif cur is not None:
            out[cur].append(line)
    return out


def git_root(d):
    try:
        r = subprocess.run(["git", "-C", str(d), "rev-parse", "--show-toplevel"],
                           capture_output=True, text=True, timeout=10,
                           encoding="utf-8", errors="replace")
        if r.returncode == 0:
            return Path(r.stdout.strip())
    except Exception:
        pass
    return None


def resolve(pointer, md_file, scan_dir):
    """Return (kind, ok). Path-like and ADR-id pointers must resolve; rest pass."""
    p = pointer.strip().strip("`")
    if not p:
        return "empty", False
    if p.startswith(("http://", "https://")):
        return "url", True
    # THE LEADING TOKEN, when it is a record id, and the prose after it is prose.
    # This corpus's own ADR template already states the rule for `Invalidates:`
    # — "only the leading token, because the prose after it is prose: `ADR-001 —
    # the clause of its Decision reading …` is one pointer and a sentence, not a
    # list" — and it was never carried to a deferral pointer, which is written
    # the same way. Reported 2026-08-29 from an adopting corpus: a pointer
    # reading "ADR-028 T4, in this record's `tasks/` — …" resolved the stray
    # token `tasks/` as a PATH, found nothing, and reported BROKEN [path] about a
    # record and task that both exist.
    lead = re.match(r"^(ADR-?\s?\d+)(?![\w-])", p, re.I)
    if lead:
        return _resolve_adr_id(lead.group(1), scan_dir)
    ptoks = [t.strip("`,.;:") for t in p.split()
             if "/" in t or t.endswith(".md")]
    if ptoks:
        roots = [md_file.parent, scan_dir]
        root = git_root(md_file.parent)
        if root:
            roots.append(root)
        return "path", any((r / t).exists() for t in ptoks for r in roots)
    m = re.search(r"(?<!\w)(ADR-?\d+)(?!\w)", p, re.I)
    if m:
        return _resolve_adr_id(m.group(1), scan_dir)
    return "ref", True  # F-n, issue key, prose — listed, not resolved here


def _resolve_adr_id(token, scan_dir):
    """("adr", whether this corpus holds a record with that number).

    One body, two callers — the leading-token test above and the anywhere-in-the
    -string fallback below it — because two copies of a resolver is how the two
    come to disagree about what counts as the same record (ADR-009).
    """
    pat = re.sub(r"[-_\s]", "", token).lower()
    hits = [f for f in scan_dir.rglob("*.md")
            if pat in re.sub(r"[-_]", "", f.stem).lower()] + \
           [d for d in scan_dir.rglob("*") if d.is_dir()
            and pat == re.sub(r"[-_]", "", d.name).lower()]
    return "adr", bool(hits)


def adr_id_of(md_file, scan_dir):
    """The ADR this file belongs to: its own name, or the nearest ancestor's."""
    for part in [md_file.name] + [d.name for d in md_file.parents]:
        m = re.search(r"(?<!\w)ADR-?(\d+)(?!\w)", part, re.I)
        if m:
            return "ADR-" + m.group(1)
    return None


def unswept(pointer, md_file, scan_dir):
    """(is_unswept, dest) — the pointer resolves, but into a place NOTHING sweeps.

    A deferral into an archive is undeliverable by construction, and it is strictly worse than an
    unreceipted one: there, writing the entry at the destination fixes it. Here it cannot, because
    an archive is deliberately outside active debt sweeps.

    Measured 2026-08-21: three of five unreceipted deferrals in one corpus pointed at archived ADRs
    — each pointer resolved, each read as filed, and none could ever resurface. An archived ADR is a
    decision record; future work belongs somewhere a sweep will find it.
    """
    kind, ok = resolve(pointer, md_file, scan_dir)
    if kind != "path" or not ok:
        return False, None
    t = pointer.strip().strip("`").split()[0].rstrip(",.;")
    for part in Path(t).parts:
        if "archive" in part.lower():
            return True, t
    return False, None


def receipted(pointer, md_file, scan_dir, src_id):
    """Does the destination this deferral points at actually MENTION the source?

    A pointer that resolves is not a pointer that was honoured. Measured
    2026-08-20 on a nine-ADR corpus: 19 of 33 deferrals named a real file that
    had never heard of them, so the sweep followed every one and reported clean.
    That is the same shape as a capability that is finished and unreachable —
    the link exists, the receiving end does not know it.

    Returns (checked, ok, dest). checked=False means this is not a path pointer,
    or it points back into the ADR's own tree, where naming itself proves nothing.
    """
    if not src_id:
        return False, True, None
    p = pointer.strip().strip("`")
    toks = [t.strip("`,.;:") for t in p.split() if "/" in t or t.endswith(".md")]
    roots = [md_file.parent, scan_dir]
    root = git_root(md_file.parent)
    if root:
        roots.append(root)
    for t in toks:
        for r in roots:
            dest = r / t
            if not dest.is_file():
                continue
            if adr_id_of(dest, scan_dir) == src_id:
                return False, True, None  # same ADR's own tree
            pat = re.sub(r"[-_]", "", src_id).lower()
            body = re.sub(r"[-_]", "", dest.read_text(errors="replace", encoding="utf-8")).lower()
            return True, pat in body, dest
    return False, True, None


def reject_unknown_flags(known=()):
    """A flag this gate does not know is a typo, and a gate that ignores one
    answers a question nobody asked.

    Measured 2026-08-26: `adr-next tasks --jsonn` printed the human report and
    exited 0. lifecycle.mjs asks for `--json` and JSON.parse()s the result inside
    a try/catch that continues on failure, so a renamed or mistyped flag would
    have made session orientation silently empty at exit 0 — the same fail-open,
    by a different route, as the `#!` spawn that BACKLOG item 17 fixed.
    """
    unknown = [a for a in sys.argv[1:] if a.startswith("--") and a not in known]
    if unknown:
        print(f"unknown option: {unknown[0]}", file=sys.stderr)
        sys.exit(1)


def main():
    reject_unknown_flags()
    if len(sys.argv) < 2:
        print(__doc__)
        sys.exit(1)
    dirs = [Path(d) for d in sys.argv[1:]]
    for d in dirs:
        if not d.is_dir():
            print(f"not a directory: {d}")
            sys.exit(1)

    deferred, followups, broken, unreceipted = [], [], [], []
    externals = []
    undecided = []
    unswept_items = []
    # ADR-014 T3. Waiting is not debt, and the two must not share a number.
    # `deferred` means work punted with a POINTER to where it was filed; a
    # Blocked-on task's pointer is an event in the world. Counting them together
    # would silently change what the deferred number has always meant, which this
    # task's Stop Condition forbids -- a number that changes definition is worse
    # than a missing one.
    waiting = []
    for scan_dir in dirs:
        for md in sorted(scan_dir.rglob("*.md")):
            text = md.read_text(errors="replace", encoding="utf-8")
            secs = sections_of(text)
            rel = md.relative_to(scan_dir)
            if md.name == "architecture.md":
                for ln in text.splitlines():
                    pointer = deferred_pointer(ln)
                    if pointer is not None:
                        kind, ok = resolve(pointer, md, scan_dir)
                        item = (scan_dir, rel, pointer.strip(), ln.strip()[:70])
                        deferred.append(item)
                        if not ok:
                            broken.append(item + (kind,))
                        chk, got, dest = receipted(pointer, md, scan_dir,
                                                   adr_id_of(md, scan_dir))
                        if chk and not got:
                            unreceipted.append(item + (dest,))
                        dead, where = unswept(pointer, md, scan_dir)
                        if dead:
                            unswept_items.append(item + (where,))
                continue
            for s in scope_bullets(secs.get("Out of Scope", [])):
                span = disposition_span(s)
                trailing = span if span and closes_the_line(s, span[2]) else None
                pointer = deferred_pointer_of(trailing[0]) if trailing else None
                # ADR-024 T2. Declared as owned elsewhere: counted in its own
                # column, never resolved, exit 0. The author asserted it, and a
                # typo does not produce a declaration — which is why this is a
                # keyword rather than a heuristic over the pointer's shape.
                external = external_target_of(trailing[0]) if trailing else None
                if external is not None:
                    externals.append((scan_dir, rel, external[0], external[1],
                                      s[2:trailing[1]].strip()))
                elif pointer is not None:
                    kind, ok = resolve(pointer, md, scan_dir)
                    item = (scan_dir, rel, pointer.strip(), s[2:trailing[1]].strip())
                    deferred.append(item)
                    if not ok:
                        broken.append(item + (kind,))
                    chk, got, dest = receipted(pointer, md, scan_dir,
                                               adr_id_of(md, scan_dir))
                    if chk and not got:
                        unreceipted.append(item + (dest,))
                    dead, where = unswept(pointer, md, scan_dir)
                    if dead:
                        unswept_items.append(item + (where,))
                elif span and re.match(r"external\b", span[0] or ""):
                    # ADR-024 T2. An `external:` that names no owner is not a
                    # declaration — the column exists to answer "who owns this".
                    # Reported rather than dropped: silently ignoring it would let
                    # a half-written declaration read as a settled one, which is
                    # the state this disposition was added to make impossible.
                    broken.append((scan_dir, rel, (span[0] or "").strip(),
                                   s[2:72].strip(), "external-no-owner"))
                elif span and re.match(r"deferred\b", span[0] or ""):
                    # A REAL DISPOSITION IN THE WRONG PLACE is not an empty one.
                    # Reported 2026-08-29: a bullet reading `… (deferred: each
                    # needs its own issue). Folding any of them in would …` was
                    # reported BROKEN [malformed] with pointer '' — the vocabulary
                    # for "nothing after the colon" — when the pointer is present
                    # and the actual fault is that prose follows it. A reader sent
                    # to look for a missing pointer finds one and concludes the
                    # gate is wrong (ADR-005; CLAUDE.md §3).
                    broken.append((scan_dir, rel, span[0], s[2:72], "trailing-prose"))
                elif re.search(r"\(deferred\b", s):
                    broken.append((scan_dir, rel, "", s[2:72], "malformed"))
            for ln in secs.get("Follow-ups", []):
                s = ln.strip()
                if s.startswith("- [ ]"):
                    item = s[5:].strip()
                    # An explicit statement of ABSENCE is not an open item. The task
                    # template's own literal is `- [ ] (none at authoring)`, and
                    # counting it reported "nothing was deferred" as "one thing is
                    # open" -- inflating the total and, worse, teaching authors to
                    # DELETE the honest placeholder. That is BACKLOG §73's incentive
                    # inversion again: the truthful form is the one that costs you.
                    # Reported 2026-08-30 by pirkiniukampelis-cms-laravel-3d.
                    if re.fullmatch(r"\(?\s*none\b[^)]*\)?\.?", item, re.I):
                        continue
                    followups.append((scan_dir, rel, item))
            # A task waiting on an external event, and how long it has waited.
            #
            # Age comes from the newest dated EVIDENCE ROW anywhere in the task --
            # Verification Log or Mutation Log, since both are tool-written and
            # either one means somebody demonstrably looked at this task that day.
            # Scoping it to the Verification Log alone would call a task stale
            # while its mutation evidence was recorded last week. The regex is
            # deliberately the evidence-row shape (`- <date> · `) rather than any
            # date in the file, so a date QUOTED IN PROSE does not reset the clock.
            #
            # With no such row there is nothing to measure, and this SAYS SO rather
            # than assuming recency -- a gate must not report an observation it
            # did not make (ADR-005).
            bo = re.search(r"^\*\*Blocked-on:\*\*\s*(.+?)\s*$", text, re.M)
            if bo:
                # Only the EVIDENCE SECTIONS count. Scanning the whole file let a
                # row-shaped line quoted in prose -- and task files quote the grammar
                # constantly -- make an old wait look young and delay the 30-day
                # question. Found by a Codex review; my own first test used a plain
                # inline date, which never matched, so it proved nothing about this.
                logged = "\n".join(secs.get("Verification Log", [])
                                   + secs.get("Mutation Log", []))
                seen = sorted(re.findall(r"^- (\d{4}-\d{2}-\d{2}) · ", logged, re.M))
                waiting.append((scan_dir, rel, bo.group(1).strip(),
                                seen[-1] if seen else None))
            # ADR-024 T3 / BACKLOG §83. Counted apart from deferred debt: an
            # unmade decision is not punted work, and planning for it as such
            # misleads. Nobody is notified when a choice continues not to be made,
            # which is the only reason this needs a line of its own.
            ad = re.search(r"^\*\*Awaiting-decision:\*\*\s*(.+?)\s*$", text, re.M)
            if ad:
                undecided.append((scan_dir, rel, ad.group(1).strip()))

    # BACKLOG §85b. One debt written in BOTH a task file and its parent ADR is a
    # row per location, and the headline counted rows. Every row is true and the
    # NUMBER misleads: the reporting corpus read "9 deferred" and had 4-5 real
    # debts, so a reader triaging it plans for twice the work that exists.
    #
    # Keyed on (pointer, text) rather than on the file, because that is what makes
    # two rows the SAME debt — the same punt cited from two places. Two genuinely
    # different debts that happen to share a destination keep their own counts,
    # which is why the text is in the key.
    distinct_debts = {(ptr, txt) for _sd, _rel, ptr, txt in deferred}
    deferred_label = (f"{len(deferred)} deferred"
                      if len(distinct_debts) == len(deferred)
                      else f"{len(deferred)} deferred rows ({len(distinct_debts)} distinct)")
    # ADR-024 T2: the external column appears only when there is one, so a corpus
    # that never declares an outside target reads exactly as it did before.
    external_label = f"{len(externals)} external · " if externals else ""
    undecided_label = f"{len(undecided)} awaiting a decision · " if undecided else ""
    print(f"[DEBT] {deferred_label} · {len(followups)} open follow-ups · "
          f"{external_label}{undecided_label}"
          f"{len(broken)} broken pointers · {len(unreceipted)} unreceipted · "
          f"{len(unswept_items)} into an archive · "
          f"{len(waiting)} waiting")
    # The failure mode of a real wait is NOT that it rots. It is that the event
    # happens and nobody looks again -- so an old one is ASKED ABOUT, never
    # scolded. Reported by klientams-front-v2-01, whose own instance is a correct
    # deploy-time call sitting unreachable on an unmerged branch: the day it
    # merges, nothing tells them.
    STALE_AFTER_DAYS = 30
    today = datetime.date.today()
    cur = None
    for scan_dir, rel, event, seen in waiting:
        if rel != cur:
            print(f"  {scan_dir / rel}:")
            cur = rel
        age = None
        if seen:
            try:
                age = (today - datetime.date.fromisoformat(seen)).days
            except ValueError:
                age = None
        if age is not None and age >= STALE_AFTER_DAYS:
            print(f"    waiting {age}d → {event} -- still waiting; has the event "
                  f"perhaps already happened? Check it, then finish the task or say "
                  f"what changed.")
        elif age is None:
            print(f"    waiting → {event} -- how long is unknown: this task's "
                  f"Verification Log carries no dated entry, so nothing here has "
                  f"looked at it.")
        else:
            print(f"    waiting {age}d → {event}")
    cur = None
    for scan_dir, rel, ptr, txt in deferred:
        if rel != cur:
            print(f"  {scan_dir / rel}:")
            cur = rel
        print(f"    deferred → {ptr}: {txt}")
    cur = None
    for scan_dir, rel, txt in followups:
        if rel != cur:
            print(f"  {scan_dir / rel}:")
            cur = rel
        print(f"    open follow-up: {txt}")
    for scan_dir, rel, ptr, txt, dest in unreceipted:
        print(f"  UNRECEIPTED {scan_dir / rel} → {dest}: {txt}")
    if unreceipted:
        print("  (the destination file exists and never names the source ADR — the punt "
              "was pointed somewhere, not filed there)")
    for scan_dir, rel, ptr, txt, where in unswept_items:
        print(f"  UNSWEPT {scan_dir / rel} → {where}: {txt}")
    if unswept_items:
        print("  (the destination is inside an archive, which every sweep deliberately skips — the "
              "item can never resurface, and writing it there would not help. Point it at a backlog "
              "the sweep covers; the archived ADR stays the decision record.)")
    cur = None
    for scan_dir, rel, choice in undecided:
        if rel != cur:
            print(f"  {scan_dir / rel}:")
            cur = rel
        print(f"    awaiting a decision → {choice}")
    if undecided:
        print("    (nobody is notified when a choice continues not to be made; this is the "
              "notification)")
    cur = None
    for scan_dir, rel, where, ptr, txt in externals:
        if rel != cur:
            print(f"  {scan_dir / rel}:")
            cur = rel
        print(f"    external → {where}: {ptr} — {txt}")
    if externals:
        print("    (declared as owned by another repository: not resolved here, and not debt this "
              "corpus can pay. Printed every run so a wrong declaration stays visible.)")
    for scan_dir, rel, ptr, txt, kind in broken:
        # ADR-024 T1. `BROKEN` means "you wrote a bad pointer". For an `adr` kind
        # that is a claim this gate cannot make: it sees one tree, and a record id
        # it does not hold is either a typo or a target owned elsewhere —
        # `ADR-007` and `ADR-0O7` are equally unresolvable from here. Saying
        # BROKEN picks one, which is the substitution CLAUDE.md §3 and ADR-005
        # forbid. `empty` and `malformed` keep the word: those the gate CAN
        # determine, because the defect is in the text in front of it.
        if kind == "adr":
            print(f"  UNRESOLVED [{kind}] {scan_dir / rel}: ({ptr!r}) {txt}")
            print("    (a typo, or a record owned by another repository. This gate reads one "
                  "tree and cannot tell those apart — fix the id, or declare the target with "
                  "`(external: <where>: <pointer>)`)")
        else:
            print(f"  BROKEN [{kind}] {scan_dir / rel}: ({ptr!r}) {txt}")
    sys.exit(1 if broken else 0)


if __name__ == "__main__":
    main()
