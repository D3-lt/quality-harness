#!/usr/bin/env python3
"""adr-judge — Evidence and Clarity, the two things a schema cannot see.

adr-lint answers "is this record well formed and is its work proved?". This
answers a different question: does the record rest on anything observable, and
will a future reader know what was decided? Those are the axes adr-kit
(rvdbreemen/adr-kit, MIT) judges with a model. This judges them with rules.

ADVISORY, ALWAYS. Every finding is printed and the exit code is 0 whatever it
finds, because a heuristic about prose is not the kind of thing that should stop
work — and because a model verdict must never enter this corpus's evidence
chain, which is the whole reason its `done` claims are worth more than an
opinion. The only non-zero exit is a broken invocation.

`--rubric` prints the questions instead of answering them. That is the model
half, deliberately: the agent reading this IS a model, so it can judge the
qualitative residue itself against a fixed rubric, with no API key, no network,
and no verdict laundered into evidence.

Usage:
  adr-judge <adr.md>
  adr-judge --rubric
"""
import re
import sys
from pathlib import Path

RUBRIC = """Evidence and Clarity — judge the record against these, and say which fail and why.
Nothing here blocks; a finding is a thing to fix or to justify in the record itself.

EVIDENCE — does the decision rest on observed facts rather than preference?
  E1  Context cites something observable: a measurement, a date, a file path, a
      command and its output, an incident, a source. Not "the current approach
      is slow" but what was slow, by how much, measured how.
  E2  Every alternative names why it was NOT chosen, in its own terms.
  E3  A comparative claim ("faster", "cheaper", "safer") carries a number or a
      named source somewhere in the record.

CLARITY — will a reader in a year know what was decided?
  C1  The Decision commits. It says what will be done, not what might be.
  C2  Nothing is left to be filled in later.
  C3  Consequences state at least one cost. A decision with only upside had no
      trade-off, which means the alternatives were not real.
"""

# Anything a reader could go and check. The first version recognised only
# numbers-with-units, dates, paths and a handful of verbs — so a Context citing a
# ticket, a version, a standard, a commit or a log was called opinion. Those are
# how real records cite evidence, and a rule that fires on them is the alert
# fatigue this harness exists not to cause.
OBSERVABLE = re.compile(
    r"\b\d+(?:[.,]\d+)?\s*(?:%|ms|s\b|sec|min|h\b|hours?|days?|weeks?|months?|"
    r"[kKmMgG]i?[bB]|req|rps|qps|x\b|times)|"          # a measurement
    r"\b\d{4}-\d{2}-\d{2}\b|"                            # a date
    r"\bv?\d+\.\d+(?:\.\d+)?\b|"                         # a version
    r"\b[A-Z][A-Z0-9]+-\d+\b|"                            # a tracker id: JIRA-4821
    r"(?:^|\s)#\d+\b|"                                   # an issue number
    r"\b(?:RFC|CVE|ISO|IETF)[- ]?\d+\b|"                  # a standard
    r"\b[0-9a-f]{7,40}\b|"                                # a commit
    r"`[^`]*[-./_ ][^`]*`|"                                # a path, command or quoted output
    r"https?://|"                                        # a source
    r"\b(?:measured|observed|reproduced|benchmark|profil|incident|postmortem|"
    r"logged|traced|reported)\w*\b|"
    r"\b(?:logs?|stack|traceback|output|metrics?|dashboard|ticket|issue)\b",
    re.I,
)
# An explicit rejection always passes, whatever its shape.
REJECTION = re.compile(
    r"\b(?:because|since|rejected|discarded|ruled out|dismissed|too |"
    r"cannot|can't|does not|doesn't|would (?:require|mean|break|cost)|"
    r"trade-?off|drawback|downside|not chosen|no longer)\b", re.I)
# Otherwise the test is SHAPE, not vocabulary. "- Kafka — operationally heavy for
# one queue" states its reason and contains no rejection word at all; keyword
# matching called it a bare name. What separates a name from a name-plus-reason
# is the clause after the separator, so that is what gets counted.
ALTERNATIVE_CLAUSE = re.compile(r"[—–:;]|(?:^|\s)-\s|,\s", re.U)
COMPARATIVE = re.compile(
    r"\b(?:faster|slower|cheaper|costlier|safer|simpler|better|worse|"
    r"more reliable|less reliable|more efficient|higher throughput|lower latency)\b", re.I)
HEDGE = re.compile(r"\b(?:might|maybe|perhaps|possibly|probably|we could|"
                   r"could potentially|may want to|should probably)\b", re.I)
COMMITMENT = re.compile(r"\b(?:we will|we are|will use|will adopt|will replace|"
                        r"adopt|use |replace |migrate|standardi[sz]e|adopts|chooses)\b", re.I)
# (?<![-\w]) not \b: `Superseded by ADR-XXX` in the template is a placeholder for a
# NUMBER, not an authoring marker, and the hyphen is a word boundary — so the
# bundled template judged itself unfinished.
UNRESOLVED = re.compile(r"(?<![-\w])(?:TODO|TBD|FIXME|XXX|\?\?\?)(?![-\w])")
COST = re.compile(
    r"\b(?:cost|costs|price|slower|risk|risks|lose|loses|loss|drawback|downside|"
    r"regress\w*|fail|fails|failing|failure|break|breaks|degrade\w*|harder|"
    r"complex|complexity|burden|maintenance|extra|additional|requires|require|"
    r"coupling|lock-?in|trade-?off|no longer|give[s]? up|one more|another\s+\w+ to (?:run|operate)|"
    # A record that LABELS its downsides has stated them. `**Negative:**` is this
    # project's own template, and "Bad, because" is MADR's — reading either as
    # "no cost stated" fires on the two most common shapes there are.
    r"negative|bad, because|downsides?|cons\b|must be\b|"
    r"more (?:work|complex|expensive)|increase[sd]? (?:the )?(?:complexity|latency|cost))\b",
    re.I)


def section(text, heading):
    """A `## Heading` body, or '' when the record has no such section."""
    pattern = re.compile(rf"^#{{1,6}}\s+{re.escape(heading)}\s*$", re.M | re.I)
    match = pattern.search(text)
    if not match:
        return ""
    rest = text[match.end():]
    nxt = re.search(r"^#{1,6}\s+\S", rest, re.M)
    return rest[:nxt.start()] if nxt else rest


def prose(body):
    """The body without fenced code, so a snippet is not mistaken for a sentence."""
    return re.sub(r"```[\s\S]*?```", " ", body)


BULLET = re.compile(r"^\s*(?:[-*]|\d+\.)\s+\S")
CONTINUATION = re.compile(r"^\s+\S")


def bullets(body):
    """Each bullet WITH the indented lines that continue it.

    This used to keep only the lines that start a bullet, so a bullet whose
    reasoning wrapped was judged on its first line and every continuation was
    discarded before the E2 rejection check ran. An alternative stating its
    rejection perfectly well on line three reported as "gives no reason it was
    not chosen".

    It fired on two well-formed records on 2026-08-27 and was correct about
    neither; both were "fixed" by moving words onto line one, which is an author
    reshaping prose to suit a parser. A gate with false alarms is one people
    learn to skip, and then it protects nothing.

    A blank line or an unindented line ends the bullet — those are the two ways
    Markdown itself ends one, so nothing swallows the paragraph that follows.
    """
    found = []
    current = None
    for line in body.split("\n"):
        if BULLET.match(line):
            if current is not None:
                found.append(current)
            current = line.strip(" -*\t")
        elif current is None:
            continue
        elif not line.strip() or not CONTINUATION.match(line):
            found.append(current)
            current = None
        else:
            current += " " + line.strip()
    if current is not None:
        found.append(current)
    return found


def vacuous_rules(text):
    """(rule, why) for every rule that had NOTHING TO JUDGE in this record.

    A rule whose section is absent cannot fire, and "no findings" then reports a
    reasoning check that never ran as one that passed. Reported 2026-08-29 from an
    adopting corpus: a record with no `## Alternatives Considered` section at all
    got `adr-lint` exit 1 (`Alternatives Considered has no entries`) and `adr-judge`
    exit 0 (`evidence and clarity rules all pass`). Both verdicts were defensible
    and the second was unreadable — "all pass" says the reasoning was examined and
    holds, when the rule that examines it had nothing to run on. A maintainer who
    runs judge and not lint concludes the record is sound.

    This is ADR-005 inside the judge: vacuous truth reported as a verdict. The
    remedy is the cheap one the reporter proposed — NAME THE VACUUM — rather than
    refusing to pass, because it generalises to every prose rule added later.
    """
    empty = []
    for rule, heading, what in (
            ("E1", "Context", "no Context section to check for observable evidence"),
            ("E2", "Alternatives Considered", "no Alternatives Considered section to check for rejections"),
            ("C1", "Decision", "no Decision section to check for a commitment"),
            ("C3", "Consequences", "no Consequences section to check for a stated cost")):
        if not prose(section(text, heading)).strip():
            empty.append((rule, what))
    return empty


def judge(text):
    """(id, axis, finding) for every rule that fires. Deterministic, order fixed."""
    findings = []
    context = prose(section(text, "Context"))
    decision = prose(section(text, "Decision"))
    alternatives = prose(section(text, "Alternatives Considered"))
    consequences = prose(section(text, "Consequences"))

    if context.strip() and not OBSERVABLE.search(context):
        findings.append(("E1", "evidence",
                         "Context cites nothing a reader could check — no measurement, date, "
                         "path, command, or source. Name what was observed, not what is believed."))
    entries = bullets(alternatives)
    if not entries and alternatives.strip():
        # Not every corpus writes alternatives as bullets. Treating "no bullets"
        # as "nothing to check" is a vacuous pass, which reads as coverage while
        # covering nothing — the failure arch-write warns about.
        entries = [alternatives.strip()]
    for entry in entries:
        head = re.split(r"[—–:;.,]", entry)[0].strip()[:60]
        if REJECTION.search(entry):
            continue
        split = ALTERNATIVE_CLAUSE.split(entry, 1)
        reason = split[1] if len(split) > 1 else ""
        if len(reason.split()) < 3:
            findings.append(("E2", "evidence",
                             f"Alternative '{head}' gives no reason it was not chosen; "
                             f"an alternative without a rejection is a list item, not a choice."))
    for body in (decision, context):
        claim = COMPARATIVE.search(body)
        if claim and not OBSERVABLE.search(body):
            findings.append(("E3", "evidence",
                             f"'{claim.group(0)}' is claimed with no measurement or named source "
                             f"in the same section. A date elsewhere in the record is not evidence "
                             f"that one option beats another."))
            break

    if decision.strip() and HEDGE.search(decision) and not COMMITMENT.search(decision):
        findings.append(("C1", "clarity",
                         "The Decision hedges without committing — a reader cannot tell what "
                         "will actually be done."))
    marker = UNRESOLVED.search(prose(text))
    if marker:
        findings.append(("C2", "clarity",
                         f"'{marker.group(0)}' is still in the record; it is not finished."))
    if consequences.strip() and not COST.search(consequences):
        findings.append(("C3", "clarity",
                         "Consequences state no cost. A decision with only upside had no "
                         "trade-off, which means the alternatives were not real."))
    return findings


def main():
    args = sys.argv[1:]
    if "--rubric" in args:
        print(RUBRIC)
        return 0
    unknown = [a for a in args if a.startswith("--")]
    if unknown:
        print(f"unknown option: {unknown[0]}\n\n{__doc__}", file=sys.stderr)
        return 2
    if not args:
        print(__doc__, file=sys.stderr)
        return 2
    path = Path(args[0])
    if not path.exists():
        print(f"record not found: {path}", file=sys.stderr)
        return 2

    body = path.read_text(encoding="utf-8", errors="replace")
    findings = judge(body)
    empty = vacuous_rules(body)
    if findings:
        headline = ""
    elif empty:
        # NOT "all pass". A rule that could not run is not a rule that passed.
        headline = (f" — evidence and clarity rules pass; {len(empty)} rule(s) had nothing to judge")
    else:
        headline = " — evidence and clarity rules all pass"
    print(f"[JUDGE] {path}{headline}")
    for rule, axis, finding in findings:
        print(f"  {axis} {rule}: {finding}")
    for rule, what in empty:
        print(f"  UNJUDGED {rule}: {what}")
    if findings:
        print("  Nothing is blocked — these are the two axes a schema cannot check. "
              "Fix what is real, or say in the record why it stands. "
              "`adr-judge --rubric` prints the questions for a closer read.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
