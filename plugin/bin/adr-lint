#!/usr/bin/env python3
"""adr-lint — executable gate for ADRs + task files (quality-harness templates).

Usage: adr-lint ADR.md [TASKS_DIR]

TASKS_DIR defaults to a `tasks/` directory next to the ADR (or `<adr-stem>/tasks/`).
Without a tasks dir, only ADR-level checks run (inline-task ADRs).

Checks:
  ADR    : Status line · Alternatives Considered ≥1 · Wiring section non-empty ·
           Spec: header present; if it names a file, the file must exist ·
           Out of Scope entries carry a disposition: (permanent[: why]) or (deferred: <pointer>)
  Tasks  : bash fence under ## Acceptance (or explicit human-observed sentence) ·
           required sections · Affected Files ≥1 row · Ordered Steps step 1 mentions a test ·
           Depends-on/Covers/Produces/Consumes headers present · Depends-on targets exist
  README : listed task IDs ↔ task files match (task files are the source of truth) ·
           wave table required only for >5 tasks
  DAG    : edges from Depends-on + Consumes (T-id refs and backticked contract tokens
           matching a sibling's Produces) · no cycles · wave/order table is a valid
           topological leveling: every producer lands in a strictly earlier wave/order
  Cross  : no file is `add`ed by two tasks (one task owns creation; others edit) ·
           every T-id in the ADR's Inter-task Contracts table matches a task file ·
           each contract row names a producing T-id (orphaned-contract guard)
  V-Log  : entries match the adr-verify grammar
           ('- YYYY-MM-DD · <sha[*]|no-git> · exit N · `cmd` · acceptance-sha256:<digest>'
           or '· human-observed · …'; legacy no-digest rows remain parseable) ·
           README `done` status requires an exit-0 entry whose digest matches the complete
           current Acceptance fence. Legacy evidence counts only for a single-line fence
           whose displayed command matches (human-observed tasks: a human-observed entry)
  Covers : union of task Covers ⊇ spec's @spec/@implemented fact + scenario IDs

Exit: 0 pass · 1 failures found
"""
import hashlib
import json
import re
import subprocess
import sys
from contextlib import contextmanager
from pathlib import Path, PurePosixPath

# --- win32 utf-8 io (D1 fix) -------------------------------------------------
# Windows defaults stdout/stderr and open() to the ANSI codepage. These tools
# print and WRITE `·` and `—`; under cp1252 a `·` lands as a bare 0xB7 byte,
# which is not valid UTF-8, so an append-only evidence file becomes undecodable.
# Child process output decodes with that same default, so the git probe below
# names its encoding rather than inheriting the codepage.
import sys as _sys
for _s in (_sys.stdout, _sys.stderr):
    try:
        _s.reconfigure(encoding="utf-8", errors="replace")
    except Exception:
        pass
# ---------------------------------------------------------------------------

TASK_SECTIONS = ["Goal", "Affected Files", "Ordered Steps", "Acceptance", "Tests",
                 "Invariants", "Risks", "Stop Condition", "Out of Scope", "Verification Log"]
TASK_HEADERS = ["Depends-on", "Covers", "Produces", "Consumes"]
# The sha field of a tool-written entry, in ONE place. It was five literal copies
# here and a sixth in adr-verify, every one accepting 7 to 40 hex characters — and
# adr-verify WRITES whatever `git rev-parse --short HEAD` returns, unvalidated.
# git honours `core.abbrev`, which it allows down to 4, and a SHA-256 repository
# emits up to 64. Reproduced 2026-08-29 with `core.abbrev=4`: adr-verify wrote
# `6aaf*` and exited 0, and every reader rejected its own entry — so the sweep
# dropped the claim from its denominator, flattering the false-success rate, AND
# adr-lint blocked the `done` row that evidence was written for. Widening an
# ACCEPTING grammar invalidates nothing: every entry that parsed before parses.
SHA_FIELD = r"(?:[0-9a-f]{4,64}\*?|no-git)"
# Tool-written mutation evidence. Same shape and same purpose as VLOG_RE: an entry
# off this grammar was typed by a person, and a typed mutant is the thing the log
# replaced. `killed` is the only verdict that is evidence — see adr-verify --mutant.
MLOG_RE = re.compile(
    r"^- \d{4}-\d{2}-\d{2} · " + SHA_FIELD + r" · "
    r"mutant (?:(?:killed · exit [1-9]\d*)|(?:survived · exit 0)|"
    r"(?:inconclusive · exit \d+)) · `[^`]+` · .+?"
    r"(?: · acceptance-sha256:[0-9a-f]{64})?$")
MLOG_DIGEST_RE = re.compile(
    r"^- (?P<date>\d{4}-\d{2}-\d{2}) · " + SHA_FIELD + r" · "
    r"mutant (?P<verdict>killed|survived|inconclusive) · exit (?P<exit>\d+) · "
    r"`[^`]+` · .+? · acceptance-sha256:(?P<digest>[0-9a-f]{64})$")

# Tasks whose acceptance was first recorded on or after this date must carry mutation
# evidence. A cutover rather than a flag day: every task file predating it was written
# when nothing could record a mutant, and turning four corpora red would produce a gate
# people switch off rather than a gate that catches anything.
MUTATION_REQUIRED_FROM = "2026-08-22"

VLOG_RE = re.compile(
    r"^- \d{4}-\d{2}-\d{2} · (?:" + SHA_FIELD + r" · exit \d+ · `[^`]+`|"
    r"human-observed · .+)(?: · acceptance-sha256:[0-9a-f]{64})?$")
VLOG_DIGEST_RE = re.compile(
    r"^- \d{4}-\d{2}-\d{2} · " + SHA_FIELD + r" · exit (?P<exit>\d+) · "
    r"`(?P<command>[^`]+)` · acceptance-sha256:(?P<digest>[0-9a-f]{64})$")
VLOG_LEGACY_RE = re.compile(
    r"^- \d{4}-\d{2}-\d{2} · " + SHA_FIELD + r" · exit (?P<exit>\d+) · "
    r"`(?P<command>[^`]+)`$")


def disposition_span(text):
    """The balanced `(permanent…)` / `(deferred:…)` group in `text`, as (inner, start, end).

    Scanned by paren DEPTH rather than matched with `[^)]*`, which cannot cross
    the `)` of a nested pair. Measured 2026-08-28 on one bullet reading
    `(permanent: the `archive()` helper keeps originals)`: adr-lint advised that
    it carried no disposition at all, and adr-debt reported it as a BROKEN
    [malformed] pointer — a finding about a bullet that visibly complies. The
    architecture.md scan was worse again, capturing a TRUNCATED pointer and
    resolving that, so it named a path nobody wrote.

    None when no such group is balanced. Callers apply their own keyword and
    position tests; this answers only "where does the disposition actually end".

    ONE BODY, THREE COPIES — adr-lint, adr-debt and adr-retire-check are
    standalone scripts with no import path between them (ADR-011: a shared file
    under bin/ acquires a generated forwarder). `tests/gate-regressions.py`
    holds the one truth table all three are checked against, the way ADR-009
    binds `enforcement_pointers` to `declaredEnforcement`.
    """
    for opening in re.finditer(r"\((?=permanent\b|deferred\b)", text):
        depth = 0
        for i in range(opening.start(), len(text)):
            if text[i] == "(":
                depth += 1
            elif text[i] == ")":
                depth -= 1
                if depth == 0:
                    return text[opening.start() + 1:i], opening.start(), i + 1
    return None


def sections_of(text):
    out, cur, fence = {}, None, False
    for line in text.splitlines():
        if line.lstrip().startswith("```"):
            fence = not fence
        m = None if fence else re.match(r"^## (.+?)\s*$", line)
        if m:
            cur = m.group(1)
            out[cur] = []
        elif cur is not None:
            out[cur].append(line)
    return out


QUALIFIED_DEP = re.compile(r"^ADR[-\s]?0*(?P<number>\d{1,4})[-/](?P<task>T\d+)$", re.I)


def split_dependencies(value):
    r"""A `Depends-on` value as (qualified, local) ids.

    A QUALIFIED id names a task in another record — `ADR-003-T4` or
    `ADR-003/T4`. It is matched and consumed WHOLE, and that is the whole point
    of this function rather than a regex at each call site.

    Measured 2026-08-28: `TID_RE` is `(?<!\w)T\d+(?!\w)`, so scanning
    "ADR-003-T4" for local task ids yields `['T4']` — the hyphen is not a word
    character. If the writing record happens to have its own T4, the foreign
    dependency does not vanish, it binds to the LOCAL task with that number. A
    wrong edge is worse than a missing one, because the DAG then looks answered.
    """
    if not value or value.strip().lower() in ("none", '"none"'):
        return [], []
    qualified, local = [], []
    for part in (p.strip() for p in value.split(",")):
        if not part:
            continue
        (qualified if QUALIFIED_DEP.match(part) else local).append(part)
    return qualified, local


def resolve_qualified_dep(pointer, corpus_dir):
    """Whether `ADR-003-T4` names a record in this corpus that has that task.

    Resolved against the CORPUS rather than the sibling set — that is the whole
    change. The same argument that requires every cited ADR to resolve: a
    dependency naming a record that does not exist, or a task that record does
    not have, is a pointer to nothing.
    """
    found = QUALIFIED_DEP.match(pointer)
    if not found or corpus_dir is None:
        return False
    number, task = int(found.group("number")), found.group("task")
    for candidate in sorted(corpus_dir.glob("ADR-*.md")):
        digits = re.match(r"ADR-0*(\d{1,4})", candidate.name, re.I)
        if not digits or int(digits.group(1)) != number:
            continue
        tasks = candidate.with_suffix("") / "tasks"
        if not tasks.is_dir():
            return False
        return any(id_matches(task, f.stem) for f in tasks.glob("*.md")
                   if f.name.lower() != "readme.md")
    return False


def id_matches(tid, stem):
    """Anchored task-ID match: 'T1' matches 'T1-db-index' but never 'T10-foo'."""
    return re.search(rf"(?<!\w){re.escape(tid)}(?!\w)", stem, re.I) is not None


def git_root(d):
    try:
        r = subprocess.run(["git", "-C", str(d), "rev-parse", "--show-toplevel"],
                           capture_output=True, text=True, timeout=10,
                           encoding="utf-8", errors="replace")
        if r.returncode == 0:
            return Path(r.stdout.strip())
    except Exception:
        pass
    return None


def header_val(text, name):
    m = re.search(rf"^\*\*{re.escape(name)}:\*\*\s*(.+)$", text, re.M)
    return m.group(1).strip() if m else None


def normalize_acceptance(raw):
    """Canonical Acceptance text shared with adr-verify's evidence writer.

    Normalize line endings and remove only blank lines adjacent to the Markdown
    fence. Shell-significant indentation and internal blank lines stay intact.
    """
    lines = raw.replace("\r\n", "\n").replace("\r", "\n").split("\n")
    start, end = 0, len(lines)
    while start < end and not lines[start].strip():
        start += 1
    while end > start and not lines[end - 1].strip():
        end -= 1
    return "\n".join(lines[start:end])


def acceptance_digest(command):
    """SHA-256 of the complete normalized Acceptance fence."""
    return hashlib.sha256(command.encode("utf-8")).hexdigest()


def spec_ids(spec_path):
    """Fact + scenario IDs tagged @spec/@implemented in the spec."""
    text = Path(spec_path).read_text(errors="replace", encoding="utf-8")
    ids = set()
    for m in re.finditer(r"^\|\s*(F-\d+)\s*\|.*\|\s*(@spec|@implemented)\s*(?:\|.*)?$",
                         text, re.M):
        ids.add(m.group(1))
    for m in re.finditer(r"^### (UC\d+-S\d+) \[(?:happy|failure)\] .+ \[@(spec|implemented)\]",
                         text, re.M):
        ids.add(m.group(1))
    return ids


SCOPE_BULLET = re.compile(r"^\s*(?:[-*]|\d+\.)\s+\S")
SCOPE_CONTINUATION = re.compile(r"^\s+\S")


def scope_bullets(lines):
    """Each Out of Scope bullet WITH the indented lines that continue it.

    A DISPOSITION MAY WRAP, and reading these line by line said it did not.
    `- **Every improvement surfaced in the same session** (deferred: each\n
    needs its own issue).` shows `(deferred: each` with no closing paren on the
    line that starts the bullet, so adr-lint advised "needs a disposition" and
    adr-debt reported BROKEN [malformed] with an EMPTY pointer — about a bullet
    that is well-formed Markdown.

    THE RULE WAS ALREADY DECIDED HERE, one gate over. `adr-judge::bullets` does
    exactly this and its docstring says why, dated 2026-08-27: two well-formed
    records were flagged and "both were 'fixed' by moving words onto line one,
    which is an author reshaping prose to suit a parser. A gate with false alarms
    is one people learn to skip, and then it protects nothing." That reasoning was
    never carried to the Out of Scope readers. Reported 2026-08-29 from an
    adopting corpus, and it flagged this project's own ADR-012 the same hour.

    A blank line or an unindented line ends the bullet — the two ways Markdown
    itself ends one, so nothing swallows the paragraph that follows.
    """
    found, current, indent, subtree = [], None, 0, None
    for line in lines:
        lead = len(line) - len(line.lstrip())
        # Every bullet below the one that opened a child list belongs to that
        # list, not just the first: suppressing only the first child left the
        # second reported as an entry needing its own disposition.
        if subtree is not None and SCOPE_BULLET.match(line) and lead > subtree:
            continue
        # A DEEPER BULLET IS A CHILD, not a sibling. An Out of Scope entry may
        # enumerate what it defers as an indented list, and each child was being
        # read as an entry of its own and told it needed its own disposition —
        # four pointers to the one issue the parent already defers as a unit.
        # Reported 2026-08-29 from an adopting corpus, and checked against the
        # unedited file so it was not confused with the wrap fix shipped beside
        # it. Indentation is what Markdown uses to say "child", so it is what
        # this reads.
        if SCOPE_BULLET.match(line):
            if current is not None and lead > indent:
                # A child list ENDS the parent entry rather than extending it.
                # The parent's disposition closes the parent's own text; joining
                # the children on would put prose after it and report the entry
                # as trailing-prose, which is the same false alarm one branch
                # over. The children are not entries either — they are the
                # enumeration the parent defers as one unit.
                found.append(current)
                current = None
                subtree = indent
                continue
            subtree = None
            if current is not None:
                found.append(current)
            current = line.strip()
            indent = lead
        elif current is None:
            continue
        elif not line.strip() or not SCOPE_CONTINUATION.match(line):
            found.append(current)
            current = None
        else:
            current += " " + line.strip()
    if current is not None:
        found.append(current)
    return found


def closes_the_line(text, end):
    """Whether a parenthetical ending at `end` is the last thing on the line.

    TRAILING SENTENCE PUNCTUATION IS TOLERATED. `(deferred: notes.md).` is a
    disposition somebody ended a sentence after, and rejecting it was not merely
    strict — adr-debt then fell through to its `malformed` branch and printed
    `BROKEN [malformed] … ('')`, the vocabulary for "deferred with nothing after
    the colon", about a pointer that is right there in the line. A gate reporting
    an observation it did not make (ADR-005, CLAUDE.md §3).

    Reported 2026-08-29 against v2.31.1 by a session on an adopting corpus where
    ALL FIFTEEN of its broken-pointer findings were this shape, every one of them
    well-formed, blocking at exit 1 — the "a corpus adopting this on a tree it did
    not write lights up on day one" case ADR-011 was explicitly designed against.

    A SECOND PARENTHETICAL IS STILL NOT PUNCTUATION: `(permanent: why) (see also)`
    leaves `(see also)` behind and does not close the line. That distinction is
    what this function keeps, and it is the reason it is not simply dropped.
    """
    return text[end:].strip(" \t.,;:") == ""


DISPOSITION_TEXT = re.compile(r"^(?:permanent(?::.*)?|deferred:\s*\S.*)$")


def _carries_a_disposition(bullet):
    """Whether an Out of Scope bullet ENDS with a well-formed disposition.

    Position and grammar are separate questions and are asked separately: a
    bullet may hold a parenthetical that is balanced but does not close the line
    (`(permanent: why) (see also)`), which is not a disposition and never was.
    """
    span = disposition_span(bullet)
    return bool(span) and closes_the_line(bullet, span[2]) and bool(DISPOSITION_TEXT.match(span[0]))


def check_adr(adr_path, errors):
    text = Path(adr_path).read_text(errors="replace", encoding="utf-8")
    if not re.search(r"^\*\*Status:\*\*", text, re.M):
        errors.advise(f"{adr_path.name}: no **Status:** line")
    secs = sections_of(text)
    alts = [ln for ln in secs.get("Alternatives Considered", []) if ln.strip().startswith("-")]
    if not alts:
        errors.append(f"{adr_path.name}: Alternatives Considered has no entries")
    wiring = [ln for ln in secs.get("Wiring & Contract Changes", []) if ln.strip()]
    if not wiring:
        errors.append(f"{adr_path.name}: Wiring & Contract Changes empty "
                      f"(write 'None — implementation-internal only' if true)")
    for s in scope_bullets(secs.get("Out of Scope", [])):
        if not _carries_a_disposition(s):
            # "needs a disposition" reads as "you gave no reason", and the reason is
            # very often right there in prose — the entry is missing the machine
            # -readable FORM, not the thinking. Reported 2026-08-29 by a reader on
            # an adopting corpus whose bullets carry their reasons in sentences.
            # What a reader has to realise is *reason present, grammar absent*, and
            # the old sentence let them read *reason absent*.
            errors.advise(f"{adr_path.name}: Out of Scope entry ends with no machine-readable "
                          f"disposition — a reason in prose is not one, and `adr-debt` cannot "
                          f"sweep it. End the entry with '(permanent[: why])' or "
                          f"'(deferred: <pointer>)': {s[:70]}")
    spec = header_val(text, "Spec")
    if spec is None:
        errors.advise(f"{adr_path.name}: no **Spec:** header (use 'None — no spec stage')")
    served = header_val(text, "Served-path change")
    if not served:
        errors.advise(f"{adr_path.name}: no **Served-path change:** header — say in one sentence "
                      f"what a user or agent experiences differently once this ships, or write "
                      f"'None — this ADR changes only measurement or tooling'. An ADR that improves "
                      f"the measurement reads identically to one that improves the thing.")
    elif re.match(r"^<.*>$", served.strip()):
        errors.append(f"{adr_path.name}: **Served-path change:** is still the template placeholder")
        return None
    # The missing-Spec error above was recorded and then fell straight into `spec.strip()`, so every
    # ADR without the header crashed the linter with an AttributeError instead of being reported.
    # A crash is worse than a false alarm: it exits non-zero, so it READS like a finding while
    # having checked nothing at all — measured 2026-08-21 across 46 ADRs.
    if spec is None:
        return None
    spec = spec.strip("`<> ")
    if spec.lower().startswith("none"):
        return None
    spec_file = Path(spec)
    if not spec_file.is_absolute():
        candidates = [adr_path.parent / spec_file]
        root = git_root(adr_path.parent)
        if root:
            candidates.append(root / spec_file)
        spec_file = next((c for c in candidates if c.exists()), None)
        if spec_file is None:
            errors.append(f"{adr_path.name}: Spec: names '{spec}' but the file does not exist "
                          f"(tried ADR-relative and repo-root-relative)")
            return None
        return spec_file
    if not spec_file.exists():
        errors.append(f"{adr_path.name}: Spec: names '{spec}' but the file does not exist")
        return None
    return spec_file


def check_reachability_consistency(task_files, errors):
    """Either every task file in an ADR declares ## Reachability, or none does.

    A hard global requirement would fail 980 existing task files across seven
    corpora on the day it landed — the textbook shape of a gate people learn to
    skip. Consistency within one ADR gets the same enforcement where it matters:
    a task set written from the current template is held to it, an older one is
    left alone, and the half-migrated state that hides drift is what fails.

    The section exists because "is it wired?" has four rungs and tests usually
    cover only the second. Rung 3 — can the intended caller DISCOVER it — is
    invisible to behavioural tests by construction: an argument a handler honours
    but a schema never advertises works for anyone who sends it, and is
    unreachable for the reader who consults the schema first.
    """
    have = [p for p in task_files if "## Reachability" in p.read_text(errors="replace", encoding="utf-8")]
    if have and len(have) != len(task_files):
        missing = sorted(p.name for p in task_files if p not in have)
        errors.append(
            f"{len(have)} of {len(task_files)} task files declare ## Reachability; "
            f"these do not: {', '.join(missing)}. Either the whole task set uses the "
            f"current template or none of it does — a half-migrated set is where a "
            f"missing rung hides")


def where_it_stopped(pattern, line, width=70):
    """The part of a rejected line the reader needs to see: where matching failed.

    A rejection that quotes the first 70 characters shows the PREFIX — which, for
    a row that is correct up to a trailing addition, is exactly the part that was
    fine. Measured 2026-08-29 by a session that hand-wrote six rows, had four
    rejected for prose appended after the closing backtick, and was shown a
    correct-looking prefix beside a complaint about grammar (docs/BACKLOG.md §60).
    Longest-prefix matching says where the grammar gave up, so the reader is
    pointed at the character that broke it rather than at the ones that did not.
    """
    for end in range(len(line), 0, -1):
        if pattern.match(line[:end]) or pattern.fullmatch(line[:end]):
            tail = line[end:]
            return (f"matches up to character {end}, then stops at: {tail[:width]}"
                    if tail else line[:width])
    return line[:width]


def check_task(path, all_stems, errors):
    text = path.read_text(errors="replace", encoding="utf-8")
    secs = sections_of(text)
    for s in TASK_SECTIONS:
        if s not in secs:
            errors.advise(f"{path.name}: missing section ## {s}")
    for h in TASK_HEADERS:
        if header_val(text, h) is None:
            errors.advise(f"{path.name}: missing **{h}:** header")
    acc = "\n".join(secs.get("Acceptance", []))
    if "```bash" not in acc and "Acceptance is human-observed:" not in acc:
        errors.append(f"{path.name}: ## Acceptance has no ```bash fence and no explicit "
                      f"'Acceptance is human-observed:' sentence — prose acceptance is rejected")
    aff = [ln for ln in secs.get("Affected Files", [])
           if ln.strip().startswith("|") and "`" in ln]
    if not aff:
        errors.advise(f"{path.name}: Affected Files table has no data rows "
                      f"(a row with a backticked path)")
    # A task with PASSING EVIDENCE whose Affected Files name a path git IGNORES.
    # The fence ran against the worktree; an ignored path is in the worktree and
    # will never be in the commit, so the evidence is tool-written, correct about
    # what it measured, and about a file that ships to nobody (docs/BACKLOG.md
    # §65). Only for an evidenced task, and only for IGNORED — a path that merely
    # does not exist yet is the normal state of a task being written.
    # PASSING EVIDENCE, spelled the way the other checks in this gate spell it. A
    # `· human-observed ·` row is evidence here too: a HUMAN ran the fence against
    # the same worktree, and this check's whole reasoning is about the worktree —
    # arguably more so, since a hand-run fence leaves no tool-written record of
    # what it touched. Reported 2026-08-29 by a session that built a synthetic
    # positive and found three checks in this file disagreeing about the same
    # concept: tests-exist and the mutation-log check counted a human-observed row
    # and this one did not, so relabelling a task to human-observed silently
    # bought exemption from one check and not the others (docs/BACKLOG.md §69).
    if any(ln.strip().startswith("- ")
           and (("· exit 0 ·" in ln and VLOG_RE.match(ln.strip()))
                or "· human-observed ·" in ln)
           for ln in secs.get("Verification Log", [])):
        named = set()
        for ln in aff:
            cells = [c.strip() for c in re.split(r"(?<!\\)\|", ln.strip().strip("|"))]
            pm = re.search(r"`([^`]+)`", cells[0]) if cells else None
            if pm and not pm.group(1).strip().startswith("`"):
                named.add(pm.group(1).strip())
        asked = ignored_paths(git_root(path.parent), named)
        if asked is None and named:
            errors.advise(
                f"{path.name}: could not ask git whether this task's Affected Files are "
                f"ignored, so that check did NOT run — a path kept out of the commit by "
                f".gitignore would not have been reported here.")
        for name, pattern in sorted((asked or {}).items()):
            errors.advise(
                f"{path.name}: Affected Files names `{name}`, and git IGNORES it "
                f"(pattern `{pattern}`). This task's acceptance passed against the "
                f"worktree, so the evidence is real and the file is not in the commit — "
                f"a clean clone does not have it. A pattern with no slash matches at "
                f"every depth and matches directories; anchor it (`/{pattern.lstrip('/')}`) "
                f"if it was meant for one place.")

    adds = set()
    for ln in aff:
        cells = [c.strip() for c in re.split(r"(?<!\\)\|", ln.strip().strip("|"))]
        if len(cells) >= 2 and re.search(r"\badd\b", cells[1], re.I):
            pm = re.search(r"`([^`]+)`", cells[0])
            if pm:
                adds.add(pm.group(1))
    steps = [ln for ln in secs.get("Ordered Steps", []) if re.match(r"^\s*1\.", ln)]
    if not steps:
        errors.advise(f"{path.name}: Ordered Steps has no '1.' numbered step — step 1 must "
                      f"establish the failing test (TDD red)")
    # What step 1 must do is ESTABLISH RED — show the thing can fail before it is
    # made to pass. Asking whether it contains the word "test" is a check on the
    # sentence rather than on what the step does (ADR-003), and it was wrong in
    # both directions: "Confirm the gate is red first: `spec-verify ...`" was
    # advised at, while "update the tests later" was not. Found 2026-08-29 by a
    # Claude Desktop session running this gate over this corpus (ADR-012 T4).
    # BACKLOG §52.
    elif not re.search(r"\b(tests?|red|fail(s|ed|ing|ure)?)\b", steps[0], re.I):
        errors.advise(f"{path.name}: Ordered Steps step 1 must establish the failing test "
                      f"(TDD red) — currently: {steps[0].strip()[:80]}")
    dep = header_val(text, "Depends-on") or ""
    # Qualified ids are taken out FIRST and whole. Left in the local scan they
    # would bind to a same-numbered sibling — see split_dependencies.
    qualified, local = split_dependencies(dep)
    for d in local:
        if not any(id_matches(d, s) for s in all_stems):
            errors.append(f"{path.name}: Depends-on '{d}' matches no sibling task file")
    for d in qualified:
        if not resolve_qualified_dep(d, path.parent.parent.parent):
            errors.append(f"{path.name}: Depends-on '{d}' names no record in this corpus, or a "
                          f"record with no such task — a cross-record dependency must resolve, "
                          f"for the same reason a cited ADR must")
    vlog = [ln.strip() for ln in secs.get("Verification Log", [])
            if ln.strip().startswith("- ")]
    for b in vlog:
        if not VLOG_RE.match(b):
            errors.append(f"{path.name}: Verification Log entry doesn't match the adr-verify "
                          f"grammar '- YYYY-MM-DD · <sha[*]|no-git> · exit N · `cmd` · "
                          f"acceptance-sha256:<64 hex>' (legacy no-digest rows remain parseable) "
                          f"(or '· human-observed · …'): {where_it_stopped(VLOG_RE, b)}")
    mlog = [ln.strip() for ln in secs.get("Mutation Log", [])
            if ln.strip().startswith("- ")]
    for b in mlog:
        if not MLOG_RE.match(b):
            errors.append(f"{path.name}: Mutation Log entry doesn't match the adr-verify "
                          f"grammar: killed requires nonzero exit, survived requires exit 0, "
                          f"and inconclusive may use either · `file` · why: "
                          f"{where_it_stopped(MLOG_RE, b)}")
    has_mlog_section = "Mutation Log" in secs

    acc_match = re.search(r"```bash\s*\n(.*?)```", acc, re.S)
    acc_all = normalize_acceptance(acc_match.group(1)) if acc_match else ""
    acc_first = acc_all.splitlines()[0].strip() if acc_all else None
    # acc_first is display/legacy compatibility only. acc_all is the WHOLE
    # normalized fence and is the sole input to current evidence digests: a
    # filter or second command often sits below line one.
    # Tests table rows: (test name, file it should live in). The names are what
    # the acceptance command filters on, so a name that exists only here is a
    # test nothing runs.
    tests = []
    for ln in secs.get("Tests", []):
        s2 = ln.strip()
        if not s2.startswith("|") or s2.startswith("|--") or "---" in s2.split("|")[1:2]:
            continue
        cells = [c.strip() for c in re.split(r"(?<!\\)\|", s2.strip("|"))]
        if len(cells) < 2 or cells[0].lower().startswith("test name"):
            continue
        nm = re.search(r"`([^`]+)`", cells[0])
        fl = re.search(r"`([^`]+)`", cells[1])
        if nm and fl:
            tests.append((nm.group(1).strip(), fl.group(1).strip()))

    covers = header_val(text, "Covers") or ""
    info = {"dep": header_val(text, "Depends-on") or "", "tests": tests, "path": path,
            "produces": header_val(text, "Produces") or "",
            "consumes": header_val(text, "Consumes") or "",
            "vlog": vlog, "mlog": mlog, "has_mlog": has_mlog_section,
            "acc_first": acc_first, "acc_all": acc_all,
            "human": "Acceptance is human-observed:" in acc, "adds": adds}
    return set(re.findall(r"(F-\d+|UC\d+-S\d+)", covers)), info


def dag_edges(infos):
    """Ordering edges (before, after, reason) from Depends-on + Produces/Consumes.

    Consumes contributes an edge for every LOCAL T-id it references and for every
    backticked token that also appears backticked in a sibling's Produces.

    QUALIFIED IDS ARE TAKEN OUT WHOLE FIRST, on BOTH headers. `split_dependencies`
    existed for exactly this and was wired only into the Depends-on VALIDATION at
    the call site above; the DAG built beside it still scanned the raw value, so
    `ADR-003-T4` yielded a local `T4` edge in the graph the validator had just
    been careful about. Reproduced 2026-08-29 (docs/BACKLOG.md §41): a task whose
    `Consumes:` named a foreign record printed `blocked … (waiting on T4)`, naming
    a sibling it has nothing to do with. A wrong edge is worse than a missing one,
    because the DAG then looks answered.

    A foreign id contributes NO edge here, deliberately: this function builds the
    local ordering graph, and cross-record readiness is `adr-next`'s foreign
    state, which reports "cannot evaluate" rather than inventing an ordering.
    """
    tid_re = re.compile(r"(?<!\w)T\d+(?!\w)")
    edges, seen = [], set()

    def add(a, b, reason):
        if a in infos and a != b and (a, b) not in seen:
            seen.add((a, b))
            edges.append((a, b, reason))

    for tid, inf in infos.items():
        _, dep_local = split_dependencies(inf["dep"])
        for d in tid_re.findall(" ".join(dep_local).upper()):
            add(d, tid, f"{tid} Depends-on {d}")
        cons = inf["consumes"]
        if cons and not cons.lower().startswith("none"):
            _, cons_local = split_dependencies(cons)
            for d in tid_re.findall(" ".join(cons_local).upper()):
                add(d, tid, f"{tid} Consumes {d}'s output")
            ctoks = {t.lower() for t in re.findall(r"`([^`]+)`", cons)} - {"none"}
            for other, oinf in infos.items():
                hit = ctoks & {t.lower() for t in re.findall(r"`([^`]+)`", oinf["produces"])}
                if hit:
                    add(other, tid, f"{tid} Consumes `{sorted(hit)[0]}` produced by {other}")
    return edges


def find_cycle(edges, nodes):
    adj = {}
    for a, b, _ in edges:
        adj.setdefault(a, []).append(b)
    state, path = {}, []

    def dfs(n):
        state[n] = 1
        path.append(n)
        for m in adj.get(n, ()):
            if state.get(m) == 1:
                return path[path.index(m):] + [m]
            if not state.get(m):
                c = dfs(m)
                if c:
                    return c
        state[n] = 2
        path.pop()
        return None

    for n in sorted(nodes):
        if not state.get(n):
            c = dfs(n)
            if c:
                return c
    return None


def parse_positions(text):
    """Map task-id → wave/order number from the README's Wave or Order table."""
    lines = text.splitlines()
    for i, ln in enumerate(lines):
        m = re.match(r"^\|\s*(Wave|Order)\s*\|", ln, re.I)
        if not m:
            continue
        mode, pos = m.group(1).lower(), {}
        for row in lines[i + 1:]:
            if not row.strip().startswith("|"):
                break
            rm = re.match(r"^\|\s*(\d+)\s*\|([^|]*)\|", row)
            if rm:
                for tid in re.findall(r"(?<!\w)T\d+(?!\w)", rm.group(2).upper()):
                    pos[tid] = int(rm.group(1))
        return mode, pos
    return None, {}


def check_dag(infos, readme_text, errors):
    """Cycle check on the task DAG; wave/order table must be a topological leveling."""
    edges = dag_edges(infos)
    cyc = find_cycle(edges, infos.keys())
    if cyc:
        errors.append(f"tasks: dependency cycle: {' → '.join(cyc)}")
        return
    if not readme_text:
        return
    mode, pos = parse_positions(readme_text)
    for a, b, reason in edges:
        pa, pb = pos.get(a), pos.get(b)
        if pa is None or pb is None:
            continue  # unlisted tasks already flagged by check_readme
        if pa >= pb:
            errors.append(f"README.md: {reason}, but {mode}({b})={pb} ≤ {mode}({a})={pa} "
                          f"— {a} must land in a strictly earlier {mode}")


def check_cross_record_cycles(corpus_dir, errors):
    """A dependency cycle that exists only in the UNION of records.

    Per-record `check_dag` cannot see one by construction: each record's graph is
    acyclic on its own, and the cycle exists only once the qualified edges are
    laid over it. Making cross-record dependencies real without widening the
    check would move the blindness rather than remove it — ADR-007 says so, and
    two records in the reporting corpus already referenced each other in prose.

    Nodes are `NNN-TN`. Only CROSS-record edges are added: a local cycle is
    already `check_dag`'s finding, and reporting it twice from two tools is how a
    reader learns to skim one of them.
    """
    if corpus_dir is None or not corpus_dir.is_dir():
        return
    edges, nodes = [], set()
    for record in sorted(corpus_dir.glob("ADR-*.md")):
        digits = re.match(r"ADR-0*(\d{1,4})", record.name, re.I)
        tasks = record.with_suffix("") / "tasks"
        if not digits or not tasks.is_dir():
            continue
        here = digits.group(1).zfill(3)
        for f in sorted(tasks.glob("*.md")):
            if f.name.lower() == "readme.md":
                continue
            local = re.search(r"(?<!\w)T\d+(?!\w)", f.stem, re.I)
            if not local:
                continue
            node = f"{here}-{local.group(0).upper()}"
            nodes.add(node)
            text = f.read_text(encoding="utf-8", errors="replace")
            qualified, _ = split_dependencies(header_val(text, "Depends-on") or "")
            for pointer in qualified:
                found = QUALIFIED_DEP.match(pointer)
                target = f"{found.group('number').zfill(3)}-{found.group('task').upper()}"
                nodes.add(target)
                edges.append((node, target, f"{node} depends on {target}"))
    cycle = find_cycle(edges, nodes)
    if cycle:
        errors.append("cross-record dependency cycle: "
                      + " → ".join(f"ADR-{n}" for n in cycle))


def check_file_collisions(infos, errors):
    """A file `add`ed by two tasks is a collision — one task owns creation."""
    owners = {}
    for tid, inf in infos.items():
        for p in inf["adds"]:
            owners.setdefault(p, []).append(tid)
    for p, tids in sorted(owners.items()):
        if len(tids) > 1:
            errors.append(f"tasks: `{p}` is added by {', '.join(sorted(tids))} — one task must "
                          f"own creation (change: add); the others edit")


def check_contract_table(adr_path, stems, errors):
    """Every Inter-task Contracts row names a producing T-id that has a task file."""
    secs = sections_of(adr_path.read_text(errors="replace", encoding="utf-8"))
    rows = [ln for ln in secs.get("Inter-task Contracts", []) if ln.strip().startswith("|")]
    for r in rows[1:]:
        if re.match(r"^\|[\s\-|:]+\|?$", r.strip()) or "<" in r:
            continue
        cells = [c.strip() for c in re.split(r"(?<!\\)\|", r.strip().strip("|"))]
        if len(cells) < 3 or cells[0].lower() in ("", "none"):
            continue
        prod_ids = re.findall(r"(?<!\w)T\d+(?!\w)", cells[1])
        if not prod_ids:
            errors.append(f"{adr_path.name}: Inter-task Contracts row '{cells[0][:40]}' names "
                          f"no producing T-id — orphaned contract, no task owns it")
        for role, cell in (("producing", cells[1]), ("consuming", cells[2])):
            for tid in re.findall(r"(?<!\w)T\d+(?!\w)", cell):
                if not any(id_matches(tid, s) for s in stems):
                    errors.append(f"{adr_path.name}: Inter-task Contracts row "
                                  f"'{cells[0][:40]}' names {role} task {tid} but no task "
                                  f"file matches it")


def done_task_ids(readme_text):
    """Task ids a README marks `done`, whatever column the status sits in.

    The first version anchored on `| T4 | <one cell> | done |` — the status in the
    THIRD column and the id as a bare `T4`. Two README shapes are in use: some
    index tables put Status fifth and write the id as a `[T4](T4-....md)` link, and
    on those the pattern matched NOTHING. Three ADRs and eleven tasks sat outside
    this check entirely, and one of them was marked done with an empty Verification
    Log — the exact state the check exists to reject, passing green.

    The second version anchored on the FIRST cell. A third shape defeated that
    one: `| Order | Task | Scope | Depends-on | Status |` puts a number in cell 0
    and the id in cell 1, so the row matched nothing again — and this project's
    OWN fixture is that shape, which is why check_verification had never once run
    under test. Found 2026-08-25 by feeding adr-lint an entry adr-verify wrote:
    a task marked `done` whose only evidence was `exit 3` passed green.

    So: find the LEFTMOST cell that names a task — that is the row's own id — and
    ask whether any cell after it is exactly `done`. Leftmost matters: a
    `Depends-on` cell names OTHER tasks, and scanning every cell would mark a
    dependency done because its dependent is.
    """
    out = []
    for line in readme_text.splitlines():
        line = line.strip()
        if not line.startswith("|"):
            continue
        cells = [c.strip() for c in line.strip("|").split("|")]
        if len(cells) < 2:
            continue
        found = next(((i, m) for i, c in enumerate(cells)
                      if (m := re.match(r"^\[?(T\d+)\b", c, re.I))), None)
        if found is None:
            continue
        index, m = found
        if any(c.lower() == "done" for c in cells[index + 1:]):
            out.append(m.group(1).upper())
    return out


# The statuses this reader ACTS on. `done` triggers the evidence checks;
# `pending` and `blocked` are the documented states of work not yet finished.
# Anything else is a word the tool cannot classify — and silently skipping the
# task is the failure below.
KNOWN_TASK_STATUS = {"done", "pending", "blocked"}


def status_word(cell):
    """The status a cell CLAIMS, ignoring how it is dressed.

    Real READMEs write `**done** (2026-07-29) — sshd drop-in split off to T3b`,
    not a bare token: emphasis markers, a date, and prose about what happened.
    The first version of the vocabulary check compared the whole cell and would
    therefore have fired on EVERY row of a corpus that writes them that way —
    caught 2026-08-29 before release by a session that reported its README shape
    while reporting a clean negative on something else (docs/BACKLOG.md §73).

    A check that fires on every row of a real corpus is a check people switch
    off, which is the same reason these findings are advice rather than blocks.
    """
    lead = re.match(r"[\s*_`~]*([A-Za-z][A-Za-z-]*)", cell or "")
    return lead.group(1).lower() if lead else ""


def check_task_status_vocabulary(infos, readme_text, errors):
    """A status this reader does not act on must SAY so, not quietly skip the task.

    Measured 2026-08-29 on a real corpus: changing one word in a tasks README —
    `done` to `partial` — took a task from 2 findings to 0. Not "partial is
    unmodelled", which was already known and filed: choosing the honest label
    REMOVED the task from every evidenced-task check at once, including a
    Mutation Log finding that was true regardless of how the task is labelled.

    The incentive that creates is the wrong way round. `done` buys scrutiny you
    may not survive, `pending` is a lie once code has landed, and `partial` — the
    truthful word — makes the linter stop looking. Nobody chose that. Reported
    with the number attached (docs/BACKLOG.md §73).

    This does not decide what `partial` should MEAN; that is a decision about the
    lifecycle, not a lint rule. It only refuses to let an unrecognised status pass
    for silence, which is this project's own distinction between "I could not
    look" and "there is nothing" (ADR-005).
    """
    if not readme_text:
        return
    # EVERY ROW IS BOUND TO ITS OWN TABLE. A README commonly holds TWO tables
    # whose first column is `| T1 |`: the status table, and a wave/ordering table
    # whose third column is DEPENDS-ON. Taking the status column index from the
    # first header and applying it to every later row read `T3, T5, T6` as a
    # status and advised on it — 7 of 28 records, one correct read and one
    # garbage read per task. Measured 2026-08-29 on a real corpus
    # (docs/BACKLOG.md §75).
    #
    # The index is also per-table: one README's status table is
    # `ID | Title | Status | Owner | Acceptance` and another's is
    # `ID | Title | Status | Acceptance`, so a column number right for one is
    # wrong for the other even among the CORRECT tables. Bound by name, per
    # table, or the check is reading the right position in the wrong container.
    lines = [ln.strip() for ln in readme_text.splitlines()]
    separator = re.compile(r"^\|[\s:|-]+\|?$")
    status_column = None
    rows = []
    for i, line in enumerate(lines):
        if not line.startswith("|"):
            status_column = None       # a table ends where the table rows end
            continue
        if separator.match(line):
            continue
        cells = [c.strip() for c in line.strip("|").split("|")]
        header = i + 1 < len(lines) and separator.match(lines[i + 1])
        if header:
            status_column = next((j for j, c in enumerate(cells) if c.lower() == "status"), None)
            continue
        if status_column is not None:
            rows.append((status_column, cells))
    for status_column, cells in rows:
        if status_column >= len(cells):
            continue
        found = next(((m.group(1).upper()) for c in cells
                      if (m := re.match(r"^\[?(T\d+)\b", c, re.I))), None)
        value = cells[status_column].strip()
        if found is None or not value or set(value) <= set("-— "):
            continue
        if status_word(value) in KNOWN_TASK_STATUS or found not in infos:
            continue
        errors.advise(
            f"README.md: {found} has status `{value}`, which this reader does not act on — so the "
            f"checks that run for an evidenced task did NOT run for it, including whether its "
            f"Verification Log backs what it claims and whether it carries a Mutation Log. That is "
            f"'not looked at', not 'nothing found'. Use `done`, `pending` or `blocked`, or say in "
            f"the task file what the status means.")


def check_verification(infos, readme_text, errors):
    """README `done` status requires tool-written passing evidence in the task's log."""
    if not readme_text:
        return
    for tid in done_task_ids(readme_text):
        inf = infos.get(tid)
        if inf is None:
            continue
        if inf["human"]:
            if not any("· human-observed ·" in b for b in inf["vlog"]):
                errors.append(f"README.md: {tid} marked done but its Verification Log has no "
                              f"'· human-observed ·' sign-off entry (adr-verify --human)")
            continue
        entries = [b for b in inf["vlog"] if VLOG_RE.match(b)]
        passing = [b for b in entries if "· exit 0 ·" in b]
        # TRAJECTORY, not just outcome. Everything else here asks whether the
        # check PASSED; this asks whether the sequence that produced the pass was
        # the one the task claimed. Ordered Steps step 1 is required to say
        # "establish the failing test", and that requirement has always been
        # about the PROSE — a task could say TDD and show a log that only ever
        # passed, which proves the fence runs and not that it can fail here.
        #
        # ADVICE, never blocking, for two reasons. Six records in this
        # repository's own corpus were written after the code shipped and say so
        # in their opening; failing them retroactively is the day-one gate people
        # switch off. And the shape is legitimate for a task whose work was
        # already done — what is wrong is leaving it unsaid, not the ordering.
        # A KILLED MUTANT already shows the fence can fail — by breaking the
        # mechanism rather than by running before the work. That is the same
        # property from the other direction, and advising on top of it would be
        # noise on a task that has already proved the thing. Measured on this
        # corpus 2026-08-28: without this clause the check fires on nine tasks,
        # six of which had killed a mutant.
        killed = any("mutant killed" in b for b in inf.get("mlog", []))
        if passing and entries and "· exit 0 ·" in entries[0] and not inf["human"] and not killed:
            errors.advise(f"{tid}: every Verification Log entry passed, so nothing here shows the "
                          f"fence could fail — the first entry should be the TDD red run. If the "
                          f"work predated the record, say so in the task rather than leaving the "
                          f"log to imply a red-green cycle that did not happen")
        if not passing:
            errors.append(f"README.md: {tid} marked done but its Verification Log has no "
                          f"exit-0 entry — run adr-verify, don't hand-declare")
            continue
        if inf["acc_all"]:
            want_digest = acceptance_digest(inf["acc_all"])
            digest_matches = [m for b in passing
                              if (m := VLOG_DIGEST_RE.match(b))
                              and m.group("digest") == want_digest]
            legacy_matches = []
            if "\n" not in inf["acc_all"]:
                want = inf["acc_first"].replace("`", "'")
                legacy_matches = [m for b in passing
                                  if (m := VLOG_LEGACY_RE.match(b))
                                  and not m.group("command").rstrip().endswith(" …")
                                  and m.group("command").strip() == want]
            if not digest_matches and not legacy_matches:
                legacy_note = (" Legacy no-digest evidence cannot prove a multi-line fence."
                               if "\n" in inf["acc_all"] else "")
                errors.append(f"README.md: {tid} marked done but no exit-0 entry has the "
                              f"current Acceptance digest acceptance-sha256:{want_digest}."
                              f"{legacy_note} Acceptance changed after verification; re-run "
                              f"adr-verify")


def check_status_allows_execution(adr_path, readme_text, errors):
    """A task cannot be `done` while its own ADR still says `Proposed`.

    /adr-execute's stated precondition is Status `Accepted`, and every other gate
    in the chain reads the TASK files — nothing ever read the parent's Status. So
    an ADR can be authored Proposed, executed, verified, committed and shipped to
    production with every gate green and its own record still saying the decision
    was never taken. Measured 2026-08-21: ADR-088 ran both tasks to `done`, both
    with exit-0 adr-verify entries, and reached prod while the file said Proposed.

    Statuses other than Proposed/Draft/Rejected are allowed, because an ADR that
    was accepted and later superseded or deprecated was legitimately executed.
    """
    if not readme_text:
        return
    done = done_task_ids(readme_text)
    if not done:
        return
    text = Path(adr_path).read_text(errors="replace", encoding="utf-8")
    m = re.search(r"^\*\*Status:\*\*\s*(.+?)\s*$", text, re.M)
    if not m:
        return  # the missing-Status line is already reported by check_adr
    status = m.group(1).strip().strip("`*")
    if re.match(r"^(proposed|draft|rejected)\b", status, re.I):
        errors.append(f"{adr_path.name}: Status is '{status}' but "
                      f"{', '.join(sorted(done))} {'is' if len(done) == 1 else 'are'} marked done "
                      f"— execution requires Accepted; either the decision was never taken or the "
                      f"record was never updated, and both are wrong to leave standing")


def looks_like_a_test(path):
    """Whether a resolved file is plausibly a test file at all.

    `test_body` matches any FUNCTION with the wanted name, which is right where a
    test IS a function (Python, Go) and says nothing about whether the file is a
    test. `bin/adr-lint::enforcement_pointers` names a production function in a
    gate, and it resolved as a test — so a record would read as backed by a check
    that is really the thing being checked.

    That assertion was passing for the wrong reason until 2026-08-28: a gate has
    no file extension, so it was parsed under JavaScript comment rules, and
    whether `def enforcement_pointers(` survived masking depended on where the
    `/*` sequences in its own docstrings happened to fall. Editing an unrelated
    comment flipped it. Now it is decided by the path.

    Biased toward NOT finding: a false "not found" is visible advice on a valid
    pointer, while a false "found" tells a reader a test backs a decision when
    none does, and says nothing at all.
    """
    parts = [part.lower() for part in path.parts]
    return (any(part in ("test", "tests", "spec", "specs", "__tests__") for part in parts)
            or "test" in path.name.lower() or "spec" in path.name.lower())


def resolve_test_file(root, rel):
    """Find the file a Tests-table row names, or None.

    Rows are written for humans and often give a bare filename rather than a
    repo-relative path, so an exact join is not enough — insisting on one would
    flag dozens of rows whose test exists perfectly well a few directories down,
    and a gate that cries wolf is one people learn to skip. The fallback searches
    by basename and only accepts an unambiguous single match: two files with the
    same name mean the row does not say which, and guessing would be worse than
    saying nothing.
    """
    direct = root / rel
    if direct.exists():
        return direct
    base = Path(rel).name
    if not base or base in (".", "/"):
        return None
    hits = [q for q in root.rglob(base)
            if q.is_file() and ".git/" not in str(q) and "/node_modules/" not in str(q)
            and "/target/" not in str(q) and "/vendor/" not in str(q)]
    return hits[0] if len(hits) == 1 else None


def check_mutation_evidence(infos, readme_text, errors):
    """A task with passing acceptance must show that its fence CAN fail.

    The asymmetry this closes, stated plainly: every other check in the pipeline
    proves a command exited 0. Nothing proved a command can exit non-zero, so a
    test bound to nothing passes exactly like a test bound to the mechanism. The
    task template used to ask for a hand-filled Mutants table — the same
    fabrication hole the Verification Log closed, one section further down.

    Migration-safe by the passing-evidence date. A task whose latest passing
    evidence predates MUTATION_REQUIRED_FROM remains grandfathered. Once the
    Acceptance fence is verified on or after the cutover, however, its killed
    mutant must carry the same digest; an older unbound kill cannot prove a
    changed current fence.
    """
    for tid in evidenced_task_ids(infos, readme_text):
        inf = infos.get(tid)
        if inf is None or inf.get("human"):
            continue
        dates = [b[2:12] for b in inf.get("vlog", []) if VLOG_RE.match(b)]
        if not dates or max(dates) < MUTATION_REQUIRED_FROM:
            continue  # predates the tool; see the docstring
        want_digest = acceptance_digest(inf.get("acc_all", ""))
        killed = []
        for entry in inf.get("mlog", []):
            if not MLOG_RE.match(entry) or "· mutant killed ·" not in entry:
                continue
            current = MLOG_DIGEST_RE.match(entry)
            if current and current.group("digest") == want_digest:
                killed.append(entry)
        if killed:
            continue
        if not inf.get("has_mlog"):
            errors.append(f"{inf['path'].name}: {tid} has passing acceptance evidence recorded on "
                          f"or after {MUTATION_REQUIRED_FROM} but has no ## Mutation Log section — "
                          f"a fence that passes is not a fence that can fail. Add the section and "
                          f"record a mutant with `adr-verify <task.md> --mutant …`")
        else:
            other = [b for b in inf.get("mlog", []) if MLOG_RE.match(b)]
            detail = (f"its log has {len(other)} entry/entries, none of them is a `killed` "
                      f"mutant for acceptance-sha256:{want_digest}"
                      if other else "its Mutation Log is empty")
            errors.append(f"{inf['path'].name}: {tid} has passing acceptance evidence but no "
                          f"`mutant killed` entry — {detail}. A survived mutant means the fence "
                          f"passed with the mechanism broken; inconclusive means it failed without "
                          f"a failing assertion. Neither is evidence the test binds to anything.")


def evidenced_task_ids(infos, readme_text):
    """Task ids whose Tests table is a claim someone has already acted on.

    `done` is not the only such state. A task marked `blocked` on something OUTSIDE the repo (a
    root-owned allow-list, a vendor account, a box needing sudo) still has a GREEN acceptance
    fence, and a green fence means the tests it names ran. Measured 2026-08-21: a task renamed a
    test, left the old name in its Tests table, and every table check skipped it purely because its
    README status was `blocked` — the stale row survived a full adr-lint pass, which is exactly the
    "list kept beside the truth" failure these checks exist to catch.

    So the question is asked of any task that is `done` OR carries an exit-0 adr-verify entry.
    """
    ids = set(done_task_ids(readme_text)) if readme_text else set()
    for tid, inf in infos.items():
        if inf.get("human"):
            continue
        if any(VLOG_RE.match(b) and "· exit 0 ·" in b for b in inf.get("vlog", [])):
            ids.add(tid)
    return sorted(ids)


# What may precede a `/` that opens a regex rather than dividing. Duplicated
# from bin/spec-verify rather than shared: these gates are standalone scripts by
# design, with no import path between them, for the same reason adr-verify
# carries its own copy of normalize_acceptance. The duplication is the price and
# it is named here so a fix to one is knowingly applied to the other.
REGEX_MAY_FOLLOW = set("(,=:[!&|?{};+-*~^%")
REGEX_MAY_FOLLOW_WORD = {"return", "typeof", "case", "in", "of", "delete", "void", "instanceof",
                         "do", "else", "yield", "await"}
CONTROL_HEADER = {"if", "while", "for", "with"}


def starts_regex(text, i):
    """Whether the `/` at `i` opens a regex literal rather than dividing.

    JavaScript decides from the previous significant token: after a VALUE it is
    division, after an operator or an opening bracket it is a regex. Guessing
    toward division is the safe direction — a `/` misread as a regex blanks at
    most to the end of a line, while one misread as division leaves a real regex
    unmasked and its `/*` then opens a comment that runs to the next `*/`
    anywhere in the file.
    """
    j = i - 1
    while j >= 0 and text[j] in " \t\r\n":
        j -= 1
    if j < 0:
        return True
    if text[j] in REGEX_MAY_FOLLOW:
        return True
    # `)` is the ambiguous one: closing a CALL it is a value and `/` divides;
    # closing an `if`/`while`/`for` header a regex may follow.
    if text[j] == ")":
        depth, k = 0, j
        while k >= 0:
            if text[k] == ")":
                depth += 1
            elif text[k] == "(":
                depth -= 1
                if depth == 0:
                    break
            k -= 1
        if k < 0:
            return False
        k -= 1
        while k >= 0 and text[k] in " \t\r\n":
            k -= 1
        end = k
        while k >= 0 and (text[k].isalnum() or text[k] == "_"):
            k -= 1
        return text[k + 1:end + 1] in CONTROL_HEADER
    k = j
    while k >= 0 and (text[k].isalnum() or text[k] == "_"):
        k -= 1
    return text[k + 1:j + 1] in REGEX_MAY_FOLLOW_WORD


def strip_comments(text):
    """JavaScript with `//` and `/* */` removed and string contents intact.

    `code_only` blanks string CONTENTS, which is right for finding a definition
    and wrong here: a registration name is a string literal, so masking strings
    hides every real test. What has to go is the comments, because a
    commented-out registration is not one.

    STRINGS AND REGEX LITERALS ARE SKIPPED WHOLE, and that is the whole fix.
    This knew `//` and `/* */` and no other JavaScript construct, so a `/*`
    inside a regex's character class — `/[a-z/*-]+/g` — opened a block comment
    that ran to the next `*/` anywhere in the file. Measured 2026-08-28 on
    tests/package.test.mjs: everything after the regex vanished, and a pointer
    naming a test plainly present in that file reported as naming nothing. Same
    class as the defect ADR-005 fixed in spec-verify's mask_noncode, one tool
    over and still open, which is why the sweep now covers both.

    Quotes are LINE-BOUNDED except for backticks, so an apostrophe in prose
    cannot swallow the rest of the file either.
    """
    out, i, n = [], 0, len(text)
    while i < n:
        char, two = text[i], text[i:i + 2]
        if char in "'\"`":
            j = i + 1
            while j < n:
                if text[j] == "\\":
                    j += 2
                    continue
                if text[j] == char:
                    j += 1
                    break
                if text[j] == "\n" and char != "`":
                    break
                j += 1
            out.append(text[i:j])
            i = j
        elif two == "//":
            end = text.find("\n", i)
            i = n if end < 0 else end
        elif two == "/*":
            end = text.find("*/", i + 2)
            i = n if end < 0 else end + 2
        elif char == "/" and starts_regex(text, i):
            j, in_class = i + 1, False
            while j < n and text[j] != "\n":
                if text[j] == "\\":
                    j += 2
                    continue
                if text[j] == "[":
                    in_class = True
                elif text[j] == "]":
                    in_class = False
                elif text[j] == "/" and not in_class:
                    j += 1
                    break
                j += 1
            out.append(text[i:j])
            i = j
        else:
            out.append(char)
            i += 1
    return "".join(out)


def enforcement_pointers(text):
    """The checks a record claims enforce it, or [] when it claims none.

    `None — <reason>` is a first-class answer and yields no pointers: most
    durable decisions have no cheap mechanical enforcement, and a record that
    says so is carrying information the corpus otherwise lacks.
    """
    raw = header_val(text, "Enforced-by")
    if raw is None:
        return []
    value = raw.strip()
    # WORD-BOUNDED. `startswith("none")` swallowed `nonetheless-a-real-pointer`,
    # which the JavaScript parser did not — one rule, two implementations, three
    # disagreements. The shared truth table in tests/gate-regressions.py is
    # mirrored in the JS suite so the two cannot drift again unnoticed.
    if not value or re.match(r"none\b", value, re.I):
        return []
    # A BACKTICKED span is one item, commas inside it included — a mutation
    # label reads "…mutates, exactly once", and splitting on every comma tore it
    # in half. Whatever is left outside the backticks is then comma-separated.
    #
    # The first fix here split on all commas, which fixed the dropped `two` from
    # "`one`, two" and broke every label containing one. Both cases are in the
    # shared truth table now.
    parts = []
    rest = []
    position = 0
    for span in re.finditer(r"`([^`]*)`", value):
        rest.append(value[position:span.start()])
        parts.append(span.group(1).strip())
        position = span.end()
    rest.append(value[position:])
    parts += [p.strip() for p in ",".join(rest).split(",")]
    # `<the check>` is the template placeholder, not a pointer to anything.
    return [p for p in parts if p and not re.match(r"[<(]", p)]


def leaves_the_tree(pointer):
    """True when a pointer names somewhere outside the repository being linted.

    A pointer may not leave the tree. `../README.md` and an absolute path both
    resolved as gates once, so a file outside the repository — including one
    under a user's home directory — could satisfy a record's enforcement claim.

    BOTH separators, on every platform, and that is the fix rather than a
    nicety. The check split on "/" alone, so `..\\skills\\adr-write\\SKILL.md`
    reached neither branch: no forward slash means no `..` segment to find, and
    the gate form's own "contains no /" test then read it as a bare name. On
    Windows it resolved from the gate directory to an ordinary Markdown file, so
    a record would report as enforced by a skill document. Normalizing here also
    makes the rule testable off Windows: a backslash is a legal filename
    character on POSIX, so the resolution simply missed and the guard looked
    correct while doing nothing.
    """
    normal = pointer.replace("\\", "/")
    return (normal.startswith("/")
            or ".." in normal.split("/")
            or re.match(r"^[A-Za-z]:", pointer) is not None)


def resolve_enforcement(pointer, root):
    """Which FORM a pointer resolved as, or None when it names nothing here.

    Three forms, deliberately ordered by how much they prove:

      "mutation"  a catalogue label — the campaign grades it RED or GREEN on
                  every run, so the claim is MEASURED rather than asserted.
      "test"      a `path::name` id — proves the check exists, not that it can
                  fail. That is ADR-003's rule and mutate.mjs's job.
      "gate"      an executable in bin/.

    This never runs anything. A linter that executed a check would be a
    different tool with a different cost, and the pointer's job is to be
    followable, not to be re-proved on every lint.
    """
    if root is None or leaves_the_tree(pointer):
        return None
    catalogue = root / "tests" / "mutations.json"
    if catalogue.is_file():
        try:
            labels = {m.get("label") for m
                      in json.loads(catalogue.read_text(encoding="utf-8", errors="replace"))
                      .get("mutations", [])}
            if pointer in labels:
                return "mutation"
        except (ValueError, OSError):
            pass
    if "::" in pointer:
        rel, name = pointer.split("::", 1)
        f = resolve_test_file(root, rel.strip())
        if f is not None and f.is_file():
            source = code_only(f.read_text(errors="replace", encoding="utf-8"),
                               python=f.suffix == ".py")
            # `test_body`, the same resolver check_tests_exist uses — NOT a
            # substring search over `code_only`, which blanks string contents and
            # so cannot see a JavaScript test name, since that name IS a string
            # literal. Measured while writing this: the substring form resolved
            # the mutation and gate forms and silently failed every `path::name`.
            wanted = name.strip()
            # `test_body` matches any FUNCTION with that name, which is right for
            # Python and Go — where a test IS a function — and wrong everywhere a
            # test is a registration call, because a production function then
            # resolves. `lifecycle.mjs::shellWords` did.
            javascript = f.suffix in (".js", ".jsx", ".mjs", ".cjs", ".ts", ".tsx")
            if wanted and not javascript and looks_like_a_test(f) and test_body(
                    source, wanted, python=f.suffix == ".py") is not None:
                return "test"
            # A `node:test` name is a STRING ARGUMENT, not a function name, so
            # test_body cannot see it — and code_only blanks string contents, so
            # a substring search cannot either. This repository's own JS tests
            # are all of that shape. Matched against the raw text, anchored to a
            # registration call so a name merely MENTIONED in a comment or a
            # table does not resolve.
            # Comments stripped, string CONTENTS kept — a registration name IS a
            # string literal, so masking strings would hide every real one, and
            # not masking comments resolved `// test('ghost', ...)`. The comment
            # that used to sit here claimed a mention in a comment did not
            # resolve; it did. Second time this session a comment carried the bug.
            #
            # `.skip` and `.only` are registrations too, and were being rejected
            # as absent while a commented-out ghost resolved — wrong in both
            # directions at once.
            # Anchored to STATEMENT POSITION — start of line after whitespace.
            # A registration inside a string literal (`const s = "test('x')"`)
            # is not one, and excluding it properly needs a lexer; requiring
            # line-start costs a registration written mid-line, which node:test
            # code does not do, and buys the string case for one anchor.
            #
            # The direction of the trade is deliberate: a false "not found"
            # produces visible advice on a valid pointer, while a false "found"
            # is silent and tells a reader a test backs a decision when none does.
            if wanted and javascript and re.search(
                    r"^[ \t]*(?:await[ \t]+)?(?:test|it)(?:\.\w+)*\s*\(\s*(['\"`])"
                    + re.escape(wanted) + r"\1",
                    strip_comments(f.read_text(errors="replace", encoding="utf-8")), re.M):
                return "test"
        return None
    # A DIRECT entry of a bin/, not any path that happens to land inside one
    # after resolution. `README.md` is a repository file, not a gate.
    #
    # Two directories, and the second is the one that matters outside this
    # repository. A record naming `adr-lint` means THIS gate — the harness's —
    # and until ADR-008 that resolved only because quality-harness's own gates
    # sat at its repository root. In any other project it never did: the gates
    # are invoked by name through PATH from the plugin, so `<their repo>/bin`
    # holds nothing, and a valid pointer collected advice saying the check does
    # not exist. That is a gate reporting an observation it did not make, which
    # is exactly what ADR-005 forbids one tool over.
    if "/" not in pointer.replace("\\", "/"):
        here = Path(__file__).resolve().parent
        for gate in (root / "bin" / pointer, here / pointer):
            if gate.is_file():
                return "gate"
    return None


def check_enforcement(text, path, errors, root):
    """Advise when a record names a check that does not exist.

    ADVICE, never blocking, and it stays that way. Most decisions in most
    corpora are not mechanically enforced, six of the eight records here predate
    the header entirely, and a gate that fails a record for being honest about
    that is the day-one gate people switch off.

    What it is for: `Governs:` says which paths a decision owns, and nothing said
    what FAILS when the decision is violated. A task's Acceptance proves the task
    got DONE, which is a different question from whether the decision still holds
    a year later — and the task's tests are freely rewritten once it is.
    """
    for pointer in enforcement_pointers(text):
        if resolve_enforcement(pointer, root) is None:
            errors.advise(f"{path.name}: Enforced-by names `{pointer}`, which is not a mutation "
                          f"label in tests/mutations.json, a `path::name` test that exists, or a "
                          f"gate in bin/ — a pointer to nothing is the rot this header exists to "
                          f"avoid. Name the check, or say `None — <reason>`")


def tracked_paths(root):
    """Repository-relative paths git knows about, or None when git cannot answer.

    None and an EMPTY SET are different answers and must never collapse. An
    empty set says "this tree holds no files"; None says "I could not look", and
    resolving pointers against a None that was quietly read as empty would make
    every pointer in the corpus a finding at once — a gate reporting an
    observation it never made (ADR-005).

    `--others --exclude-standard` is included because a record and the files it
    governs are commonly added in the same commit, and a check that only sees
    the index would report a path that is right there in the working tree.

    Against git rather than the filesystem, deliberately: `Path.exists()` answers
    "is this on THIS machine", which makes the gate's verdict depend on who is
    asking (ADR-008, and the four CI jobs that failed on a commit which passed
    on the laptop that wrote it).
    """
    if root is None:
        return None
    found = set()
    for args in (["ls-files"], ["ls-files", "--others", "--exclude-standard"]):
        try:
            r = subprocess.run(["git", "-C", str(root), "-c", "core.quotePath=false", *args],
                               capture_output=True, text=True, timeout=30,
                               encoding="utf-8", errors="replace")
        except Exception:
            return None
        if r.returncode != 0:
            return None
        found.update(line.strip() for line in r.stdout.splitlines() if line.strip())
    return found


def _glob_to_regexp(pattern):
    """One glob component at a time, so `**` crosses separators and `*` cannot.

    A transcription of `lifecycle.mjs::globToRegExp`, and a transcription is what
    it must stay: the two are compared input by input in
    `tests/gate-regressions.py::GOVERNS_MATCH_GRAMMAR`, mirrored in the JS suite.
    ADR-009 shipped one rule as two implementations on the same terms, and the
    truth table is the only thing that keeps them honest.
    """
    normal = re.sub(r"^\./", "", pattern.replace("\\", "/"))
    source = "^"
    index = 0
    while index < len(normal):
        char = normal[index]
        if char == "*":
            if index + 1 < len(normal) and normal[index + 1] == "*":
                source += ".*"
                index += 3 if normal[index + 2:index + 3] == "/" else 2
                continue
            source += "[^/]*"
        elif char == "?":
            source += "[^/]"
        else:
            source += re.escape(char)
        index += 1
    try:
        return re.compile(source + "$", re.I)
    except re.error:
        return None


def path_matches_declaration(candidate, declaration):
    """Whether a tracked file is covered by a `Governs:` declaration.

    A declared path matches the file itself, anything under it when it names a
    directory, and whatever its globs cover.

    BOTH separators are normalized before any structural test, on every
    platform. A declaration spelled `plugin\\bin\\**` is the same declaration,
    and a matcher that splits on "/" alone reports coverage it never checked
    (CLAUDE.md §7 — five defects of exactly this shape).
    """
    file = re.sub(r"^\./", "", candidate.replace("\\", "/"))
    declared = re.sub(r"^\./", "", declaration.replace("\\", "/")).rstrip("/")
    if not declared:
        return False
    if re.search(r"[*?]", declared):
        matcher = _glob_to_regexp(declared)
        return bool(matcher.search(file)) if matcher else False
    return file == declared or file.startswith(declared + "/")


def _split_pointer_list(value):
    """A backticked span is one item, commas inside it included.

    Extracted from `enforcement_pointers` rather than copied: a mutation label
    reads "…mutates, exactly once", and splitting on every comma tore it in
    half. `Cross-references:` needs the same parse, and a second copy of it is
    how the two would come to disagree.
    """
    parts = []
    rest = []
    position = 0
    for span in re.finditer(r"`([^`]*)`", value):
        rest.append(value[position:span.start()])
        parts.append(span.group(1).strip())
        position = span.end()
    rest.append(value[position:])
    parts += [p.strip() for p in ",".join(rest).split(",")]
    return [p for p in parts if p and not re.match(r"[<(]", p)]


def governs_declarations(text):
    """The paths a record declares authority over, or [] when it declares none.

    Tokenised the way `lifecycle.mjs::declaredGoverns` does — a backticked span
    or a run of non-space, non-comma characters — because the two must agree
    about what a declaration IS before they can agree about whether it resolves.
    The adrkit typed form is deliberately not read here: `adr-state` already
    records a non-`type: path` matcher as unresolved, and a second opinion about
    it from a different tool is worse than one.
    """
    raw = header_val(text, "Governs")
    if raw is None:
        return []
    value = raw.strip()
    if not value or re.match(r"none\b", value, re.I):
        return []
    found = []
    for token in re.finditer(r"`([^`]+)`|([^\s,]+)", value):
        item = (token.group(1) or token.group(2)).strip()
        if item and not re.match(r"[<(]", item):
            found.append(item)
    return found


def cross_reference_pointers(text):
    """The records and files a record cites, or [] when it cites none."""
    raw = header_val(text, "Cross-references")
    if raw is None:
        return []
    value = raw.strip()
    if not value or re.match(r"none\b", value, re.I):
        return []
    return _split_pointer_list(value)


def invalidates_pointer(text):
    """The record this one claims to invalidate, or None.

    THE LEADING TOKEN ONLY, and that is the whole parse. Every real value in
    this corpus is either `none — checked. ADR-003 governs …` or `ADR-001 — the
    clause of its Decision reading "…"`. Comma-splitting the second turns its
    prose into pointers, so this header does NOT reuse `_split_pointer_list`:
    one field, one parse, stated where a reader will look for it.
    """
    raw = header_val(text, "Invalidates")
    if raw is None:
        return None
    value = raw.strip()
    if not value or re.match(r"none\b", value, re.I):
        return None
    lead = value.split()[0].strip("`,;:")
    return lead or None


def resolve_record_number(pointer, corpus_dir):
    """Whether `ADR-001` names a record in this corpus.

    The same number comparison `resolve_qualified_dep` makes, without the task
    half — a cited record may have no tasks at all, and requiring one would
    report a real record as missing.
    """
    found = re.match(r"ADR-0*(\d{1,4})", pointer, re.I)
    if not found or corpus_dir is None:
        return False
    number = int(found.group(1))
    for candidate in sorted(corpus_dir.glob("ADR-*.md")):
        digits = re.match(r"ADR-0*(\d{1,4})", candidate.name, re.I)
        if digits and int(digits.group(1)) == number:
            return True
    return False


def _looks_like_a_path(pointer):
    """A cited token that names a file rather than a section or a phrase.

    `§45` is a fragment OF the file cited beside it, not a file of its own;
    `section_fragments` pairs it back up and `check_pointers` resolves it there.
    """
    return bool(re.search(r"[/\\]", pointer) or re.search(r"\.\w+$", pointer))


SECTION_FRAGMENT = re.compile(r"§\s*(\d+)")


def section_fragments(pointers):
    """Each `§NN` fragment paired with the path it is a fragment of.

    `Cross-references: docs/BACKLOG.md §44, §45` splits into three items, and the
    bare `§45` inherits its file from the item before it — which is how every
    multi-section citation in this corpus is written. A fragment with no path
    ahead of it names nothing resolvable and is dropped rather than guessed at,
    for the reason ADR-005 gives: a guess that lands wrong reads as a finding.
    """
    pairs = []
    current = None
    for pointer in pointers:
        head = pointer.split()[0].strip("`,") if pointer.split() else ""
        if head and _looks_like_a_path(head) and not leaves_the_tree(head):
            current = head
        if current:
            pairs += [(current, int(n)) for n in SECTION_FRAGMENT.findall(pointer)]
    return pairs


def has_section(text, number):
    """Whether a markdown heading in `text` numbers this section.

    The corpus writes them `## 44. Title`, and `## 34 (superseded).` is the one
    that carries no period — so the digits are required and the punctuation after
    them is not. `\\b` keeps `§4` from matching `## 44`, which a prefix test would
    resolve happily and wrongly.
    """
    return re.search(rf"^#{{1,6}}\s+0*{number}\b", text, re.M) is not None


def _read_pointed_file(root, relative):
    """The text of a cited repository-relative path, or None when it cannot be read.

    None is COULD NOT LOOK and never "the file says nothing" (ADR-005). Built
    with `Path` rather than by joining separators, because a `/` written into a
    literal is an assertion about the operating system (CLAUDE.md §7).
    """
    if root is None:
        return None
    try:
        return (Path(root) / PurePosixPath(relative)).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return None


def check_pointers(text, path, errors, root, corpus_dir, tracked=None):
    """Advise when `Governs:`, `Cross-references:` or `Invalidates:` names nothing.

    ADVICE, never blocking, and it stays that way for ADR-009's reason and one of
    its own: a corpus adopting this on a tree it did not write will light up, and
    this repository's own corpus would have failed for the two days after ADR-008
    moved the tree — during which nothing was wrong with any record.

    `tracked` is injectable so the could-not-look branch is reachable from a
    test on any platform. A branch with no seam is a branch with no test.
    """
    if tracked is None:
        tracked = tracked_paths(root)
    if tracked is False or tracked is None:
        errors.advise(f"{path.name}: could not list the files git tracks, so `Governs:`, "
                      f"`Cross-references:` and `Invalidates:` were NOT resolved. This is "
                      f"'I could not look', not 'those pointers name nothing'")
        return
    for declaration in governs_declarations(text):
        if leaves_the_tree(declaration):
            errors.advise(f"{path.name}: Governs: declares `{declaration}`, which points outside "
                          f"the repository — a decision cannot own a path it does not contain")
        elif not any(path_matches_declaration(f, declaration) for f in tracked):
            errors.advise(f"{path.name}: Governs: declares `{declaration}`, which no tracked file "
                          f"matches — the decision governs nothing, and `adr-context` will answer "
                          f"'none governs' for the code it was written about")
    for pointer in cross_reference_pointers(text):
        head = pointer.split()[0].strip("`,") if pointer.split() else ""
        if not head:
            continue
        if re.match(r"ADR-\d", head, re.I):
            if not resolve_record_number(head, corpus_dir):
                errors.advise(f"{path.name}: Cross-references: cites `{head}`, which is not a "
                              f"record in this corpus")
        elif _looks_like_a_path(head) and not leaves_the_tree(head):
            if not any(path_matches_declaration(f, head) for f in tracked):
                errors.advise(f"{path.name}: Cross-references: cites `{head}`, which no tracked "
                              f"file matches")
    for relative, number in section_fragments(cross_reference_pointers(text)):
        if not any(path_matches_declaration(f, relative) for f in tracked):
            continue  # the loop above already named the path; one finding, not two
        body = _read_pointed_file(root, relative)
        if body is None:
            errors.advise(f"{path.name}: Cross-references: cites `{relative} §{number}`, which was "
                          f"NOT resolved — that file is tracked but could not be read from here. "
                          f"This is 'I could not look', not 'the section is missing'")
        elif not has_section(body, number):
            errors.advise(f"{path.name}: Cross-references: cites `{relative} §{number}`, but that "
                          f"file has no heading numbering section {number}")
    invalidated = invalidates_pointer(text)
    if invalidated and not resolve_record_number(invalidated, corpus_dir):
        errors.advise(f"{path.name}: Invalidates: names `{invalidated}`, which is not a record in "
                      f"this corpus — a decision cannot invalidate one that was never written")


def ignored_paths(root, candidates):
    """Which of `candidates` git IGNORES, as {path: the pattern that matched}.

    An acceptance fence runs against the WORKTREE. A file matched by
    `.gitignore` is in the worktree and will never be in the commit, so a task
    can record tool-written exit-0 evidence for work that ships to nobody:
    measured 2026-08-29 on a Go repository whose `.gitignore` held the bare
    pattern `crossagentschat` for a build artifact, which also matched
    `cmd/crossagentschat/` because a pattern with no slash matches at any depth
    and matches directories. A clean clone did not build, and a guard that task
    introduced against logging a credential existed in no committed file
    (docs/BACKLOG.md §65).

    IGNORED, not "missing", is the signal: at authoring time a task's files
    legitimately do not exist yet, so a check for existence would fire on every
    new task and be switched off by the second day. "Ignored" has no such
    timing ambiguity — it means "will never be committed", whatever the clock
    says.

    `check-ignore -v` names the pattern, because "the bare pattern
    `crossagentschat` matches at any depth" is the sentence that ends the
    investigation, and a finding that only says "this file is missing" starts a
    different and longer one.
    """
    if not candidates:
        return {}
    # No repository is a COULD-NOT-LOOK, not an all-clear: the question "does
    # git ignore this path" has no answer outside a repository, and answering {}
    # would report silence as safety (ADR-005).
    if root is None:
        return None
    try:
        # -z, because the LINE form quotes a path and keeps the platform's line
        # ending: on Windows the first version of this parsed
        # `"cmd/thing/main.go\r"` — quoted AND carrying a CR — and matched
        # nothing. Caught by the Windows job, which is the only place it could
        # be (CLAUDE.md §7). With -z the fields are NUL-separated and raw:
        # <source> NUL <line> NUL <pattern> NUL <path> NUL.
        r = subprocess.run(["git", "-C", str(root), "-c", "core.quotePath=false",
                            "check-ignore", "-v", "-z", "--stdin"],
                           input="\0".join(sorted(candidates)) + "\0", capture_output=True,
                           text=True, timeout=30, encoding="utf-8", errors="replace")
    except Exception:
        return None
    # 0 = at least one ignored, 1 = none ignored, 128 = not a repository. Only
    # the first two are ANSWERS; anything else is "could not look", and it
    # returns None rather than {} so the caller can SAY it could not check
    # (ADR-005). Returning {} made the two indistinguishable — and the campaign
    # proved it, with a mutation removing this guard that nothing could kill,
    # because a guard with no observable effect is decoration.
    if r.returncode not in (0, 1):
        return None
    fields = r.stdout.split("\0")
    found = {}
    for i in range(0, len(fields) - 3, 4):
        pattern, path_name = fields[i + 2], fields[i + 3]
        if path_name:
            found[path_name] = pattern
    return found


def check_tests_exist(infos, readme_text, errors, root):
    """A `done` task's Tests table must name tests that exist in the files it names.

    This is the static half of the vacuous-acceptance hole. A filter that matches
    nothing exits 0 on go, phpunit and cargo, so an acceptance command can pass
    with none of the task's tests written. adr-verify now catches an entirely
    empty run; this catches the subtler case where the command DID run something
    — an existing test whose name shares the filter's prefix — while the tests
    this task promised were never written.

    It reads the real files rather than trusting the table, for the same reason
    the table exists: a list kept beside the truth is a thing somebody has to
    remember, which is precisely what fails.
    """
    if not readme_text or root is None:
        return
    for tid in evidenced_task_ids(infos, readme_text):
        inf = infos.get(tid)
        if inf is None or inf.get("human"):
            continue
        for name, rel in inf.get("tests", []):
            if not re.match(r"^[A-Za-z_][\w:.\-]*$", name):
                continue  # placeholder like "—" or a prose description
            f = resolve_test_file(root, rel)
            # A Tests-table cell naming a DIRECTORY (a suite path like `tests/Feature/`) resolved to
            # a real path and then crashed read_text with "Is a directory" — the linter died instead
            # of reporting, which exits non-zero and so reads as a finding while having checked
            # nothing after it (measured 2026-08-21, same failure mode as the missing-Spec crash).
            if f is not None and f.is_dir():
                errors.append(f"{inf['path'].name}: {tid} names `{rel}` for `{name}`, but that is a "
                              f"DIRECTORY — a Tests row must name the file the test lives in")
                continue
            if f is None:
                errors.append(f"{inf['path'].name}: {tid} has passing acceptance evidence and its "
                              f"Tests table names `{rel}` for `{name}`, but no such file exists "
                              f"in the repo — the row describes a test nothing can run")
                continue
            # RAW source: `test_body` strips per branch, because a BDD test's name
            # is a string literal and stripping strings here deleted the thing
            # being searched for (docs/BACKLOG.md §57).
            source = f.read_text(errors="replace", encoding="utf-8")
            if test_body(source, name, python=f.suffix == ".py") is None:
                # NO CLAIM ABOUT THE FILTER. This used to end "the acceptance
                # filter passed without it", which is an inference the check never
                # makes: measured 2026-08-29 on a 77-record corpus where four of
                # the reported tasks run WHOLE-FILE acceptance commands with no
                # `-k` at all, so nothing was filtered (docs/BACKLOG.md §61). The
                # existence finding is solid and the mechanism was fabricated —
                # a gate reporting an observation it did not make (ADR-005), in
                # the sentence of a check that is otherwise 17-for-18 correct.
                #
                # AND NO LIKELIEST CAUSE. The replacement briefly said a rename is
                # the commonest cause; the same session then FIXED its residue and
                # measured 3 confirmed renames out of 17, with ~11 having no
                # plausible equivalent anywhere. Naming the wrong likeliest cause
                # is worse than naming none, because the nearest-looking neighbour
                # is always right there: the cheap resolution becomes writing it
                # into the table, which closes the finding by asserting coverage
                # nobody verified. A gate must not prompt a fabrication.
                errors.append(f"{inf['path'].name}: {tid} has passing acceptance evidence and its "
                              f"Tests table names `{name}` in `{rel}`, but that file contains no "
                              f"executable definition with that name — so the row describes a test "
                              f"the acceptance run cannot have exercised. Either the test was never "
                              f"written, or the table is stale after a rename — if you substitute a "
                              f"name, check it covers the same behaviour before you edit")


# Test bodies that cannot fail, and tests the Acceptance never runs.
#
# check_tests_exist proves a named test EXISTS. Existence is a weak property:
# a function with no failure path satisfies it and can never go red, and so does
# a real test the Acceptance command never selects. Both leave a `done` task whose
# evidence chain has a hole in the middle, and both are mechanical to catch.
FAIL_CALLS = re.compile(
    r"\bt\.(Error|Errorf|Fatal|Fatalf|FailNow|Fail)\b"      # go
    r"|\b(assert|require|expect)\b"                          # go testify / js / rust-ish
    r"|\bself\.assert|\bassert\s"                          # python
    r"|\$this->assert|\bassertThat\b"                       # php / java
    # FLUENT chains. Measured 2026-08-21: three Livewire tests that a mutation run had just
    # PROVEN could go red were reported as unable to fail, because `\b(assert|require|expect)\b`
    # needs a word boundary AFTER the word and `assertTableActionExists` has none, while
    # `\$this->assert` needs the `$this->` receiver a fluent chain does not have. Livewire,
    # Laravel's TestResponse, Playwright and jest/supertest all assert this way, so the check was
    # blind to an entire testing idiom and reported a correct artifact as broken — the kind of
    # false alarm that teaches people to skip the gate.
    r"|->assert\w*\s*\("                                     # ->assertX(...) on any receiver
    r"|\bassert\w*\s*\(",                                   # bare assertX(...) call
    re.I)


def commented_out(text, index):
    """Is the match at `index` on a line that a comment marker opens?

    The BDD branch reads raw text because the test's NAME is a string literal,
    so it cannot lean on `code_only` to drop commented code the way the other
    branches do. This is the narrow replacement: a `// it('x', …)` left behind
    when someone disabled a test is not a test that exists.
    """
    start = text.rfind("\n", 0, index) + 1
    return re.match(r"\s*(?://|#|\*|--)", text[start:index]) is not None


def test_body(text, name, python=False):
    """The source of the named test function, best-effort across languages.

    The opening brace may sit on the declaration line (Go, JS) or on the NEXT one
    (PSR-12 PHP, C#). Measured 2026-08-21: the earlier version required it on the
    declaration line, so for every PHP test in a PSR-12 codebase it fell through to
    the `def |func |fn |class ` heuristic, matched none of those keywords, and
    returned THE ENTIRE REST OF THE FILE as the body. `check_tests_can_fail` then
    meant "does an assertion appear anywhere below this test", which is true of all
    but the last test in any file — a check that could not fail, inside the check
    for tests that cannot fail.

    So the declaration is matched as `name(...)` + optional return type + `{`, with
    newlines allowed before the brace, and the body is brace-matched from there. A
    `;` before the brace rules out an abstract/interface declaration. Languages with
    no brace at all keep the old keyword fallback.
    """
    if python:
        # D2 fix, part 2. Python has no braces, and brace-matching FIRST is
        # actively wrong here: the regex below matched the `def` line and then
        # brace-matched the first DICT LITERAL inside the test, returning that
        # dict as the whole body. Every assertion after it was invisible, so
        # correct tests were reported as unable to go red. Python bodies are
        # delimited by indentation, so read them that way.
        src_lines = text.splitlines(keepends=True)
        pat = re.compile(r'^(\s*)(?:async\s+)?def\s+' + re.escape(name) + r'\s*\(')
        for i, line in enumerate(src_lines):
            m2 = pat.match(line)
            if not m2:
                continue
            indent = len(m2.group(1))
            out = [line]
            for nxt in src_lines[i + 1:]:
                if nxt.strip() and (len(nxt) - len(nxt.lstrip())) <= indent:
                    break
                out.append(nxt)
            return ''.join(out)
        return None
    # THE BDD BRANCH MUST SEE THE RAW TEXT, and everything else must not.
    # `check_tests_exist` passes `code_only(...)` output, which blanks every
    # string literal — so `it('name', …)` arrives as `it('', …)` and a name that
    # IS a string is deleted before it can be searched for. The BDD fix shipped
    # earlier today was therefore unreachable in production while passing its own
    # assertions, because those called this function on raw source: a test that
    # exercised the mechanism and not the path. Reported 2026-08-29 by the
    # session that had asked for the fix and then re-ran it (docs/BACKLOG.md §57).
    #
    # So the stripping happens HERE, per branch, instead of at the caller: the
    # declaration and last-resort branches read code with strings and comments
    # removed, and the BDD branch reads the raw text while refusing a match on a
    # commented-out line — which keeps the anti-comment property the last-resort
    # branch was fixed for.
    stripped = code_only(text, python=python)
    m = re.search(r"\b" + re.escape(name) + r"\b\s*\([^)]*\)[^{;]*?\{", stripped, re.S)
    if m:
        i = m.end() - 1
        depth = 0
        for j in range(i, len(stripped)):
            if stripped[j] == "{":
                depth += 1
            elif stripped[j] == "}":
                depth -= 1
                if depth == 0:
                    return stripped[i:j + 1]
        return stripped[i:]
    # A BDD test is NAMED BY A STRING, not by an identifier: `it('name', …)`,
    # `test("name", …)`, `t.Run("name", …)`, `it 'name' do`. The declaration
    # matcher above wants `name(` and cannot see any of them, and the whole
    # JS/TS/Ruby/Go-subtest family is written this way. Reported 2026-08-29 by a
    # session whose entire Vitest corpus was told its tests did not exist
    # (docs/BACKLOG.md §57).
    bdd = re.search(
        r"""(?:\b(?:it|test|describe|context|specify|scenario)\s*\(|\bt\.Run\s*\()\s*"""
        r"""(['"`])""" + re.escape(name) + r"""\1\s*,""",
        text)
    if bdd and not commented_out(text, bdd.start()):
        brace = text.find("{", bdd.end())
        if brace != -1:
            depth = 0
            for j in range(brace, len(text)):
                if text[j] == "{":
                    depth += 1
                elif text[j] == "}":
                    depth -= 1
                    if depth == 0:
                        return text[brace:j + 1]
            return text[brace:]
    # Ruby and other `do`/`end` block forms, which have no brace to match.
    ruby = re.search(r"\b(?:it|specify|scenario|context|describe)\s+(['\"])"
                     + re.escape(name) + r"\1\s+do\b", text)
    if ruby and not commented_out(text, ruby.start()):
        tail = text[ruby.end():]
        stop = re.search(r"(?m)^\s*end\s*$", tail)
        return tail[:stop.end()] if stop else tail
    # LAST RESORT, and it must still be a DEFINITION. This previously accepted
    # any line mentioning the name and returned the rest of the file as its
    # "body", so a name appearing only in a COMMENT or a bare string satisfied
    # `check_tests_exist` — the check for a Tests table naming a test that is not
    # there could be satisfied by a note saying it is planned. Measured
    # 2026-08-29 on this gate (docs/BACKLOG.md §57).
    m = re.search(r"(?m)^[^\n]*\b(?:def|func|fn|class|sub|method|proc)\b[^\n]*\b"
                  + re.escape(name) + r"\b", stripped)
    if not m:
        return None
    start = m.end()
    nxt = re.search(r"(?m)^(def |func |fn |class |    def )", stripped[start:])
    return stripped[start:start + nxt.start()] if nxt else stripped[start:]


def code_only(text, python=False):
    """Drop line comments, block comments and string literals.

    A reviewer pointed out that the failure-call search matched the word `expect`
    inside a comment, so a test whose body is one sentence of prose passed as
    though it asserted something. Stripping first is cheap and removes the whole
    class — a failure call must be CODE.
    """
    if python:
        # D2 fix. Python has NO backtick string literal, and its docstrings use
        # backticks freely - 417 in one real file measured 2026-08-24. Applying
        # the JS template-literal rule here paired them across docstring
        # boundaries and deleted 75% of the file, `def` lines included, so every
        # test-existence and can-fail check reported correct tests as missing.
        # Strip triple-quoted docstrings, which the single-line rules below
        # cannot match, then `#` comments and single-line strings. No backticks.
        text = re.sub(r'"""(?:.|\n)*?"""', '""', text)
        text = re.sub(r"'''(?:.|\n)*?'''", "''", text)
        text = re.sub(r"(?m)#.*$", " ", text)
        text = re.sub(r'"(?:[^"\\\n]|\\.)*"', '""', text)
        text = re.sub(r"'(?:[^'\\\n]|\\.)*'", "''", text)
        return text
    text = re.sub(r"/\*.*?\*/", " ", text, flags=re.S)
    text = re.sub(r"(?m)(^|[^:])//.*$", r"\1 ", text)
    text = re.sub(r"(?m)#.*$", " ", text)
    text = re.sub(r'"(?:[^"\\\n]|\\.)*"', '""', text)
    text = re.sub(r"'(?:[^'\\\n]|\\.)*'", "''", text)
    text = re.sub(r"`(?:[^`])*`", "``", text)
    return text


def check_tests_can_fail(infos, readme_text, errors, root):
    """A test named by a `done` task must contain a failure path.

    Measured 2026-08-21: the existence check passes on a function that asserts
    nothing, which is the same green as a test that proves the task. A test with
    no t.Error/t.Fatal/assert in its body cannot go red for any input, so it is
    evidence of nothing and it looks identical to evidence of everything.

    Deliberately shallow, and the claim is scoped to match: it asks whether a
    failure call is REACHABLE from the body — not whether the assertion is right,
    and not whether the test fails when its subject breaks. Only a compiling
    mutant proves the latter, which is why the task template asks for one
    separately. `if false { t.Fatal(...) }` passes this check and should: judging
    reachability under a constant condition is a different tool.
    """
    if not readme_text or root is None:
        return
    for tid in evidenced_task_ids(infos, readme_text):
        inf = infos.get(tid)
        if inf is None or inf.get("human"):
            continue
        for name, rel in inf.get("tests", []):
            if not re.match(r"^[A-Za-z_][\w:.\-]*$", name):
                continue
            f = resolve_test_file(root, rel)
            if f is None or f.is_dir():
                continue  # check_tests_exist already reported both cases
            # RAW for the languages that name a test with a STRING, stripped for
            # Python. Pre-stripping deletes a BDD test's name, so this check
            # silently skipped every JS/TS test it was asked about — `continue`
            # on a None body reports nothing, so the skip was invisible
            # (docs/BACKLOG.md §57). Python is the exception in both directions:
            # its tests are named by `def`, which survives stripping, and its
            # bodies carry DOCSTRINGS that must be removed before an `assert` in
            # one can be mistaken for an assertion the test makes.
            raw = f.read_text(errors="replace", encoding="utf-8")
            text = code_only(raw, python=True) if f.suffix == ".py" else raw
            body = test_body(text, name, python=f.suffix == ".py")
            if body is None:
                continue
            # A no-op on the text above, which was already stripped; kept because
            # test_body slices out of it and a future extractor might not.
            body = code_only(body, python=f.suffix == ".py")
            # A test that delegates its assertions to a helper still fails when the
            # helper does. Follow one level: any same-file function the body calls
            # that takes the testing handle counts as part of it.
            if not FAIL_CALLS.search(body):
                for callee in set(re.findall(r"\b([a-z_]\w{2,})\s*\(", body)):
                    h = test_body(text, callee, python=f.suffix == ".py")
                    if h and FAIL_CALLS.search(h):
                        body += h
                        break
            if not FAIL_CALLS.search(body):
                errors.append(f"{inf['path'].name}: {tid} is marked done and names `{name}`, but "
                              f"no failure call is reachable in its body or in a same-file helper "
                              f"it hands the test handle to — nothing in it can go red")


def selected_by_filter(acc, name, rel=None):
    """Would the Acceptance command's filter run this test?

    The filter is matched the way the RUNNER matches it, not literally: `go test
    -run "TestLexNorm|TestRankRRF"` takes an unanchored regex, so a prefix selects
    every test beginning with it. A literal comparison flags all of them and the
    gate becomes noise — and a gate with false alarms is one people learn to skip,
    which costs more than the hole it closed.

    The same reason forces the CLASS into the comparison. PHPUnit and JUnit match
    `--filter` against the qualified name `Class::method`, so the overwhelmingly
    common `--filter='SomeTest'` selects every method in that class. Matching the
    pattern against the bare method name reported all of them as unrun — measured
    2026-08-21 on a 13-task ADR where every task uses a class filter and every row
    was flagged, which is precisely the false-alarm mode this function exists to
    avoid. The class comes from the Tests table's own file column.

    Unknown runners fall back to "selected", because guessing another tool's
    matching rules and being wrong is worse than not asking.
    """
    def unwrap(pat):
        """PHPUnit and PHPStan take a DELIMITED regex — `--filter='/(a|b)$/'`.

        Compiled as-is, the leading slash is a literal and the pattern matches
        nothing, so every test named by such a fence was reported as unrun
        (measured 2026-08-21). Strip a matched delimiter pair plus trailing flags;
        leave anything else alone.
        """
        m = re.match(r"^([/#~%])(.*)\1([imsxuUAD]*)$", pat, re.S)
        return m.group(2) if m else pat

    candidates = [name]
    if rel:
        stem = re.sub(r"\.[A-Za-z0-9]+$", "", str(rel).replace("\\", "/").rsplit("/", 1)[-1])
        if stem and stem != name:
            candidates.append(f"{stem}::{name}")
    # \Q…\E is valid in Go's regexp and invalid in Python's; translate rather
    # than fall through to "selected", which would pass every row.
    acc = re.sub(r"\\Q(.*?)\\E", lambda m: re.escape(m.group(1)), acc)
    for m in re.finditer(r"(-run|--filter|-k|--test|--name)[= ]+([\"\'])(.+?)\2", acc):
        pat = unwrap(m.group(3))
        try:
            if any(re.search(pat, c) for c in candidates):
                return True
        except re.error:
            return True  # an unparseable pattern is not evidence of exclusion
        # pytest's -k is a boolean expression over substrings, not a regex.
        if m.group(1) == "-k" and any(tok and any(tok in c for c in candidates)
                                      for tok in re.split(r"\s+(?:and|or|not)\s+|[()]", pat)):
            return True
    for m in re.finditer(r"(-run|--filter|-k|--test|--name)[= ]+([^\s\'\"]+)", acc):
        try:
            if any(re.search(unwrap(m.group(2)), c) for c in candidates):
                return True
        except re.error:
            return True
    return False


def check_named_tests_are_run(infos, readme_text, errors):
    """A test the Tests table names must be SELECTED by the Acceptance command.

    Measured 2026-08-21: a task listed six tests and its Acceptance filter named
    three, two of which did not exist. Four real tests sat outside the fence. The
    phantoms kept it red by accident — had the fence named only the two real ones,
    it would have gone green with four of the task's six promises never run. A
    table row nothing executes is a claim, not a test.

    A fence with no narrowing flag runs everything and satisfies this trivially,
    which is correct rather than a loophole.
    """
    if not readme_text:
        return
    # Only flags selected_by_filter can actually PARSE count as narrowing. `-k`
    # was in this list and not in the parser, so every pytest fence reported every
    # named test as unrun — a false alarm on a runner this repo does not even use,
    # which is exactly how a shared gate gets disabled in someone else's project.
    narrowing = re.compile(r"(-run|--filter|-k|--test|--name)\b")
    for tid in done_task_ids(readme_text):
        inf = infos.get(tid)
        if inf is None or inf.get("human"):
            continue
        acc = inf.get("acc_all") or inf.get("acc_first") or ""
        if not acc or not narrowing.search(acc):
            continue
        for name, rel in inf.get("tests", []):
            if not re.match(r"^[A-Za-z_][\w:.\-]*$", name):
                continue
            if not selected_by_filter(acc, name, rel):
                errors.append(f"{inf['path'].name}: {tid} names `{name}` in its Tests table, but "
                              f"the Acceptance command's filter does not select it — the row "
                              f"promises a test the gate never runs")


def check_readme(readme, task_stems, errors):
    text = readme.read_text(errors="replace", encoding="utf-8")
    listed = set()
    for ln in text.splitlines():
        if ln.strip().startswith("|"):
            listed |= set(re.findall(r"(?<!\w)T\d+(?!\w)", ln))
    for tid in listed:
        if not any(id_matches(tid, s) for s in task_stems):
            errors.append(f"README.md: lists '{tid}' but no task file matches it "
                          f"(task files are the source of truth)")
    for stem in task_stems:
        if not any(id_matches(tid, stem) for tid in listed) and \
           stem.lower() not in text.lower():
            errors.advise(f"README.md: task file '{stem}.md' not listed in the index")
    if len(task_stems) > 5 and "| Wave |" not in text:
        errors.advise(f"README.md: {len(task_stems)} tasks (>5) requires a wave table")


def reject_unknown_flags(known=()):
    """A flag this gate does not know is a typo, and a gate that ignores one
    answers a question nobody asked.

    Measured 2026-08-26: `adr-next tasks --jsonn` printed the human report and
    exited 0. lifecycle.mjs asks for `--json` and JSON.parse()s the result inside
    a try/catch that continues on failure, so a renamed or mistyped flag would
    have made session orientation silently empty at exit 0 — the same fail-open,
    by a different route, as the `#!` spawn that BACKLOG item 17 fixed.
    """
    unknown = [a for a in sys.argv[1:] if a.startswith("--") and a not in known]
    if unknown:
        print(f"unknown option: {unknown[0]}", file=sys.stderr)
        sys.exit(1)


class Findings(list):
    """Findings that block, and a second channel for the ones that should not.

    `.append` is what every check already calls and still means "this blocks":
    the record CLAIMS something it has not established, or it contradicts itself
    in a way that makes it unusable. An unfilled TEMPLATE PLACEHOLDER belongs
    here too, and finding that out cost a test: moved to advice, the bundled
    adr-template.md passed adr-lint outright. A placeholder is not a shape
    problem — it is a document presenting as a decision while containing none. `.advise` is the new channel — SHAPE. A
    missing section, an unfilled placeholder, a table with no rows: the record is
    still readable, nothing has been fabricated, and refusing the work over it
    teaches people to route around the gate.

    The line is between form and content, not between big and small. A section
    that is ABSENT is form. A section that is present and EMPTY is content: an
    ADR whose Alternatives Considered has no entries considered no alternatives,
    whatever its shape.

    The distinction is the one this gate could not previously make. Across the
    five record gates there are 112 distinct failure messages and not one said
    whether it broke the guarantee or merely the template, so a missing
    `## Consequences` stopped work exactly as hard as a `done` status with no
    evidence behind it. Raised by the user on 2026-08-26 after four refusals of
    legitimate work in a single session.
    """

    def __init__(self):
        super().__init__()
        self.advice = []
        # Why this record's content findings are advisory, or None when they block.
        # Set from `strictFrom` in .quality-harness.json: a corpus that adopts these
        # gates late would otherwise light up on every record written before the
        # decision to adopt them, and a gate that fails on day one over history
        # nobody is changing is a gate people turn off. Graduated strictness is
        # adr-kit's idea (rvdbreemen/adr-kit, MIT).
        self.demotion = None
        self._protected = 0

    def advise(self, message):
        self.advice.append(message)

    def append(self, message, evidence=False):
        # `evidence=True` and everything inside `protected()` are the checks
        # strictFrom must never reach: a task marked done with nothing behind it,
        # a Verification Log that does not match what adr-verify writes, a mutant
        # nobody killed. Those are not template conformance — they are the claim
        # the corpus exists to make, and demoting them on an old record would let
        # it assert `done` forever with no run behind it. Everything else is a
        # record's shape and content, which history is allowed to be imperfect at.
        if self.demotion and not evidence and not self._protected:
            self.advise(f"{message} [advisory: {self.demotion}]")
            return
        super().append(message)

    @contextmanager
    def protected(self):
        """Findings raised in here are never demoted, whatever strictFrom says."""
        self._protected += 1
        try:
            yield
        finally:
            self._protected -= 1


# `{"strictFrom": "ADR-0012"}` — records numbered below the cutoff report their
# content findings as advice. Absent or unreadable, nothing changes: this can only
# ever loosen a verdict a project asked to loosen, and never on its own.
CONFIG_NAME = ".quality-harness.json"


def strict_from_number(start, errors):
    """The ADR number at which content findings start blocking, or None."""
    root = git_root(start)
    if root is None:
        return None
    config = root / CONFIG_NAME
    if not config.exists():
        return None
    try:
        declared = json.loads(config.read_text(encoding="utf-8", errors="replace")).get("strictFrom")
    except Exception as exc:
        # Never silently. A config this tool cannot read must not quietly become
        # either stricter or looser than the project asked for.
        errors.advise(f"{CONFIG_NAME} could not be read ({exc.__class__.__name__}); "
                      f"strictFrom is not in effect and every record is checked in full")
        return None
    if declared is None:
        return None
    match = re.search(r"(\d+)", str(declared))
    if not match:
        errors.advise(f"{CONFIG_NAME}: strictFrom={declared!r} names no ADR number; "
                      f"write it as `ADR-0012` or `12`. Every record is checked in full.")
        return None
    return int(match.group(1))


def adr_number(path, text):
    """ADR-014, 014-thing.md, `# ADR-14: ...` — the number, however it is spelled."""
    title = re.search(r"^#\s+ADR[-_ ]?(\d{1,4})\b", text, re.M | re.I)
    if title:
        return int(title.group(1))
    name = re.search(r"(?:adr[-_]?)?(\d{3,4})[-._]", path.name, re.I)
    return int(name.group(1)) if name else None


def main():
    reject_unknown_flags()
    if len(sys.argv) < 2:
        print(__doc__)
        sys.exit(1)
    adr = Path(sys.argv[1])
    if not adr.exists():
        print(f"ADR not found: {adr}")
        sys.exit(1)
    # A DIRECTORY is the first thing anyone types — `adr-lint docs/adr`, or the
    # record's own `ADR-002/` sitting beside `ADR-002.md`. It used to reach
    # `read_text` and raise IsADirectoryError with a full traceback, which is a
    # crash where a sentence belongs: a usage error is not a defect in the corpus
    # and must not look like one. Reported 2026-08-29 by two sessions
    # independently (docs/BACKLOG.md §56, §57).
    if adr.is_dir():
        # The record is the directory's SIBLING, and its filename usually carries
        # a slug the directory does not repeat — `ADR-002/` beside
        # `ADR-002-carrier-registry-single-availability-source.md`. Matching on
        # the stem alone reported a dead end for the commonest layout there is;
        # the number is what ties them together, as it does in `adr-next`.
        # Reported 2026-08-29 after the first version of this message shipped.
        sibling = adr.with_suffix(".md")
        if not sibling.exists():
            # NOT the year of an ISO date: every `2026-07-12-thing.md` would
            # otherwise report number 2026 and any two of them would "share" it
            # (docs/BACKLOG.md §66).
            mine = re.match(r"(?!\d{4}-\d{2}-\d{2})(?:adr[-_]?)?0*(\d{1,4})\b", adr.name, re.I)
            if mine:
                for candidate in sorted(adr.parent.glob("*.md")):
                    theirs = re.match(r"(?!\d{4}-\d{2}-\d{2})(?:adr[-_]?)?0*(\d{1,4})\b",
                                      candidate.name, re.I)
                    if theirs and int(theirs.group(1)) == int(mine.group(1)):
                        sibling = candidate
                        break
        records = sorted(str(f) for f in adr.glob("*.md") if f.name.lower() != "readme.md")
        print(f"expected a record FILE, got a directory: {adr}")
        if sibling.exists():
            print(f"  the record for this directory is {sibling} — lint that, and this "
                  f"directory's tasks are found beside it")
        elif records:
            print("  this directory holds records; lint one of them:")
            for found in records[:5]:
                print(f"    {found}")
            if len(records) > 5:
                print(f"    (+{len(records) - 5} more)")
        else:
            print("  and it holds no .md record to lint")
        print("  there is no whole-corpus mode; `adr-debt <corpus-dir>` is the tool that "
              "reads a directory")
        sys.exit(1)
    errors = Findings()
    # Before any check runs, so every finding this record produces is judged the
    # same way. A record at or above the cutoff, or a corpus that declares none,
    # is checked exactly as it was before this existed.
    cutoff = strict_from_number(adr.parent, errors)
    if cutoff is not None:
        number = adr_number(adr, adr.read_text(errors="replace", encoding="utf-8"))
        if number is None:
            errors.advise(f"strictFrom is ADR-{cutoff:04d} but this record's number could not be "
                          f"read from its filename or title, so it is checked in full")
        elif number < cutoff:
            errors.demotion = (f"ADR-{number:04d} predates strictFrom ADR-{cutoff:04d}; "
                               f"evidence checks still block")
    spec_file = check_adr(adr, errors)

    if len(sys.argv) > 2:
        tasks_dir = Path(sys.argv[2])
        if not tasks_dir.is_dir():
            print(f"tasks dir not found: {tasks_dir}")
            sys.exit(1)
    else:
        tasks_dir = None
        candidates = [adr.parent / "tasks", adr.with_suffix("") / "tasks"]
        m = re.match(r"(ADR-\d+)", adr.stem)
        if m:
            candidates.append(adr.parent / m.group(1) / "tasks")
        for cand in candidates:
            if cand.is_dir():
                tasks_dir = cand
                break

    all_covers = set()
    if tasks_dir is None:
        # An ADR with no tasks directory gets ADR-level checks only, so anything
        # it calls `done` inside its own body is outside the evidence contract
        # entirely: adr-verify appends its Verification Log to a TASK FILE, and
        # done_task_ids reads an index that is not there. Measured 2026-08-26 —
        # three inline tasks all marked done, no evidence anywhere, exit 0.
        #
        # Advice rather than a failure: the record is not lying about anything
        # this gate can see, and refusing an ADR for its layout is the behaviour
        # that teaches people to stop running the gate. But saying nothing is how
        # the hole stayed open, and skills/adr-write no longer recommends it.
        body = adr.read_text(errors="replace", encoding="utf-8")
        inline_done = [ln.strip() for ln in body.splitlines()
                       if re.search(r"(?<!\w)T\d+(?!\w)", ln) and re.search(r"\bdone\b", ln, re.I)]
        if inline_done:
            errors.advise(
                f"{adr.name}: {len(inline_done)} inline task(s) marked done, and no tasks/ "
                f"directory — nothing here can carry tool-written evidence, so adr-verify has "
                f"nowhere to write and adr-lint cannot check the claim. Move them to task files.")
    if tasks_dir:
        task_files = sorted(p for p in tasks_dir.glob("*.md") if p.name != "README.md")
        stems = [p.stem for p in task_files]
        if not task_files:
            errors.append(f"{tasks_dir}: no task files")
        check_reachability_consistency(task_files, errors)
        infos = {}
        for p in task_files:
            covers, info = check_task(p, stems, errors)
            all_covers |= covers
            m = re.match(r"(T\d+)(?!\d)", p.stem, re.I)
            if m:
                infos[m.group(1).upper()] = info
        readme = tasks_dir / "README.md"
        readme_text = None
        if readme.exists():
            readme_text = readme.read_text(errors="replace", encoding="utf-8")
            check_readme(readme, stems, errors)
        else:
            errors.advise(f"{tasks_dir}: no README.md index")
        check_dag(infos, readme_text, errors)
        # The evidence chain, and the only checks strictFrom cannot reach. Held
        # here rather than tagged at each call site so the exclusion is visible
        # in one place and a new check inside these functions inherits it.
        with errors.protected():
            check_verification(infos, readme_text, errors)
            check_task_status_vocabulary(infos, readme_text, errors)
            check_status_allows_execution(adr, readme_text, errors)
            check_tests_exist(infos, readme_text, errors, git_root(tasks_dir))
            check_tests_can_fail(infos, readme_text, errors, git_root(tasks_dir))
            check_mutation_evidence(infos, readme_text, errors)
            check_named_tests_are_run(infos, readme_text, errors)
        check_file_collisions(infos, errors)
        check_contract_table(adr, stems, errors)

    # Deliberately OUTSIDE `protected()` and outside the tasks branch: it applies
    # to every record whether or not it has tasks, and it is advice — a pointer
    # to nothing is worth saying and is never worth blocking a record over.
    check_enforcement(adr.read_text(errors="replace", encoding="utf-8"), adr, errors,
                      git_root(adr.parent))
    check_pointers(adr.read_text(errors="replace", encoding="utf-8"), adr, errors,
                   git_root(adr.parent), adr.parent)
    check_cross_record_cycles(adr.parent, errors)

    if spec_file is not None:
        # inline-task ADRs carry **Covers:** lines in the ADR body itself
        adr_text = adr.read_text(errors="replace", encoding="utf-8")
        inline = " ".join(re.findall(r"^\*\*Covers:\*\*\s*(.+)$", adr_text, re.M))
        all_covers |= set(re.findall(r"(F-\d+|UC\d+-S\d+)", inline))
        uncovered = spec_ids(spec_file) - all_covers
        if uncovered:
            errors.append(f"spec coverage: no task Covers these @spec/@implemented IDs: "
                          f"{', '.join(sorted(uncovered))} — uncovered facts block Accepted")

    status = "PASS" if not errors else "FAIL"
    if errors.demotion:
        print(f"[strictFrom] {errors.demotion}")
    print(f"[{status}] {adr}" + (f" + {tasks_dir}" if tasks_dir else " (no tasks dir — ADR-level checks only)"))
    for e in errors:
        print(f"  {e}")
    # Advice is printed on a PASS too: a record that is acceptable and a record
    # that is finished are different things, and the reader deserves both.
    for a in errors.advice:
        print(f"  advice: {a}")
    sys.exit(1 if errors else 0)


if __name__ == "__main__":
    main()
