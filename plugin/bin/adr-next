#!/usr/bin/env python3
"""adr-next — say which task is ready to execute, and what proves it done.

Usage: adr-next <ADR.md | tasks-dir> [--all] [--json]

Answers one question the corpus can already answer but nothing surfaces: given
the task files as written, which task may be started RIGHT NOW, and what is its
Acceptance command? Readiness is computed from the task files themselves —
`Depends-on` plus the `Consumes`/`Produces` contract edges, the same edges
adr-lint builds its DAG from — never from `tasks/README.md`, which is a derived
index that can disagree with the files it indexes.

A task is DONE when its Verification Log holds an exit-0 tool-written entry
whose acceptance-sha256 matches its current Acceptance fence — the same
evidence rule adr-lint enforces for a README `done` status, so a hand-typed
"done" cannot make a task disappear from this list. A task is READY when every
task it depends on is DONE.

  --all   list every task with its state (done / ready / blocked-by / stopped)
  --json  machine-readable, for a hook or a skill rather than a person

A task is STOPPED when its human sign-off states a stop. That is neither done nor
ready nor waiting on an upstream — a person looked at this task and said do not
proceed — so it is its own state, reported with the sign-off text. Calling it
`ready` offered work the record forbids starting; calling it `blocked` would send
the reader hunting for an upstream that does not exist.

Exit: 0 = a ready task was printed (or --all rendered)
      3 = nothing ready: everything is done, or the rest is blocked or stopped
      1 = the ADR or tasks directory could not be read

`--version` prints this gate's name, the version read from the manifest beside
IT, and that root. Ask the gate whose output you are questioning rather than a
resolver: `qh-root` and `qh-doctor` answer which copy is newest on the machine,
which on a box carrying both PATH mechanisms can be a different install from the
one that just ran (ADR-031).
"""
import hashlib
import json
import re
import sys
from pathlib import Path

import sys as _sys
for _s in (_sys.stdout, _sys.stderr):
    try:
        _s.reconfigure(encoding="utf-8", errors="replace")
    except Exception:
        pass

TID_RE = re.compile(r"(?<!\w)T\d+(?!\w)")
VLOG_DIGEST_RE = re.compile(
    r"^- \d{4}-\d{2}-\d{2} · (?:[0-9a-f]{7,40}\*?|no-git) · exit (?P<exit>\d+) · "
    # ADR-020 appends an optional ` · ms:<integer>`. THREE gates read this grammar
    # and tests/gate-regressions.py asserts they agree, because a third drifting is
    # what makes this tool call a verified task unverified and hand a session work
    # that is already finished.
    r"`(?P<command>[^`]+)` · acceptance-sha256:(?P<digest>[0-9a-f]{64})(?: · ms:\d+)?"
    # ADR-028 T1: the steps a run exercised. FOUR gates read this grammar now.
    r"(?: · steps:S[1-9]\d*(?:,S[1-9]\d*)*)?$")
VLOG_HUMAN_RE = re.compile(r"^- \d{4}-\d{2}-\d{2} · human-observed · (?P<note>.+)$")
# An entry written before acceptance digests existed. `adr-lint` has always
# accepted these under a narrow allowance its own help text documents, and
# `work-next` honours them too; this reader accepted only digest rows, so one
# corpus answered two ways depending on which tool you asked. Measured on three
# independent corpora, most precisely at 40/40 correlation with the digest
# cutover date, with the honest alternative (an Acceptance edited after its
# evidence) ruled out by git log (docs/BACKLOG.md §58).
VLOG_LEGACY_RE = re.compile(
    r"^- \d{4}-\d{2}-\d{2} · (?:[0-9a-f]{7,40}\*?|no-git) · exit (?P<exit>\d+) · "
    r"`(?P<command>[^`]+)`$")

# A human sign-off is the ONE route with no exit code and no fence digest, so the
# only thing standing between its text and a `done` is how that text is read. It
# used to be read as `.+` — any text at all, including text saying the opposite.
#
# Reported 2026-08-28: a task whose only sign-off was "decision BLOCKED — neither
# ship nor withdraw" was printed done, and the task it gated printed READY. The
# reader was one step from executing the sequence that sign-off forbade.
#
# So an affirmative outcome has to be STATED. Anything else — a stop, a refusal,
# or a note this cannot classify — is NOT done, which is ADR-006's rule in the
# one place the corpus had no verdict at all: a claim that was never observed is
# not evidence, and the safe direction is to withhold `done` rather than grant it.
AFFIRMATIVE = re.compile(r"(?<![a-z])(pass(?:ed|es)?|confirm(?:ed|s)?|observed|"
                         r"verified|signed[- ]off|approved|ship(?:ped)?|done|ok)(?![a-z])", re.I)
# ⚠ `block` IS MATCHED AS A VERB ONLY, and the missing inflections are here for
# the same reason. Found 2026-09-04 on this repository's own ADR-012 T4: an
# affirmative sign-off reported that the client rendered "no server-level block"
# — a chunk of text — and `block(?:ed)?` read the noun as the verdict "blocked",
# so a done task printed READY forever and the record's README and this reader
# disagreed. Honest observation prose is full of nouns; a verdict is a verb.
#
# The same look found the opposite hole. `block(?:ed)?` with the `(?![a-z])`
# lookahead matches neither `blocks` nor `blocking`, so "the rollout blocks on
# legal" was counted as DONE — the exact failure this guard exists to prevent,
# reachable through every entry that lacked an `-s`/`-ing` form. Both directions
# are asserted in tests/adr-next.test.mjs, one test each, because a change that
# only narrowed would be indistinguishable from deleting the word.
NEGATIVE = re.compile(r"(?<![a-z])(block(?:ed|s|ing)|stop(?:ped|s|ping)?|"
                      r"fail(?:ed|s|ing)?|refus(?:e|ed|es|ing)?|"
                      r"withdraw(?:n|s|ing)?|reject(?:ed|s|ing)?|not |never |cannot|"
                      r"abort(?:ed|s|ing)?)(?![a-z])", re.I)


# A record NUMBER from a filename, and NOT the year of an ISO date. Every
# `2026-07-12-thing.md` in a date-named corpus otherwise reports number 2026, so
# any two of them "share" it: `adr-next <record with no tasks dir>` matched a
# FOREIGN record's directory and answered with its tasks, confidently and with
# that record's adr-verify command. Reported 2026-08-29 against the sibling
# matching added the same day (docs/BACKLOG.md §66). `lifecycle.mjs::adrNumber`
# already carried this lookahead for the same reason, measured 2026-08-26 — the
# rule existed and this copy did not have it, which is what a third spelling of
# one rule costs.
RECORD_NUMBER = re.compile(r"(?!\d{4}-\d{2}-\d{2})(?:adr[-_]?)?0*(\d{1,4})\b", re.I)


def human_outcome(note):
    """"stop", "pass", or None when the note states neither.

    A NEGATIVE word anywhere wins over an affirmative one: "confirmed BLOCKED"
    and "passed, but stop" both mean stop, and reading the first word only is how
    a sign-off gets skimmed into the opposite of what it says.

    An UNCLASSIFIABLE note is None and still counts as done, which is the
    deliberate half. "Zy read it end to end" states no outcome and is a perfectly
    good sign-off; a person looked, wrote a note, and the tool's inability to
    parse English is not the same as nothing having been observed. Refusing every
    note without a keyword would make the one human route unusable, and an
    unusable gate is one people route around.

    The harm reported 2026-08-28 was narrower and sharper than that: a note that
    said the OPPOSITE of done was read as done. That is what this refuses.
    """
    if NEGATIVE.search(note):
        return "stop"
    if AFFIRMATIVE.search(note):
        return "pass"
    return None


def header_val(text, name):
    m = re.search(rf"^\*\*{re.escape(name)}:\*\*\s*(.+)$", text, re.M)
    return m.group(1).strip() if m else None


def sections(text):
    out, current = {}, None
    for line in text.split("\n"):
        m = re.match(r"^##\s+(.+?)\s*$", line)
        if m:
            current = m.group(1)
            out.setdefault(current, [])
            continue
        if current is not None:
            out[current].append(line)
    return out


def normalize_acceptance(raw):
    """Canonical Acceptance text — must stay identical to adr-lint/adr-verify.

    A digest computed differently here would silently disagree with the evidence
    those tools write, and this list would call verified tasks unverified.
    """
    lines = raw.replace("\r\n", "\n").replace("\r", "\n").split("\n")
    start, end = 0, len(lines)
    while start < end and not lines[start].strip():
        start += 1
    while end > start and not lines[end - 1].strip():
        end -= 1
    return "\n".join(lines[start:end])


def acceptance(text):
    """The task's Acceptance fence body, its first command line, and its digest."""
    body = "\n".join(sections(text).get("Acceptance", []))
    m = re.search(r"```bash\n(.*?)```", body, re.S)
    if not m:
        human = "Acceptance is human-observed:" in body
        return None, ("human-observed" if human else None), None
    fence = normalize_acceptance(m.group(1))
    # adr-verify's evidence entry shows line 1 by design; a human wants the line
    # that actually runs something, so skip shell preamble when choosing a hint.
    preamble = re.compile(r"^(?:set\s+[-+][A-Za-z]+|cd\s+\S+|export\s+\S+=|#)")
    body = [ln.strip() for ln in fence.split("\n") if ln.strip()]
    first = next((ln for ln in body if not preamble.match(ln)), body[0] if body else "")
    digest = hashlib.sha256(fence.encode("utf-8")).hexdigest()
    return fence, first, digest


def is_done(text, digest, human, fence=None, first=None):
    """Tool-written evidence only: a typed 'done' is not evidence.

    THREE READERS, ONE GRAMMAR. `adr-lint` accepts a pre-digest row under a
    narrow allowance it documents in its own help; `work-next` honours the same
    shape; this reader took digest rows only. So a corpus whose evidence predates
    digests read as fully executed to two tools and as ENTIRELY UNSTARTED to this
    one — not "some tasks unverified", but every task ready or blocked behind the
    first, forever, with no way to clear it. Reported by three independent
    corpora on 2026-08-29 (docs/BACKLOG.md §58).

    The allowance is deliberately narrow and is copied here condition for
    condition rather than loosened: the fence must be SINGLE-LINE (a legacy row
    records only the displayed command, so it cannot prove a multi-line fence),
    the recorded command must not be the truncated ` …` form, and it must equal
    the fence's own first line with backticks written as quotes — which is
    exactly what `adr-verify` displays.

    A BACKFILL WAS THE ALTERNATIVE AND IT IS WORSE. Stamping a digest onto an
    August row means computing sha256 of TODAY's fence and asserting it is what
    ran then — manufacturing the provenance the digest exists to prove. One
    corpus checked five files by hand and found it true there; no tool can know
    it in general. Where the fences still pass, re-running `adr-verify` is the
    migration and it is self-healing; where they no longer pass, this allowance
    is the only reading that does not require a tool to assert what it cannot
    observe.
    """
    log = "\n".join(sections(text).get("Verification Log", []))
    want_legacy = None
    if fence is not None and first is not None and "\n" not in fence:
        want_legacy = first.replace("`", "'")
    for line in log.split("\n"):
        line = line.strip()
        if human and (m := VLOG_HUMAN_RE.match(line)):
            # Only an affirmative sign-off is evidence. A stop, or a note this
            # cannot classify, leaves the task not done — and `human_verdict`
            # below carries the reason so the report says which it was.
            if human_outcome(m.group("note")) != "stop":
                return True
        m = VLOG_DIGEST_RE.match(line)
        if m and m.group("exit") == "0" and digest and m.group("digest") == digest:
            return True
        if want_legacy is not None and (m := VLOG_LEGACY_RE.match(line)) \
                and m.group("exit") == "0" \
                and not m.group("command").rstrip().endswith(" …") \
                and m.group("command").strip() == want_legacy:
            return True
    return False


def human_stop(text):
    """The sign-off note that says STOP, or None when none does.

    Deliberately re-reads the log rather than having `is_done` return two things:
    `is_done` answers one question and is called from three places, and widening
    its return to carry a reason is how a second caller starts branching on a
    tuple it does not need. The log is short and already in memory.
    """
    log = "\n".join(sections(text).get("Verification Log", []))
    for line in log.split("\n"):
        if (m := VLOG_HUMAN_RE.match(line.strip())) and human_outcome(m.group("note")) == "stop":
            return m.group("note")
    return None

def load(tasks_dir):
    infos = {}
    for path in sorted(tasks_dir.glob("*.md")):
        if path.name.lower() == "readme.md":
            continue
        text = path.read_text(encoding="utf-8", errors="replace")
        m = re.match(r"^#\s+(?:Task\s+)?\S*?(T\d+)\b", text) or TID_RE.search(path.name)
        if not m:
            continue
        tid = m.group(1).upper()
        fence, first, digest = acceptance(text)
        human = first == "human-observed"
        infos[tid] = {
            "id": tid,
            "path": str(path),
            "goal": (re.sub(r"^#\s+", "", text.split("\n", 1)[0]).strip() if text else tid),
            "depends_on": header_val(text, "Depends-on") or "",
            "consumes": header_val(text, "Consumes") or "",
            "produces": header_val(text, "Produces") or "",
            "acceptance": None if human else first,
            "human_observed": human,
            "done": is_done(text, digest, human, fence, first),
            # ADR-005 applied to routing. A sign-off that says STOP denies `done`
            # and used to fall straight through to `ready`, so the router offered
            # work the record forbids starting. Reported 2026-09-02 from another
            # corpus; reproduced hermetically 2026-09-04. `is_done`'s comment
            # claimed "`human_verdict` below carries the reason" and NO SUCH NAME
            # EXISTED — the comment described a mechanism nobody wrote.
            "stopped_by": human_stop(text) if human else None,
        }
    return infos


QUALIFIED_DEP = re.compile(r"^ADR[-\s]?0*(?P<number>\d{1,4})[-/](?P<task>T\d+)$", re.I)


def foreign_state(pointer, corpus_dir):
    """"done", "pending", or "unknown" for a task in another record.

    "unknown" is the state this tool did not have. A foreign id used to be
    DROPPED — filtered out because it was not in this record's own tasks — and an
    unseen edge reads as no edge, so the task printed READY. Reported 2026-08-28
    by a session one step from executing the sequence that dependency forbade.

    ADR-005's and ADR-006's rule in a third tool: readiness is an OBSERVATION,
    and an edge that could not be evaluated is not one. Withholding `ready` is
    the safe direction; granting it is what causes the work.
    """
    found = QUALIFIED_DEP.match(pointer)
    if not found or corpus_dir is None or not corpus_dir.is_dir():
        return "unknown"
    number, want = int(found.group("number")), found.group("task").upper()
    for candidate in sorted(corpus_dir.glob("ADR-*.md")):
        digits = re.match(r"ADR-0*(\d{1,4})", candidate.name, re.I)
        if not digits or int(digits.group(1)) != number:
            continue
        tasks = candidate.with_suffix("") / "tasks"
        if not tasks.is_dir():
            return "unknown"
        for f in sorted(tasks.glob("*.md")):
            if f.name.lower() == "readme.md":
                continue
            if TID_RE.search(f.stem.upper()) and TID_RE.search(f.stem.upper()).group(0) == want:
                text = f.read_text(encoding="utf-8", errors="replace")
                # The SAME reader `load` uses, so a foreign task is judged done
                # by exactly the evidence a local one needs — a matching fence
                # digest, or an affirmative human sign-off. A second definition
                # of "done" is how two tools come to disagree about one corpus.
                fence, first, digest = acceptance(text)
                return ("done" if is_done(text, digest, first == "human-observed",
                                          fence, first)
                        else "pending")
        return "unknown"
    return "unknown"


def blockers(infos, corpus_dir=None):
    """Ordering edges from Depends-on plus Consumes/Produces contract tokens.

    Same edge set as adr-lint's DAG, so readiness here cannot disagree with the
    ordering the split gate already enforced.

    A QUALIFIED id — `ADR-003-T4` — leaves this record, and is taken out whole
    BEFORE the local scan: TID_RE matches `T4` inside it, so left in, a foreign
    dependency binds to a same-numbered local task. A wrong edge is worse than a
    missing one, because the DAG then looks answered.
    """
    out = {tid: set() for tid in infos}
    foreign = {tid: [] for tid in infos}
    for tid, inf in infos.items():
        dep = inf["depends_on"]
        if dep and not dep.lower().startswith("none"):
            rest = []
            for part in (p.strip() for p in dep.split(",")):
                if not part:
                    continue
                if QUALIFIED_DEP.match(part):
                    note_foreign(part, corpus_dir, foreign, tid)
                elif re.search(r"(?<![A-Za-z])ADR(?![A-Za-z])", part, re.I):
                    # Names a record and does not parse. Left to the local scan
                    # it is worse than dropped: TID_RE finds the trailing `T1`
                    # inside `ADR-not-a-number-T1`, that resolves to the task
                    # itself, self-edges are excluded, and the task prints READY.
                    # A malformed pointer becoming a clean bill of health is the
                    # exact shape this record exists to remove. adr-lint rejects
                    # it at authoring; this refuses to route on it.
                    foreign[tid].append((part, "unknown"))
                else:
                    rest.append(part)
            for d in TID_RE.findall(" ".join(rest).upper()):
                if d in infos and d != tid:
                    out[tid].add(d)
        cons = inf["consumes"]
        if cons and not cons.lower().startswith("none"):
            # Qualified ids come out of Consumes for the same reason they come
            # out of Depends-on, and they were not: TID_RE finds `T4` inside
            # `ADR-003-T4`, so a task consuming a FOREIGN record's output printed
            # `waiting on T4` — a local sibling it has nothing to do with.
            # Reproduced 2026-08-29 (docs/BACKLOG.md §41). Recorded as foreign so
            # the edge is reported unevaluated rather than silently invented.
            for part in (p.strip() for p in cons.split(",")):
                if not part:
                    continue
                if QUALIFIED_DEP.match(part):
                    note_foreign(part, corpus_dir, foreign, tid)
                    continue
                for d in TID_RE.findall(part.upper()):
                    if d in infos and d != tid:
                        out[tid].add(d)
            tokens = {t.lower() for t in re.findall(r"`([^`]+)`", cons)} - {"none"}
            for other, oinf in infos.items():
                if other == tid:
                    continue
                produced = {t.lower() for t in re.findall(r"`([^`]+)`", oinf["produces"])}
                if tokens & produced:
                    out[tid].add(other)
    return out, foreign


def note_foreign(part, corpus_dir, foreign, tid):
    """Record a qualified cross-record pointer as an edge this tool cannot evaluate.

    Shared by `Depends-on` and `Consumes` rather than written twice. They are one
    rule — a foreign id is taken out WHOLE and reported, never scavenged for a
    local T-id — and two copies of that rule is precisely how `Consumes` came to
    be missing it (docs/BACKLOG.md §41). A second copy also silently duplicated
    this gate's mutation anchor, so the campaign stopped being able to say which
    branch it was killing.
    """
    state = foreign_state(part, corpus_dir)
    if state != "done":
        foreign[tid].append((part, state))


def resolve_tasks_dir(target):
    """The tasks directory a caller meant, from whatever they actually typed.

    Three shapes are all obvious first guesses and only one of them used to work:
    the tasks directory itself, the record's own folder beside it, and the record
    FILE. The second returned itself and then reported "no task files"; the third
    resolved only when the folder's name equalled the file's stem, which is false
    for `ADR-002-long-slug.md` beside `ADR-002/`. Reported 2026-08-29 by two
    sessions (docs/BACKLOG.md §57). A tool that knows what you meant and refuses
    to say so is a tool people stop typing.
    """
    if target.is_dir():
        # `ADR-002/` holding `tasks/` is the record's folder, not its tasks.
        nested = target / "tasks"
        return nested if nested.is_dir() else target
    if not target.is_file():
        return None
    for candidate in (target.parent / "tasks", target.parent / target.stem / "tasks"):
        if candidate.is_dir():
            return candidate
    # A sibling folder that owns this record by NUMBER: the filename carries a
    # slug the folder does not have to repeat.
    owns = RECORD_NUMBER.match(target.stem)
    if owns:
        for sibling in sorted(target.parent.iterdir()):
            if not sibling.is_dir():
                continue
            theirs = RECORD_NUMBER.match(sibling.name)
            if theirs and int(theirs.group(1)) == int(owns.group(1)) \
                    and (sibling / "tasks").is_dir():
                return sibling / "tasks"
    return None


def reject_unknown_flags(known=()):
    """A flag this gate does not know is a typo, and a gate that ignores one
    answers a question nobody asked.

    Measured 2026-08-26: `adr-next tasks --jsonn` printed the human report and
    exited 0. lifecycle.mjs asks for `--json` and JSON.parse()s the result inside
    a try/catch that continues on failure, so a renamed or mistyped flag would
    have made session orientation silently empty at exit 0 — the same fail-open,
    by a different route, as the `#!` spawn that BACKLOG item 17 fixed.
    """
    unknown = [a for a in sys.argv[1:] if a.startswith("--") and a not in known]
    if unknown:
        print(f"unknown option: {unknown[0]}", file=sys.stderr)
        sys.exit(1)


def owning_record_status(tasks_dir, record_dir=None):
    """The Status of the record these tasks belong to, or None if it cannot be found.

    `work-next` joins every task to its record and refuses to call an undecided
    record's tasks ready (docs/BACKLOG.md §48). This tool never looked, so the
    same corpus answered two ways depending on which entry point you used — and
    THIS is the more exposed one: the router produces a session banner, while
    `adr-next <record>` is what somebody types when they already have a record in
    hand and have stopped asking whether it is decided. Reported 2026-08-29 from a
    corpus where it offered a Proposed record's tasks and handed over an
    `adr-verify` command to run against them (docs/BACKLOG.md §64).

    Returns the status verbatim, because the caller reports it rather than
    judging it: this gate instructs and never blocks (CLAUDE.md §3), so an
    undecided record still gets its answer, with the status said out loud.
    """
    # Resolved, because a RELATIVE `tasks` argument makes the parent `.`, whose
    # `with_suffix` raises "has an empty name" — a traceback out of a status
    # lookup, in the same shape this suite caught adr-lint producing on a
    # directory argument earlier today. Found by
    # tests/gate-rules.test.mjs::the machine-readable output lifecycle.mjs
    # depends on is machine-readable, which is the test that exists because a
    # crash on stdout is not machine-readable output.
    try:
        # `record_dir` wins when the caller has the LOGICAL path, because
        # `.resolve()` follows symlinks and a symlinked record's file sits beside
        # the LINK, not beside its target. Resolving sent the lookup to the wrong
        # directory, found nothing, and a Proposed record was reported as decided.
        # Codex, 2026-09-04. The resolve() below stays for the ordinary call: a
        # relative `tasks` argument makes the parent `.`, whose `with_suffix`
        # raises "has an empty name".
        record_dir = (record_dir.absolute() if record_dir is not None
                      else tasks_dir.resolve().parent)
    except OSError:
        return None
    if record_dir == record_dir.parent:      # filesystem root: no record can own it
        return None
    # Bounded: the sibling scan exists to find `ADR-002-long-slug.md` beside
    # `ADR-002/`, not to read an arbitrary directory of markdown. A corpus
    # directory holds tens of records; anything past a couple of hundred is not
    # a corpus and this question is not worth asking there.
    siblings = sorted(record_dir.parent.glob("*.md"))[:200]
    for candidate in (record_dir.with_suffix(".md"), *siblings):
        try:
            if not candidate.is_file():
                continue
        except OSError:
            continue
        if candidate.stem != record_dir.name:
            mine = RECORD_NUMBER.match(record_dir.name)
            theirs = RECORD_NUMBER.match(candidate.name)
            if not (mine and theirs and int(mine.group(1)) == int(theirs.group(1))):
                continue
        text = candidate.read_text(errors="replace", encoding="utf-8")
        found = re.search(r"^[ \t]*\*{0,2}Status:?\*{0,2}[ \t]*:?[ \t]*(.+)$", text, re.M | re.I)
        if found:
            return found.group(1).strip().strip("*").strip()
    return None


def classify(infos, corpus_dir):
    """Sort a record's tasks into ready / done / blocked / stopped.

    Extracted so the single-record path and the corpus path share ONE copy of the
    readiness rule. Two copies is exactly how `Consumes` came to be missing the
    foreign-pointer rule that `Depends-on` had (docs/BACKLOG.md §41), and a second
    copy of a rule this gate's whole answer rests on would be worse.
    """
    blocked_by, foreign = blockers(infos, corpus_dir)
    ready, done, blocked, stopped = [], [], [], []
    for tid in sorted(infos, key=lambda t: int(t[1:])):
        inf = infos[tid]
        if inf["done"]:
            done.append(inf)
            continue
        # A HUMAN STOP IS NOT A DEPENDENCY, and it is not readiness either. It is
        # checked before the dependency edges because it is a statement about THIS
        # task: a person looked and said do not proceed. Reporting it as `blocked`
        # would send the reader hunting for an upstream that does not exist.
        if inf["stopped_by"]:
            stopped.append(inf)
            continue
        open_deps = sorted(d for d in blocked_by[tid] if not infos[d]["done"])
        # A foreign dependency that is not done blocks, and one this could not
        # evaluate blocks too — saying which, because "blocked" and "I could not
        # tell" send a reader to different places.
        open_deps += [f"{pointer} (cannot evaluate)" if state == "unknown" else pointer
                      for pointer, state in foreign[tid]]
        if open_deps:
            blocked.append({**inf, "blocked_by": open_deps})
        else:
            ready.append(inf)
    return ready, done, blocked, stopped


def corpus_records(target):
    """The (name, tasks_dir) pairs a corpus root holds, sorted by name.

    A corpus root is not a shape this tool was taught; it is the shape a reader
    reaches for FIRST, because it is the one `adr-lint` and `adr-debt` already
    take. Before ADR-034 it arrived at the single-record path — `resolve_tasks_dir`
    returns a directory unchanged when it holds no `tasks/` child — and its
    emptiness was printed as the answer (GitHub issue #10).

    Resolution goes through `resolve_tasks_dir`, so every input shape that already
    works for one record keeps working one level down.

    Returns `(records, unreadable)`. The second half exists because a directory
    this tool CANNOT READ is not a directory holding nothing — folding the two
    together made a `chmod 000` record with a ready task come back as
    "1 record(s) with tasks, none ready", exit 3. That is a gate reporting an
    observation it did not make, which is ADR-005's rule, inside the code written
    to fix an ADR-005 violation. Found by a Codex review on 2026-09-04.

    A record folder that is READABLE and simply owns no tasks is absent from both
    lists, which is the ordinary case and not a finding.
    """
    if not target.is_dir():
        return [], []
    found, unreadable = [], []
    try:
        children = sorted(target.iterdir())
    except OSError as exc:
        # The corpus root itself could not be listed. Nothing below is knowable.
        return [], [(target.name, str(exc))]
    for child in children:
        # A record FILE resolves through its sibling folder, so listing both the
        # `.md` and the directory would report the same record twice. Directories
        # only; `resolve_tasks_dir` still does the work of finding `tasks/`.
        #
        # Dot-prefixed directories are skipped deliberately — `.git` is not a
        # record — and ADR-034 now says so rather than describing a detector it
        # does not implement.
        if child.name.startswith("."):
            continue
        try:
            if not child.is_dir():
                continue
            # An EXPLICIT listing, because `Path.glob` — which `load` uses —
            # swallows OSError and yields nothing. Without this the try/except
            # below never fires ON macOS and an unreadable record is
            # indistinguishable from an empty one. Measured on a `chmod 000`
            # record, 2026-09-04 — and measured AGAIN the same day when the
            # mutant that deletes this line survived on ubuntu: there,
            # `Path.is_dir()` inside `resolve_tasks_dir` raises EACCES itself
            # (pathlib ignores ENOENT/ENOTDIR, not EACCES), so this probe is
            # redundant on Linux and the only determinant on macOS. The
            # catalogue therefore mutates the `except` below, which is the one
            # change that breaks the mechanism on every platform.
            list(child.iterdir())
            tasks_dir = resolve_tasks_dir(child)
            if tasks_dir is None:
                continue
            if tasks_dir != child:
                list(tasks_dir.iterdir())
            infos = load(tasks_dir)
        except OSError as exc:
            unreadable.append((child.name, str(exc)))
            continue
        if infos:
            found.append((child.name, tasks_dir, child))
    return found, unreadable


def report_corpus(records, unreadable, flags):
    """Answer for a whole corpus, grouped by record.

    The exit code carries the SAME contract as the single-record path, because
    that is what callers branch on: 0 when something is ready, 3 when nothing is,
    1 when the tool could not answer. A corpus that is merely large must never
    read like a corpus that is done, and a corpus this tool could not fully READ
    must never read like either.
    """
    answers = {}
    any_ready = False
    for name, tasks_dir, record_dir in records:
        infos = load(tasks_dir)
        corpus_dir = tasks_dir.parent.parent if tasks_dir.parent.parent.is_dir() else None
        ready, done, blocked, stopped = classify(infos, corpus_dir)
        # The owning record's status travels with the answer. The single-record
        # path prints this and the corpus path did not, so a **Proposed** record's
        # task was offered as READY with no signal at all — CLAUDE.md §10 says a
        # record is a work order only once it is Accepted, and dropping that over
        # a 37-record corpus is worse than dropping it over one.
        #
        # Resolved from `record_dir`, the path as the CALLER reached it, not from
        # `tasks_dir`. A symlinked record resolves to its physical parent, where
        # the record file is not, so the status came back None and a Proposed
        # record was reported as decided. Codex, 2026-09-04.
        status = owning_record_status(tasks_dir, record_dir=record_dir)
        # THREE states, not two. `None` is "could not determine", and calling that
        # `undecided: false` tells a machine caller the record is Accepted when
        # nothing was read (ADR-005).
        undecided = None if status is None else bool(not re.match(r"accepted\b", status, re.I))
        answers[name] = {"tasks_dir": str(tasks_dir), "ready": ready, "done": done,
                         "blocked": blocked, "stopped": stopped,
                         "status": status, "undecided": undecided}
        if undecided and ready:
            print(f"adr-next: {name} is **{status}**, not Accepted — its task(s) below are a "
                  f"reading of its PLAN, not work anyone has decided to do.", file=sys.stderr)
        if undecided is None and ready:
            print(f"adr-next: {name}'s owning record could not be read, so whether it is "
                  f"Accepted is UNKNOWN — its task(s) below may not be a work order.",
                  file=sys.stderr)
        any_ready = any_ready or bool(ready)

    for name, why in unreadable:
        print(f"adr-next: COULD NOT READ {name} ({why}) — it is not counted as holding "
              f"nothing, because this tool did not look inside it.", file=sys.stderr)

    # "Nothing is ready" is a VERDICT and it is only available when everything was
    # read. With an unreadable record in the corpus the honest answer is 1 — "I
    # could not answer" — because the ready task may be in the directory this tool
    # was refused. A ready task found elsewhere still wins: 0 is a positive claim
    # about work that exists, and it stays true whatever the unread record holds.
    verdict = 0 if any_ready else (1 if unreadable else 3)

    if "--json" in flags:
        print(json.dumps({"records": answers,
                          "unreadable": [{"name": n, "why": w} for n, w in unreadable]},
                         indent=2))
        return verdict

    for name, answer in answers.items():
        for inf in answer["ready"]:
            print(f"{name}  READY    {inf['id']}  {inf['goal']}")
        if "--all" not in flags:
            continue
        for inf in answer["done"]:
            print(f"{name}  done     {inf['id']}  {inf['goal']}")
        for inf in answer["blocked"]:
            print(f"{name}  blocked  {inf['id']}  {inf['goal']}  "
                  f"(waiting on {', '.join(inf['blocked_by'])})")
        for inf in answer["stopped"]:
            print(f"{name}  stopped  {inf['id']}  {inf['goal']}  "
                  f"(a human sign-off says stop: {inf['stopped_by']})")

    total = sum(len(a["ready"]) for a in answers.values())
    unread = f", {len(unreadable)} unreadable" if unreadable else ""
    # Said on stdout when there IS work and on stderr when there is not, matching
    # the single-record path: the summary of an empty answer is a diagnostic.
    if any_ready:
        line = f"{len(records)} record(s) with tasks, {total} ready{unread}."
    elif unreadable:
        line = (f"{len(records)} record(s) with tasks, none ready{unread} — so whether "
                f"anything is ready is UNKNOWN, not no.")
    else:
        line = f"{len(records)} record(s) with tasks, none ready."
    print(line, file=sys.stdout if any_ready else sys.stderr)
    return verdict


# ADR-031. Every gate answers for ITSELF, and the answer is read from the
# manifest beside the gate rather than from a resolver. A central answer —
# `qh-root`, `qh-doctor`, a `qh-version` gate — reports whichever copy of
# ITSELF resolved, which on a machine carrying both PATH mechanisms
# (CLAUDE.md §2) is a different install from the gate whose output is being
# questioned. A version that can be about another binary is worse than none,
# because it resolves.
#
# Imports are local so this block is byte-identical in all eleven gates, which
# is what lets a test assert they have not drifted apart. Read at run time and
# never baked at release: a substituted constant is a stored count, and this
# corpus keeps finding stored counts wrong.
def report_version():
    import json as _json
    from pathlib import Path as _Path
    here = _Path(__file__).resolve()
    manifest = here.parent.parent / ".claude-plugin" / "plugin.json"
    try:
        version = _json.loads(manifest.read_text(encoding="utf-8"))["version"]
    except Exception as exc:
        # ADR-005: could not read is not a version. Never guess, and never fall
        # back to a resolver — that would answer about a different tree and look
        # exactly like success.
        print(f"{here.name} (version unreadable: {manifest} — {exc})")
        return
    print(f"{here.name} {version} ({here.parent.parent})")


def main():
    if "--version" in sys.argv[1:]:
        report_version()
        sys.exit(0)
    reject_unknown_flags(("--all", "--json"))
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    flags = {a for a in sys.argv[1:] if a.startswith("--")}
    if len(args) != 1:
        print(__doc__.strip().split("\n\n")[1], file=sys.stderr)
        return 1

    # ADR-034 / issue #10. A corpus root reaches here looking like a tasks
    # directory that happens to be empty, because `resolve_tasks_dir` returns a
    # directory unchanged when it holds no `tasks/` child. Asked BEFORE the
    # single-record path so the answer is the one the caller wanted.
    #
    # THE `== target` IS WHAT KEEPS A RECORD FOLDER OUT, and the first version of
    # this branch did not have it. `ADR-034-slug/` owns no task files DIRECTLY —
    # they are in `tasks/` beside them — so `not load(target)` is true of it, and
    # a record folder was answered as a corpus holding one record literally named
    # `tasks`. A previously working input, silently reshaped. Found by a Codex
    # review, not by this suite; the regression test is beside the others.
    #
    # `resolve_tasks_dir(target) == target` says exactly "this directory has no
    # `tasks/` child of its own", which is the difference between a corpus root
    # and a record folder, asked through the same resolver the rest of the gate
    # uses rather than by re-deriving the rule here.
    target = Path(args[0])
    if target.is_dir() and resolve_tasks_dir(target) == target and not load(target):
        records, unreadable = corpus_records(target)
        if records or unreadable:
            return report_corpus(records, unreadable, flags)

    tasks_dir = resolve_tasks_dir(Path(args[0]))
    if tasks_dir is None:
        # A record with no tasks directory is an ORDINARY state, not a failure:
        # most records in a real corpus are in it, and a reader asking about one
        # gets a complete and correct answer — there is nothing to sequence. This
        # gate advises and never blocks (CLAUDE.md §3), so it exits 0 and says so;
        # a shell treating non-zero as failure would otherwise trip on 25 of 28
        # records while the two states that most deserve attention — an undecided
        # record, and a record whose tasks are all blocked — reported success.
        # Raised 2026-08-29 by the session that swept its whole corpus with it.
        #
        # A path that does not exist is different and still exits 1: that is "I
        # could not answer", not "the answer is none".
        target = Path(args[0])
        if not target.exists():
            print(f"adr-next: no such file or directory: {args[0]}", file=sys.stderr)
            return 1
        print(f"adr-next: {args[0]} owns no tasks directory, so there is nothing to sequence. "
              f"A record's tasks live in `tasks/` beside it, or in `<record>/tasks/`.")
        return 0

    infos = load(tasks_dir)
    if not infos:
        print(f"adr-next: no task files in {tasks_dir}", file=sys.stderr)
        return 1

    # Said BEFORE the answer, because the answer is what gets acted on. A record
    # that is not Accepted is a plan or history, never a work order (CLAUDE.md
    # §10) — but this gate instructs and never blocks, so the tasks are still
    # reported and the reader decides.
    status = owning_record_status(tasks_dir)
    if status is not None and not re.match(r"accepted\b", status, re.I):
        print(f"adr-next: the record owning these tasks is **{status}**, not Accepted — "
              f"a record is a work order only once it is Accepted, so what follows is a "
              f"reading of its PLAN, not of work anyone has decided to do.", file=sys.stderr)

    # The corpus directory: the parent of the record's own folder, which is where
    # a sibling ADR lives. None when the layout is not that shape, and then every
    # foreign edge reads "unknown" — which withholds `ready`, the safe direction.
    corpus_dir = tasks_dir.parent.parent if tasks_dir.parent.parent.is_dir() else None
    ready, done, blocked, stopped = classify(infos, corpus_dir)

    if "--json" in flags:
        print(json.dumps({"tasks_dir": str(tasks_dir), "ready": ready,
                          "done": done, "blocked": blocked, "stopped": stopped},
                         indent=2))
        return 0 if ready else 3

    if "--all" in flags:
        for inf in done:
            print(f"done     {inf['id']}  {inf['goal']}")
        for inf in ready:
            print(f"READY    {inf['id']}  {inf['goal']}")
        for inf in blocked:
            print(f"blocked  {inf['id']}  {inf['goal']}  (waiting on {', '.join(inf['blocked_by'])})")
        for inf in stopped:
            print(f"stopped  {inf['id']}  {inf['goal']}  "
                  f"(a human sign-off says stop: {inf['stopped_by']})")
        return 0 if ready else 3

    if not ready:
        if not blocked and not stopped:
            print(f"All {len(done)} task(s) carry exit-0 evidence for their current Acceptance.")
            return 3
        # The sentence stays PRECISE about which of the two states the corpus is
        # in. "Nothing is ready" is true of both and tells the reader nothing
        # about where to go; "every remaining task is blocked" is false the moment
        # a human stop is in the mix, and that wording had a test on it.
        if stopped and blocked:
            print("Nothing is ready: some tasks are blocked and some were stopped "
                  "by a sign-off.", file=sys.stderr)
        elif stopped:
            print("Nothing is ready: every remaining task was stopped by a sign-off.",
                  file=sys.stderr)
        else:
            print("Nothing is ready: every remaining task is blocked.", file=sys.stderr)
        for inf in stopped:
            print(f"  {inf['id']} was stopped by a sign-off: {inf['stopped_by']}", file=sys.stderr)
        for inf in blocked:
            print(f"  {inf['id']} waits on {', '.join(inf['blocked_by'])}", file=sys.stderr)
        return 3

    inf = ready[0]
    print(f"Next: {inf['id']} — {inf['goal']}")
    print(f"  file: {inf['path']}")
    if inf["human_observed"]:
        print("  acceptance: human-observed — sign off with "
              f"`adr-verify {inf['path']} --human \"<who observed what>\"`")
    elif inf["acceptance"]:
        print(f"  acceptance: {inf['acceptance']}")
        print(f"  prove it:   adr-verify {inf['path']}")
    if len(ready) > 1:
        print(f"  also ready: {', '.join(i['id'] for i in ready[1:])}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
