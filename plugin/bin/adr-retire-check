#!/usr/bin/env python3
"""Verify an opt-in ADR archive catalog and its active discovery/obligation receipts.

Usage:
  adr-retire-check <archive-readme>
  adr-retire-check --adopt <active-root> <archive-root>

The archive README supplies **Active corpus:** as a path relative to the archive.
Exit 0 means the hybrid active/archive contract is internally consistent.

`--version` prints this gate's name, the version read from the manifest beside
IT, and that root. Ask the gate whose output you are questioning rather than a
resolver: `qh-root` and `qh-doctor` answer which copy is newest on the machine,
which on a box carrying both PATH mechanisms can be a different install from the
one that just ran (ADR-031).

Exit: 0 the contract holds · 1 it does not · 2 could not run: plugin/lib/record.py
is not beside this gate's bin/ (a gate copied on its own; ADR-045), a named path that exists but
could not be read, a corpus file that is not a regular file or not text, or a directory a walk
could not list (ADR-092 Decision 10).
"""

import hashlib
import importlib.util as _ilu
import os
import re
import sys
from collections import Counter
from functools import lru_cache
from pathlib import Path

# --- win32 utf-8 io (D1 fix) -------------------------------------------------
# Windows defaults stdout/stderr and open() to the ANSI codepage. These tools
# print and WRITE `·` and `—`; under cp1252 a `·` lands as a bare 0xB7 byte,
# which is not valid UTF-8, so an append-only evidence file becomes undecodable.
import sys as _sys
for _s in (_sys.stdout, _sys.stderr):
    try:
        _s.reconfigure(encoding="utf-8", errors="replace")
    except Exception:
        pass
# ---------------------------------------------------------------------------

# The record grammar — `sections_of` — lives in plugin/lib/record.py and is loaded
# the way adr-verify loads fence.py (ADR-045): from THIS file's path, never from
# PATH or cwd. Until 2026-09-11 this gate carried its own copy, one of five
# identical ones. A gate copied without lib/ says so and exits 2 (ADR-005).
_lib = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib")
_record_file = os.path.join(_lib, "record.py")
if not os.path.isfile(_record_file):
    sys.stderr.write(f"[{os.path.basename(__file__)}] could not run: plugin/lib/record.py is not beside this gate's bin/ "
                     f"(looked in {_lib}). A gate copied without lib/ cannot run — run it from the plugin directory "
                     f"or through a forwarder.\n")
    sys.exit(2)
_loaded_record = sys.modules.get("record")
if os.path.realpath(getattr(_loaded_record, "__file__", None) or "") != os.path.realpath(_record_file):
    _record_spec = _ilu.spec_from_file_location("record", _record_file)
    _loaded_record = _ilu.module_from_spec(_record_spec)
    sys.modules["record"] = _loaded_record
    _record_spec.loader.exec_module(_loaded_record)
from record import sections_of  # noqa: E402
from record import clipped, os_reason  # noqa: E402
from record import first_number_id, first_reference, record_id, references_in, title_line, walk  # noqa: E402
from record import corpus_eligible, git_root, read_record_text, read_regular, recognised_as_record, special_file_problem  # noqa: E402
from record import record_status, status_kind  # noqa: E402


PLACEHOLDERS = {"", "none", "none.", "_none._", "(empty at authoring)"}


def _shown(path):
    """A path as the working directory names it, or as given: never a resolved home path in a
    report meant to be pasted (ADR-089 T5)."""
    absolute = Path(os.path.abspath(path))
    try:
        return absolute.relative_to(Path(os.path.abspath(os.getcwd()))).as_posix()
    except ValueError:
        return Path(path).as_posix()


def _could_not_run(path, reason):
    """Exit 2, naming the path this gate could not read or list: a count, a seal or a PASS over a
    tree it did not see would be a verdict about something it never looked at (ADR-005)."""
    print(f"[adr-retire-check] could not run: {_shown(path)} — {reason}", file=sys.stderr)
    raise SystemExit(2)


def _read(path):
    """Any walked file's text, for attribution and obligations: a regular file only, never opened
    otherwise, since a FIFO blocks its reader (ADR-092 Decision 10). A binary attachment is read
    and attributed by its name; only a record's text read refuses a NUL byte (`_read_record`)."""
    try:
        return read_regular(path)
    except OSError as exc:
        _could_not_run(path, os_reason(exc))


def _read_record(path):
    """A file read AS a record: a regular file holding text, or could-not-run naming it."""
    try:
        return read_record_text(path)
    except OSError as exc:
        _could_not_run(path, os_reason(exc))


def _present(path):
    """Whether `path` is a regular file to read. False when it is absent or a directory, as `is_file()`
    answers; could-not-run, naming it, when it exists and is not one: a FIFO archive README read
    "[FAIL] archive README not found" over a file that was there, and a FIFO link target was a broken
    link (a gpt-6.1-sol review of ADR-092's execution, finding 9). Never opened."""
    problem = special_file_problem(path)
    if problem:
        _could_not_run(path, problem)
    return Path(path).is_file()


def _sealed_walk(root):
    """`_walked(root)` for a seal: a file in it that exists and is not a regular file is could-not-run,
    named, never left out of the digest in silence; `is_file()` dropped a FIFO attachment and the seal
    matched without it (finding 8)."""
    paths = _walked(root)
    for path in paths:
        problem = special_file_problem(path)
        if problem:
            _could_not_run(path, f"{problem}, so the decision unit it may belong to cannot be sealed whole")
    return paths


def _walked(root):
    """Every path under `root`, sorted. A directory the walk could not list is could-not-run,
    named, never a count or a seal over part of the tree (ADR-092 Decision 10)."""
    unlisted = []
    paths = sorted(walk(root, unlisted=unlisted))
    for directory in unlisted[1:]:
        print(f"[adr-retire-check] could not list: {_shown(directory)}", file=sys.stderr)
    if unlisted:
        _could_not_run(unlisted[0], f"this directory could not be listed, so the walk under {_shown(root)} "
                                    f"is incomplete")
    return paths


@lru_cache(maxsize=None)
def _repository(root):
    """The git root a walked root is in, computed once per root (a non-repository spawns git)."""
    return git_root(root)


def disposition_span(text):
    """The balanced `(permanent…)` / `(deferred:…)` group in `text`, as (inner, start, end).

    Scanned by paren DEPTH rather than matched with `[^)]*`, which cannot cross
    the `)` of a nested pair. Measured 2026-08-28 on one bullet reading
    `(permanent: the `archive()` helper keeps originals)`: adr-lint advised that
    it carried no disposition at all, and adr-debt reported it as a BROKEN
    [malformed] pointer — a finding about a bullet that visibly complies. The
    architecture.md scan was worse again, capturing a TRUNCATED pointer and
    resolving that, so it named a path nobody wrote.

    None when no such group is balanced. Callers apply their own keyword and
    position tests; this answers only "where does the disposition actually end".

    ONE BODY, THREE COPIES — adr-lint, adr-debt and adr-retire-check are
    standalone scripts with no import path between them (ADR-011: a shared file
    under bin/ acquires a generated forwarder). `tests/gate-regressions.py`
    holds the one truth table all three are checked against, the way ADR-009
    binds `enforcement_pointers` to `declaredEnforcement`.
    """
    # A DISPOSITION INSIDE A CODE SPAN IS A MENTION, NOT A DISPOSITION — see the
    # shared truth table in tests/gate-regressions.py, and adr-lint's copy for the
    # measurement. Only an opening INSIDE a span is skipped; a disposition that
    # CONTAINS one stays a disposition.
    spans = [(m.start(), m.end()) for m in re.finditer(r"`[^`]*`", text)]
    for opening in re.finditer(r"\((?=permanent\b|deferred\b)", text):
        depth = 0
        if any(a < opening.start() < b - 1 for a, b in spans):
            continue
        for i in range(opening.start(), len(text)):
            if text[i] == "(":
                depth += 1
            elif text[i] == ")":
                depth -= 1
                if depth == 0:
                    return text[opening.start() + 1:i], opening.start(), i + 1
    return None


def closes_the_line(text, end):
    """Whether a parenthetical ending at `end` is the last thing on the line.

    TRAILING SENTENCE PUNCTUATION IS TOLERATED. `(deferred: notes.md).` is a
    disposition somebody ended a sentence after, and rejecting it was not merely
    strict — adr-debt then fell through to its `malformed` branch and printed
    `BROKEN [malformed] … ('')`, the vocabulary for "deferred with nothing after
    the colon", about a pointer that is right there in the line. A gate reporting
    an observation it did not make (ADR-005, CLAUDE.md §3).

    Reported 2026-08-29 against v2.31.1 by a session on an adopting corpus where
    ALL FIFTEEN of its broken-pointer findings were this shape, every one of them
    well-formed, blocking at exit 1 — the "a corpus adopting this on a tree it did
    not write lights up on day one" case ADR-011 was explicitly designed against.

    A SECOND PARENTHETICAL IS STILL NOT PUNCTUATION: `(permanent: why) (see also)`
    leaves `(see also)` behind and does not close the line. That distinction is
    what this function keeps, and it is the reason it is not simply dropped.
    """
    return text[end:].strip(" \t.,;:") == ""


def status_of(path):
    """A record's Status by ADR-074's one reading, or "" when it has none. A record that is not a
    regular text file is could-not-run, never a Status that governs (ADR-092 L9)."""
    text = _read_record(path)
    return record_status(text)[0] or ""


def is_accepted_status(status):
    """Only an Accepted status grants current decision authority. The first word
    decides, by ADR-074's lookup, so `Accepted (Zy, 2026-09-01)` is Accepted
    (BACKLOG §313's open question)."""
    return status_kind(status) == "governing"


def adr_files(root, unidentified=None):
    """Every record under `root`, keyed by its ADR-063 identity.

    A record is what record.py's one definition says (ADR-092): its walk considers the paths
    `corpus_eligible` admits below `root` (`.md` in any case, never a README, nothing under
    `tasks/`, `templates/` or a fixture tree), and asks `recognised_as_record` of each, with the
    repository's root computed once. A recognised record with an identity is counted; every other
    recognised record, the name arm included (`ADR-12345-x.md`, `spec-01-x.md`), is appended to
    `unidentified`, so the caller says so; it is never counted and never silently dropped (ADR-063
    Decision 4, ADR-005). A file that is not a regular text file, or a directory the walk could not
    list, is could-not-run.
    """
    records = {}
    repository = _repository(Path(os.path.abspath(root)))
    for path in _walked(root):
        if not corpus_eligible(path.relative_to(root).as_posix()):
            continue
        text = _read_record(path)
        if not recognised_as_record(path, text, repository)[0]:
            continue
        adr_id = record_id(path.name, title_line(text))
        if adr_id is None:
            if unidentified is not None:
                unidentified.append(path)
            continue
        records.setdefault(adr_id, []).append(path)
    return records


def adr_id_for_file(path, root, known=frozenset()):
    """Which record a file belongs to. Two layers, and the order is the contract.

    FIRST, THE NUMBERED RULE THIS GATE HAS ALWAYS USED, UNCHANGED: an ADR-N token in
    the file's first two lines, then in its own name, then in each directory up to
    `root`. A numbered corpus therefore attributes every file as it did before
    ADR-063, which is that record's failure criterion; three review rounds found
    each departure from it hiding an obligation or breaking a seal (Codex,
    2026-09-22). `ADR-001-x/2026-07-15-notes.md`, `ADR-001-x/002-plan.md` and
    `ADR-999-notes/notes-ADR-001.txt` all resolve here, as they always did.

    THEN, ONLY WHERE NO ADR-N TOKEN EXISTS ANYWHERE, ADR-063's names: a record's own
    name (never a file under `tasks/`, which is not enumerated as a record and would
    otherwise take its obligations with it); else the LONGEST known stem it extends
    (`<stem>.queries.md`; longest, so `x.v2.queries.md` is x.v2's, whatever order a
    set iterates in); else the nearest directory below `root` that is an id; else
    the file's own name. The walk stops at `root`.
    """
    text = _read(path)
    relative = path.relative_to(root)
    found = first_number_id(" ".join(text.splitlines()[:2]), skip_dates=True)
    if found:
        return found
    for part in reversed(relative.parts):
        found = first_number_id(part)
        if found:
            return found
    in_tasks = "tasks" in {part.lower() for part in relative.parts[:-1]}
    # The definition, never asked of NUL text: a binary attachment is attributed by its name and
    # sealed raw (ADR-092 Decision 10).
    if not in_tasks and "\x00" not in text and recognised_as_record(
            path, text, _repository(Path(os.path.abspath(root))))[0]:
        found = record_id(path.name, title_line(text))
        if found:
            return found
    stem = path.name[:-len(".md")] if path.name.lower().endswith(".md") else path.name
    companions = [adr_id for adr_id in known if not adr_id.startswith("ADR-") and stem.startswith(f"{adr_id}.")]
    if companions:
        return max(companions, key=len)
    for part in reversed(relative.parts[:-1]):
        found = record_id(part)
        if found:
            return found
    # A NON-record's own name counts only as a dated stem. A bare number, `001-notes.txt`
    # in a flat numbered archive, belonged to no record before ADR-063, and giving it to
    # ADR-001 changed that record's seal (Codex, 2026-09-22, round 4). An `NNN-slug`
    # RECORD was already resolved by its content above.
    found = record_id(path.name, title_line(text))
    return found if found and not found.startswith("ADR-") else None


def meaningful_obligations(root, known=frozenset(), records=None):
    """Unchecked obligations per record id. A file `adr_files` counted as a record (`records`, its map
    of id to paths) owns its own obligations, by its identity: the attribution rule reads the first two
    lines, and a frontmatter whose second line is a YAML comment `# ADR-999: …` gave ADR-040's
    obligations to ADR-999, which nothing checked (a gpt-6.1-sol review of ADR-092's execution,
    finding 5). Every other file is attributed as `adr_id_for_file` attributes it."""
    own = {path: adr_id for adr_id, paths in (records or {}).items() for path in paths}
    counts = Counter()
    # `.md` in any case, on every platform: `walk(root, "*.md")` matched case-sensitively off
    # Windows, so a `.MD` record's obligations were never counted there (ADR-092 Decision 10).
    for path in _walked(root):
        if not path.name.lower().endswith(".md"):
            continue
        if path.resolve() == (root / "README.md").resolve():
            continue
        adr_id = own.get(path) or adr_id_for_file(path, root, known)
        if not adr_id:
            continue
        sections = sections_of(_read(path))
        for line in sections.get("Out of Scope", []):
            # An obligation is COUNTED, not resolved, so anything after the colon
            # counts — `(deferred: )` included, which is still an obligation
            # somebody owes. `(deferred:)` with nothing at all is not.
            span = disposition_span(line)
            if span and span[0].startswith("deferred:") and len(span[0]) > len("deferred:"):
                counts[adr_id] += 1
        for line in sections.get("Follow-ups", []):
            match = re.match(r"^\s*- \[ \]\s*(.*?)\s*$", line)
            if match and match.group(1).strip().lower() not in PLACEHOLDERS:
                counts[adr_id] += 1
    return counts


def receipt_count(lines, adr_id):
    """Unchecked BACKLOG lines naming `adr_id`, by ADR-063's reference rule."""
    return sum(
        1 for line in lines
        if re.match(r"^\s*- \[ \]", line) and adr_id in references_in(line)
    )


def links_in(readme):
    out = []
    text = _read(readme)
    for match in re.finditer(r"\[[^]]+\]\(([^)]+)\)", text):
        target = match.group(1).split("#", 1)[0].strip()
        if target and not re.match(r"^[a-z]+://", target, re.I):
            out.append((target, (readme.parent / target).resolve()))
    return out


class Findings(list):
    """Findings that block, and a second channel for the ones that should not.

    Almost everything here blocks, and that is not an oversight: this gate checks
    a CONTRACT. A link that does not resolve, a digest that does not match the
    frozen record, an obligation with no receipt — each is the archive claiming
    something the repository does not support.

    What advises is form: a row whose cell count is wrong, a lifecycle marker
    that is absent, a date not written as YYYY-MM-DD. The record is still
    readable and nothing has been misrepresented.
    """

    def __init__(self):
        super().__init__()
        self.advice = []

    def advise(self, message):
        self.advice.append(message)


def catalog_rows(readme, errors):
    rows = {}
    for line in sections_of(_read(readme)).get("Retired Records", []):
        if not line.strip().startswith("|"):
            continue
        cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
        if not cells or cells[0] in ("ADR", "-----") or set(cells[0]) == {"-"}:
            continue
        if len(cells) != 7:
            errors.advise(f"archive catalog row needs 7 cells: {clipped(line, 100)}")
            continue
        link = re.search(r"\[[^]]+\]\(([^)]+)\)", cells[0])
        target = link.group(1).split("#", 1)[0] if link else ""
        # The id is an ADR token in the cell, or else the record the link names
        # (ADR-063): `[2026-07-15-x](2026-07-15-x/2026-07-15-x.md)` has no token.
        adr_id = first_number_id(cells[0])
        if not adr_id and target:
            adr_id = record_id(re.split(r"[/\\]", target)[-1])
        if not adr_id:
            errors.append(f"archive catalog row has no ADR id or record stem: {clipped(line, 100)}")
            continue
        if adr_id in rows:
            errors.append(f"archive catalog lists {adr_id} more than once")
            continue
        rows[adr_id] = {
            "link": target,
            "title": cells[1],
            "effect": cells[2],
            "retired": cells[3],
            "reason": cells[4],
            "obligations": cells[5],
            "digest": cells[6].lower(),
        }
    return rows


def path_pointer(cell):
    match = re.search(r"`([^`]+)`", cell)
    if match:
        return match.group(1)
    match = re.search(r"\[[^]]+\]\(([^)]+)\)", cell)
    return match.group(1).split("#", 1)[0] if match else None


def contained(child, parent):
    return child == parent or parent in child.parents


def unit_order(paths):
    """A decision unit's files in the order its digest hashes them, on every platform.

    `sorted(paths)` compares Paths the way the HOST filesystem does, and Windows folds
    case: `X2-ROLLOUT.md` sorts after `tasks/` there and before it everywhere else, so a
    unit sealed on macOS failed on Windows as "SHA-256 does not match" (windows-latest,
    2026-09-23, PR #15). The path's parts compare case-sensitively on every host, and for
    paths beneath one archive root that is exactly the order POSIX already used, so no seal
    written there moves. (Across roots it is not: Python 3.12+ sorts `//a` before `/a`.)
    """
    return sorted(paths, key=lambda path: path.parts)


@lru_cache(maxsize=None)
def _flat_units(archive_root, known):
    """Every file of a flat archive, attributed ONCE per archive and set of known ids: id -> paths.
    Each flat record's seal walked the archive and read every file again, so N records cost N² reads
    (a gpt-6.1-sol review of ADR-092's execution, finding 15). The attribution is the same call, so
    no seal moves."""
    units = {}
    for path in _sealed_walk(archive_root):
        if path.is_file() and path.name != "README.md":
            units.setdefault(adr_id_for_file(path, archive_root, known), set()).add(path)
    return units


def decision_unit_files(archive_root, adr_id, source, known=frozenset()):
    if source.parent != archive_root:
        return unit_order(path for path in _sealed_walk(source.parent) if path.is_file())
    return unit_order({source} | _flat_units(archive_root, known).get(adr_id, set()))


def canonical_bytes(raw):
    """Line-ending-independent bytes for hashing.

    Git translates line endings on checkout, so the same committed archive has
    different bytes on Windows than on macOS. Hashing raw bytes made the seal
    accuse an untouched decision unit of tampering on the other platform —
    measured 2026-08-25 on windows-latest, where the fixture's `.txt` attachment
    came back CRLF and adr-retire-check reported "SHA-256 does not match".

    A line ending is not a decision, so it is normalized away. Everything else
    still changes the digest, which is the whole point of the seal. Binary
    content is detected the way git detects it — a NUL byte — and hashed raw, so
    an image is never silently rewritten before hashing.
    """
    if b"\0" in raw:
        return raw
    return raw.replace(b"\r\n", b"\n").replace(b"\r", b"\n")


def decision_unit_digest(archive_root, adr_id, source, known=frozenset()):
    digest = hashlib.sha256()
    for path in decision_unit_files(archive_root, adr_id, source, known):
        digest.update(path.relative_to(archive_root).as_posix().encode())
        digest.update(b"\0")
        digest.update(canonical_bytes(path.read_bytes()))
        digest.update(b"\0")
    return digest.hexdigest()


def adoption_report(active_root, archive_root):
    active_root, archive_root = active_root.resolve(), archive_root.resolve()
    errors = Findings()
    if not active_root.is_dir() or not archive_root.is_dir():
        # BACKLOG §143. This early refusal is a verdict too, and it was missed by
        # the first sweep because it is a plain print rather than an f-string —
        # the sweep's regex looked for `print(f"[`. A class enumerated by a
        # pattern is only as complete as the pattern (CLAUDE.md §5).
        print(f"[FAIL] --adopt needs existing active and archive directories · {gate_identity()}")
        raise SystemExit(1)
    if contained(active_root, archive_root) or contained(archive_root, active_root):
        errors.append("active and archive roots overlap; recursive gates will still scan history")
    elif active_root.parent != archive_root.parent:
        errors.append("active and archive roots must be sibling directories")

    unidentified = []
    active_records, archive_records = adr_files(active_root, unidentified), adr_files(archive_root, unidentified)
    for adr_id in sorted(set(active_records) | set(archive_records)):
        paths = active_records.get(adr_id, []) + archive_records.get(adr_id, [])
        if len(paths) != 1:
            errors.append(f"{adr_id} exists {len(paths)} times across active/archive roots{one_file(paths)}")

    active_readme = active_root / "README.md"
    linked, broken = set(), []
    if not _present(active_readme):
        errors.append("active corpus needs README.md as the governing decision catalog")
    else:
        for raw, target in links_in(active_readme):
            if not _present(target):
                broken.append(raw)
                continue
            linked.add(target.resolve())
    for raw in broken:
        errors.append(f"active catalog has a broken link: {raw}")

    provisional_governing = set()
    for adr_id, paths in archive_records.items():
        if len(paths) != 1:
            continue
        status = status_of(paths[0])
        if status_kind(status) is None:
            errors.append(f"{adr_id}: cannot classify legacy status '{status or 'missing'}'")
        elif is_accepted_status(status):
            provisional_governing.add(adr_id)
            if paths[0].resolve() not in linked:
                errors.append(f"accepted archived {adr_id} has no exact active-catalog link")

    obligations = meaningful_obligations(archive_root, frozenset(active_records) | frozenset(archive_records), archive_records)
    backlog = active_root / "BACKLOG.md"
    backlog_text = _read(backlog) if _present(backlog) else ""
    backlog_lines = sections_of(backlog_text).get("Follow-ups", [])
    for adr_id, count in sorted(obligations.items()):
        receipts = receipt_count(backlog_lines, adr_id)
        if receipts < count:
            errors.append(
                f"{adr_id}: {count} archived obligation(s), {receipts} active BACKLOG receipt(s)")

    label = "PASS" if not errors else "MIGRATION-REQUIRED"
    # Each root as the working directory names it, or its last component: never an absolute path,
    # which carried a scratch corpus's location into a report meant to be pasted (ADR-089 T5).
    cwd = Path.cwd().resolve()

    def shown(root):
        return root.relative_to(cwd).as_posix() if root.is_relative_to(cwd) else root.name

    print(f"[{label}] {shown(active_root)} + {shown(archive_root)} · {len(active_records)} active · "
          f"{len(archive_records)} archived · {len(provisional_governing)} accepted archived · "
          f"{sum(obligations.values())} obligation(s) · {gate_identity()}")
    for error in errors[:100]:
        print(f"  {error}")
    if len(errors) > 100:
        print(f"  ... {len(errors) - 100} more migration issue(s) omitted")
    # The same advice the catalog check prints: an adoption report that dropped
    # these in silence would call a corpus adopted with records nothing counted.
    for path in unidentified:
        print(f"  advice: {path.relative_to(active_root.parent).as_posix()}: is recognised as a record but "
              f"carries no ADR number and no dated name, so it is not counted")
    raise SystemExit(0 if not errors else 1)


def one_file(paths):
    """` (a, b are one file on disk)` when every path in `paths` reaches one file, else `""`. A
    link and its target in one walked root are a layout defect the duplicate error names, and it
    now says the two spellings are one file (ADR-092 Decision 4)."""
    try:
        same = len({os.path.realpath(path) for path in paths}) == 1
    except OSError:
        return ""
    return f" ({', '.join(_shown(path) for path in paths)} are one file on disk)" if same else ""


def reject_unknown_flags(known=()):
    """A flag this gate does not know is a typo, and a gate that ignores one
    answers a question nobody asked.

    Measured 2026-08-26: `adr-next tasks --jsonn` printed the human report and
    exited 0. lifecycle.mjs asks for `--json` and JSON.parse()s the result inside
    a try/catch that continues on failure, so a renamed or mistyped flag would
    have made session orientation silently empty at exit 0 — the same fail-open,
    by a different route, as the `#!` spawn that BACKLOG item 17 fixed.
    """
    # ⚠ `--help` IS NOT AN UNKNOWN FLAG. TEN OF THIS PLUGIN'S ELEVEN GATES answered
    # `unknown option: --help` at exit 2 — reported 2026-09-07 from an outside
    # corpus where the options were discoverable only by grepping the source. A
    # gate that refuses to explain itself is one people run wrong, and this is the
    # first thing anyone types.
    if "--help" in sys.argv[1:] or "-h" in sys.argv[1:]:
        print(__doc__)
        sys.exit(0)
    unknown = [a for a in sys.argv[1:] if a.startswith("--") and a not in known]
    if unknown:
        print(f"unknown option: {unknown[0]}", file=sys.stderr)
        sys.exit(1)


# ADR-031. Every gate answers for ITSELF, and the answer is read from the
# manifest beside the gate rather than from a resolver. A central answer —
# `qh-root`, `qh-doctor`, a `qh-version` gate — reports whichever copy of
# ITSELF resolved, which on a machine carrying both PATH mechanisms
# (CLAUDE.md §2) is a different install from the gate whose output is being
# questioned. A version that can be about another binary is worse than none,
# because it resolves.
#
# Imports are local so this block is byte-identical in every gate, which
# is what lets a test assert they have not drifted apart. Read at run time and
# never baked at release: a substituted constant is a stored count, and this
# corpus keeps finding stored counts wrong.
def gate_identity():
    """Who is answering: this gate's name, version and plugin root.

    BACKLOG §143. A verdict that names only the record it judged is
    indistinguishable from a verdict reached by a different build, and that
    ambiguity was reported three times as a corpus defect — each time phrased
    "the linter is wrong about my tree" — before anyone established it was
    version skew. The PATH is carried as well as the version because a working
    checkout, an installed plugin cache and a generated forwarder can all
    report a plausible version while being different code, and which one
    answered is the question the reports could not reach.

    ADR-005: an unreadable manifest is said in those words. It is never a guess
    and never a fallback to a resolver, which would answer about a different
    tree and look exactly like success.
    """
    import json as _json
    from pathlib import Path as _Path
    here = _Path(__file__).resolve()
    manifest = here.parent.parent / ".claude-plugin" / "plugin.json"
    def _shown(path):
        # The home directory as `~`: this banner reached SessionStart and pasted reports with
        # a username in it (BACKLOG §350 C4/F3; ADR-031 Follow-ups).
        try:
            rel = path.relative_to(_Path.home())
        except (ValueError, RuntimeError, KeyError):
            return str(path)
        return "~" if not rel.parts else "~/" + rel.as_posix()
    try:
        version = _json.loads(manifest.read_text(encoding="utf-8"))["version"]
    except Exception as exc:
        return f"{here.name} (version unreadable: {_shown(manifest)} — {getattr(exc, 'strerror', None) or exc})"
    return f"{here.name} {version} ({_shown(here.parent.parent)})"


def report_version():
    print(gate_identity())


def main():
    if "--version" in sys.argv[1:]:
        report_version()
        sys.exit(0)
    reject_unknown_flags(("--adopt",))
    if len(sys.argv) == 4 and sys.argv[1] == "--adopt":
        adoption_report(Path(sys.argv[2]), Path(sys.argv[3]))
    if len(sys.argv) != 2:
        print(__doc__)
        raise SystemExit(1)

    archive_readme = Path(sys.argv[1]).resolve()
    errors = Findings()
    if archive_readme.is_dir():
        # It takes the archive's README, the catalog it checks; a directory said "README not found:
        # <dir>", which two runners read as a finding about their corpus (BACKLOG §350 item 6). The
        # argument is shown as given, so no resolved home path is printed for it.
        print(f"[FAIL] adr-retire-check expected the archive's README FILE, and was given a directory: "
              f"{sys.argv[1]} — pass {Path(sys.argv[1]) / 'README.md'} · {gate_identity()}")
        raise SystemExit(1)
    if not _present(archive_readme):
        # BACKLOG §143: the verdict names the binary that reached it.
        print(f"[FAIL] archive README not found: {archive_readme} · {gate_identity()}")
        raise SystemExit(1)
    try:
        archive_text = read_regular(archive_readme)
    except OSError as exc:
        print(f"[adr-retire-check] could not run: {sys.argv[1]} — {os_reason(exc)}", file=sys.stderr)
        raise SystemExit(2)
    if not re.search(r"^\*\*Lifecycle:\*\* Frozen historical ADR records$", archive_text, re.M):
        errors.advise("archive README lacks the opt-in lifecycle marker")
    active_match = re.search(r"^\*\*Active corpus:\*\*\s*(.+?)\s*$", archive_text, re.M)
    active_root = ((archive_readme.parent / active_match.group(1).strip("` ")).resolve()
                   if active_match else None)
    archive_root = archive_readme.parent.resolve()
    if active_root is None or not active_root.is_dir():
        errors.append("**Active corpus:** must resolve to an existing directory")
    elif contained(active_root, archive_root) or contained(archive_root, active_root):
        errors.append("active and archive roots must be disjoint sibling trees")
    elif active_root.parent != archive_root.parent:
        errors.append("active and archive roots must be sibling directories")

    # Do not inspect a repository-controlled path until it has passed the complete
    # sibling/disjoint boundary check. A malformed archive catalog must fail cheaply;
    # it must never turn the automatic edit hook into a recursive scan of / or another
    # unrelated readable tree.
    if errors:
        # BACKLOG §143: the verdict names the binary that reached it.
        print(f"[FAIL] {archive_readme} · active corpus rejected before traversal · {gate_identity()}")
        for error in errors:
            print(f"  {error}")
        raise SystemExit(1)

    active_readme = active_root / "README.md" if active_root else None
    if active_readme is None or not _present(active_readme):
        errors.append("active corpus needs README.md as its governing decision catalog")
    resolved_active_links = set()
    if active_readme and _present(active_readme):
        for raw, target in links_in(active_readme):
            if not _present(target):
                errors.append(f"active catalog has a broken link: {raw}")
            else:
                resolved_active_links.add(target.resolve())

    unidentified = []
    archive_records = adr_files(archive_root, unidentified)
    active_records = adr_files(active_root, unidentified) if active_root and active_root.is_dir() else {}
    known = frozenset(active_records) | frozenset(archive_records)
    for path in unidentified:
        errors.advise(f"{path.relative_to(archive_root.parent).as_posix()}: is recognised as a record but "
                      f"carries no ADR number and no dated name, so it is not counted")
    for adr_id in sorted(set(active_records) | set(archive_records)):
        all_paths = active_records.get(adr_id, []) + archive_records.get(adr_id, [])
        if len(all_paths) != 1:
            errors.append(f"{adr_id} exists {len(all_paths)} times across active/archive roots{one_file(all_paths)}")

    rows = catalog_rows(archive_readme, errors)
    for adr_id in sorted(set(archive_records) - set(rows)):
        errors.append(f"archive catalog is missing {adr_id}")
    for adr_id in sorted(set(rows) - set(archive_records)):
        errors.append(f"archive catalog lists {adr_id}, but no archived ADR file exists")

    obligations = meaningful_obligations(archive_root, known, archive_records)
    # An obligation attributed to an id the catalog does not list is checked too: it was counted and
    # never compared with anything, so a stray file's obligations, or a record's misattributed ones,
    # passed in silence (finding 5).
    for adr_id, count in sorted(obligations.items()):
        if adr_id not in rows:
            errors.append(f"{adr_id}: {count} archived obligation(s) belong to no record the archive catalog "
                          f"lists, so no receipt was checked")
    governing = set()
    replacements = {}
    for adr_id, row in sorted(rows.items()):
        if adr_id not in archive_records or len(archive_records[adr_id]) != 1:
            continue
        source = archive_records[adr_id][0]
        target = (archive_root / row["link"]).resolve() if row["link"] else None
        if target != source.resolve():
            errors.append(f"{adr_id}: catalog link does not resolve to {source.name}")
        effect = row["effect"].strip().lower()
        if effect == "governing":
            if is_accepted_status(status_of(source)):
                governing.add(adr_id)
            else:
                errors.append(
                    f"{adr_id}: archived governing decision is not Accepted")
        elif effect.startswith("superseded by "):
            # ADR-063: the replacement is the FIRST record the effect names, an
            # ADR id or a dated record, and a bare date beside a path is not one.
            # Checked for existence below. Taking whichever reference resolved
            # let `superseded by ADR-999 (see ADR-002)` pass on ADR-002 (Codex,
            # 2026-09-22).
            named = first_reference(row["effect"][len("superseded by "):])
            if not named:
                errors.append(f"{adr_id}: bad Decision effect '{row['effect']}'")
            else:
                replacements[adr_id] = named
        elif effect != "withdrawn":
            errors.append(f"{adr_id}: bad Decision effect '{row['effect']}'")
        if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", row["retired"]):
            errors.advise(f"{adr_id}: Retired must be YYYY-MM-DD")
        if not row["reason"] or row["reason"].startswith("<"):
            errors.append(f"{adr_id}: retirement Reason is empty or a placeholder")
        digest = decision_unit_digest(archive_root, adr_id, source, known)
        if row["digest"] != digest:
            errors.append(f"{adr_id}: SHA-256 does not match the frozen decision unit")

        count = obligations.get(adr_id, 0)
        receipt = row["obligations"].strip()
        if count == 0:
            if receipt.lower() != "none":
                errors.append(f"{adr_id}: no detected obligations, catalog must say 'none'")
            continue
        if receipt.lower().startswith("disposed:") and receipt.split(":", 1)[1].strip():
            continue
        pointer = path_pointer(receipt)
        destination = (archive_root / pointer).resolve() if pointer else None
        backlog = (active_root / "BACKLOG.md").resolve() if active_root else None
        if destination is None or backlog is None or destination != backlog or not _present(backlog):
            errors.append(f"{adr_id}: {count} obligation(s) need an active backlog receipt or disposition")
            continue
        destination_text = _read(destination)
        receipts = receipt_count(sections_of(destination_text).get("Follow-ups", []), adr_id)
        if receipts < count:
            errors.append(
                f"{adr_id}: archive has {count} obligation(s), active receipt has {receipts}")

    for adr_id, paths in active_records.items():
        if len(paths) == 1 and is_accepted_status(status_of(paths[0])):
            governing.add(adr_id)

    all_records = {}
    for adr_id in set(active_records) | set(archive_records):
        paths = active_records.get(adr_id, []) + archive_records.get(adr_id, [])
        if len(paths) == 1:
            all_records[adr_id] = paths[0]
    for adr_id in sorted(governing):
        source = all_records.get(adr_id)
        if source is not None and source.resolve() not in resolved_active_links:
            errors.append(f"active catalog does not link the exact governing record {adr_id}")

    for adr_id, replacement in sorted(replacements.items()):
        source = all_records.get(replacement)
        if source is None:
            errors.append(f"{adr_id}: replacement {replacement} does not exist exactly once")
        elif replacement not in governing:
            errors.append(f"{adr_id}: replacement {replacement} is not an accepted governing decision")
        elif source.resolve() not in resolved_active_links:
            errors.append(f"{adr_id}: replacement {replacement} is not discoverable in the active catalog")

    label = "PASS" if not errors else "FAIL"
    print(f"[{label}] {archive_readme} · {len(active_records)} active · "
          f"{len(archive_records)} archived · {len(governing)} governing · {gate_identity()}")
    for error in errors:
        print(f"  {error}")
    # Printed on a PASS too: acceptable and finished are different things.
    for note in errors.advice:
        print(f"  advice: {note}")
    raise SystemExit(1 if errors else 0)


if __name__ == "__main__":
    main()
