#!/usr/bin/env python3
"""adr-verify — run a task's Acceptance command and append tool-written evidence.

Usage: adr-verify <task.md> [--cwd DIR]
       adr-verify <task.md> --human "<who observed what>"
       adr-verify <task.md> --mutant <file> [--also-restore <file> ...]
                  --from <text> --to <text> --why <text>
       adr-verify --sweep <corpus-dir> [--timeout <seconds>] [--json]

Extracts the ```bash fence under ## Acceptance and runs it with bash
(cwd: --cwd, else git root of the task file, else the task file's directory).
Appends one entry to ## Verification Log:

  - YYYY-MM-DD · <git-short-sha[*]|no-git> · exit <N> · `<first command line[ …]>` · acceptance-sha256:<digest>

`*` marks a dirty working tree at run time; ` …` marks a multi-line command
(the full command is the Acceptance fence — the entry shows line 1). The digest
covers the entire normalized fence: CRLF/CR become LF and fence-adjacent blank
lines are removed; command content is otherwise preserved.
Non-zero exits also append an indented fence with the last 10 output lines.
--human appends `- YYYY-MM-DD · human-observed · <text>` for tasks whose
Acceptance is declared human-observed.

The log is append-only and tool-written: run this instead of hand-pasting.
adr-lint enforces the entry grammar and rejects a README `done` status without
an exit-0 entry whose digest matches the task's current Acceptance fence. Legacy
pre-digest evidence remains valid only for a single-line Acceptance whose shown
command still matches; a first-line-only entry can never prove a multi-line fence.

A zero exit whose run scored NO tests is recorded and returned as exit 1: a
filter matching nothing is not a passing gate.

--mutant is the other half of the gate, and the half that was missing.

Every other check in this pipeline proves a command exited 0. NOTHING proved a
command can exit non-zero — so a test that binds to nothing passes exactly like a
test that binds to the mechanism. The task template asked for a Mutants table and
it was hand-filled, which is the same fabrication hole the Verification Log was
built to close, one section further down. Measured 2026-08-21: a mutation harness
whose edit silently no-opped (Python `str.replace` on an absent pattern) printed
"mutant applied" for a file that never changed, and an assertion that matched a
config file's COMMENTS rather than its keys survived deletion of the real key.
Both were declared mutation-checked. Neither had been.

So the tool, not the author: it asserts the old text is present exactly ONCE
(which kills the silent-no-op class outright), refuses a mutant that only changes
comments, syntax-checks the mutated file where the language makes that cheap,
runs the Acceptance fence, restores the file whatever happens, and records:

  - YYYY-MM-DD · <sha[*]|no-git> · mutant <killed|survived|inconclusive> · exit <N> · `<file>` · <why> · acceptance-sha256:<digest>

`killed` (non-zero exit, tests actually scored) is the only verdict that counts as
evidence. `survived` means the fence passed with the mechanism broken — the test
is decoration. `inconclusive` means the mutant fence failed for a machine,
build, or parse reason rather than a failing assertion. A mutant-only no-tests
result is instead killed when the paired clean fence already scored tests; an
unusable clean fence is `UNPROVEN`, runs no mutant, and writes no verdict.

What this does NOT prove: that the mutant was WELL CHOSEN. Uniqueness makes a
trivial irrelevant line an available escape hatch, and only --why guards that,
which is prose. The gate closes "the mutant proved nothing mechanically".

--restore puts back a mutant that a killed run could not. A `finally` unwinds on
a Ctrl-C and on the SIGTERM this installs a handler for; SIGKILL unwinds nothing,
so the restore is journalled to disk before the mutation lands. The next run
recovers it, and `adr-verify --restore [--cwd <repo>]` does it on demand. If the
file has changed since, nothing is overwritten and the original is written out
beside the journal instead.

--also-restore is repeatable and names repository-relative generated outputs the
Acceptance fence itself may materialize from the mutated source. Those explicit
regular-file leaves join one versioned restore transaction. No suffix is
inferred, undeclared side effects are untouched, and uncertain bytes left by an
interrupted run are preserved for human reconciliation rather than overwritten.
Declaring a path grants this live run authority to overwrite its bytes or delete
it during cleanup, including over a concurrent edit; declare only disposable
generated outputs whose command-entry state is the state to restore.

Exit: the Acceptance command's exit code (0 for --human; 0 only on `killed` for
--mutant; 0 for --restore) · 2 = usage, authoring, or transaction problem.
"""
import base64
import datetime
import hashlib
import json
import ntpath
import os
import re
import signal
import stat
import subprocess
import sys
import tempfile
from pathlib import Path

# --- win32 utf-8 io (D1 fix) -------------------------------------------------
# Windows defaults stdout/stderr and open() to the ANSI codepage. These tools
# print and WRITE `·` and `—`; under cp1252 a `·` lands as a bare 0xB7 byte,
# which is not valid UTF-8, so an append-only evidence file becomes undecodable.
# Child process output decodes with that same default, so every subprocess call
# below names its encoding: under cp1252 the acceptance command's `·` would reach
# the evidence log as `Â·`, and a stray 0x81/0x8D/0x90/0x9D would raise
# UnicodeDecodeError, killing the gate instead of letting it judge.
import sys as _sys
for _s in (_sys.stdout, _sys.stderr):
    try:
        _s.reconfigure(encoding="utf-8", errors="replace")
    except Exception:
        pass
# ---------------------------------------------------------------------------

# A run in which NOTHING was scored is not a pass, whatever the exit code says.
#
# This closes a hole that made the whole gate decoration. `go test -run
# TestThatDoesNotExist` prints "ok <pkg> [no tests to run]" and exits 0, and
# since every task in this pipeline is TDD and names its tests before they
# exist, that is the state of EVERY task the moment it is authored. adr-verify
# would then write a genuine, tool-written success into the Verification Log for
# work nobody had started — worse than a hand-pasted entry, because it carries
# the authority of having actually run. Measured across seven projects: 143 task
# files use a test-name filter, so 143 acceptance commands could pass empty.
#
# Runners differ. Go, PHPUnit and cargo exit 0 on a filter that matches nothing;
# pytest, jest and vitest exit non-zero and were never exposed. The check is by
# output signature so it covers all of them from one place.
NOTHING_RAN = [
    r"\[no tests to run\]",       # go test -run <no match>
    r"\[no test files\]",         # go package with no test file at all
    r"^no tests ran",              # pytest
    r"collected 0 items",          # pytest
    r"No tests executed!",         # phpunit --filter <no match>
    r"^No tests found",            # jest
    r"No test files found",        # vitest
    r"^0 examples",                # rspec
]

# Evidence that something really was scored. If ANY of these appear the run is
# taken at its word — a multi-package run where one package is empty and another
# is not did exercise something, and failing it would be a false positive. The
# check is deliberately biased that way: a gate with false alarms gets ignored,
# and then it protects nothing.
SOMETHING_RAN = [
    r"^--- (PASS|FAIL)",                  # go -v
    r"^ok\s+\S+\s+[\d.]+s\s*$",         # go: a package whose tests actually ran
    r"^(PASS|FAIL)\s+\S+\s+[\d.]+s\s*$",
    r"\b[1-9]\d* (passed|passing|failed|failing)\b",   # jest/vitest/pytest/mocha
    r"test result: (ok|FAILED)\. [1-9]",  # cargo
    r"OK \([1-9]",                        # phpunit
    r"Tests: [1-9]",                      # phpunit / jest summary
    r"^[1-9]\d* (examples?|tests?),",     # rspec / minitest
    # node:test, in both its shapes. Its absence was a laundering path: a real
    # failing node suite whose output happened to contain an environment string
    # matched environment_failure() while nothing here said tests had run, so a
    # genuine failure was reclassified as a machine problem. Every acceptance
    # fence in this repository is `node --test`, which is how the gap survived.
    r"^\u2139 (pass|fail) [0-9]+",         # node --test summary
    r"^not ok [0-9]+",                     # node --test TAP
    r"^# (pass|fail) [0-9]+",              # node --test TAP summary
]


def scored_nothing(output):
    """True when the run reported an empty result set and no evidence of a real one."""
    if not any(re.search(p, output, re.M) for p in NOTHING_RAN):
        return False
    return not any(re.search(p, output, re.M) for p in SOMETHING_RAN)


def normalize_acceptance(raw):
    """Canonical Acceptance text used both for execution and evidence hashing.

    Keep shell-significant indentation and internal blank lines. Only line-ending
    representation and blank lines introduced next to the Markdown fence are
    normalized. adr-lint carries the same small function deliberately: the writer
    and verifier must hash exactly the same bytes without a shared dependency.
    """
    lines = raw.replace("\r\n", "\n").replace("\r", "\n").split("\n")
    start, end = 0, len(lines)
    while start < end and not lines[start].strip():
        start += 1
    while end > start and not lines[end - 1].strip():
        end -= 1
    return "\n".join(lines[start:end])


def acceptance_digest(command):
    """SHA-256 of the complete normalized Acceptance fence."""
    return hashlib.sha256(command.encode("utf-8")).hexdigest()


# A non-zero exit is only evidence when it came from a FAILING ASSERTION. A run
# that did not build, or that scored nothing, exits non-zero too and is
# indistinguishable from a kill by exit code alone — which is precisely how a
# skipped mutant gets recorded as a caught one. Kept tight on purpose: a false
# "inconclusive" is an annoyance, a false "killed" is the defect this exists to
# stop, but a list that cries wolf is a list people route around.
BUILD_BROKE = [
    r"\[build failed\]",                  # go
    r"^PHP Parse error",                   # php
    r"^Parse error: syntax error",         # php
    r"^SyntaxError:",                       # python / node
    r"^IndentationError:",
    r"error: could not compile",            # cargo
    r"^error\[E\d+\]",                     # rustc
    r"Cannot find module",                  # node
    r"^\s*Fatal error: Uncaught Error",     # php
]

# A process that crashed did not return an assertion verdict. Shells commonly
# translate a signal into 128 + signal, while Windows exposes fatal NTSTATUS
# values through the process exit code. Some wrappers normalize either class to
# an ordinary non-zero code but retain the runtime's crash line, so keep that
# narrow output fallback too. Conservatism is intentional here: an inconclusive
# run costs a rerun; a false kill permanently credits proof nobody observed.
CRASH_OUTPUT = re.compile(
    r"^(?:[^:\n]+:\s*)?(?:line \d+:\s*)?(?:\d+\s+)?"
    r"(?:segmentation fault|bus error|illegal instruction|floating point exception|"
    r"abort trap(?:: \d+)?|stack overflow|fatal python error:|unhandled exception(?:[.:]|$))",
    re.I | re.M,
)


def abnormal_termination(code, output):
    """Whether a fence ended without an ordinary assertion-bearing exit."""
    if code is None or code < 0:
        return True
    # POSIX shells report signal N as 128 + N. Signals are bounded to 64 on the
    # platforms this plugin supports; 128 itself is not a signal verdict.
    if 129 <= code <= 192:
        return True
    # Windows fatal exception statuses carry the high two bits (for example,
    # 0xC0000005 for access violation). Python may expose them unsigned; signed
    # forms were already caught by code < 0 above.
    if code >= 0xC0000000:
        return True
    return bool(CRASH_OUTPUT.search(output or ""))

# Comment syntax per file type, for the comment-only mutant refusal. A mutation
# that changes only prose changes nothing the program does — and it is exactly
# the mutant an author reaches for by accident when a test matches a file's
# comments instead of its keys (measured 2026-08-21, twice in one hour).
# Comments that are INSTRUCTIONS TO A TOOLCHAIN, not prose. Editing one changes
# what is compiled, linted or measured, so a mutation touching one is a real
# mutation however comment-shaped it looks (docs/BACKLOG.md §67).
DIRECTIVE_COMMENT = re.compile(
    r"(?://\s*(?:go:|\+build\b|nolint\b|eslint-|prettier-|ts-(?:ignore|expect-error)\b)"
    r"|#\s*(?:type:\s*ignore\b|noqa\b|pylint:|mypy:|ruff:|fmt:\s*(?:off|on)\b)"
    r"|/\*\s*(?:istanbul|c8|v8)\s+ignore\b"
    r"|^#!)",
    re.M)

LINE_COMMENT = {
    ".yml": "#", ".yaml": "#", ".toml": "#", ".sh": "#", ".bash": "#",
    ".py": "#", ".rb": "#", ".conf": "#", ".ini": ";", ".env": "#",
    ".go": "//", ".php": "//", ".js": "//", ".ts": "//", ".tsx": "//",
    ".jsx": "//", ".rs": "//", ".java": "//", ".c": "//", ".h": "//",
}

def looks_absolute(pointer):
    """True for a path the user meant as rooted, on every platform and Python.

    `Path.is_absolute()` is False for a rooted, driveless path on Windows:
    `/etc/passwd` is drive-RELATIVE there, so pathlib is right and the callers
    were not. They joined it to the working directory and re-rooted it onto
    whichever drive the run happened to be on — measured 2026-08-30 from
    `Y:\\Projects`, where `/etc/passwd` became `Y:\\etc\\passwd`, so the same input
    behaved differently per drive letter and the diagnostic named a path nobody
    typed.

    Do not reach for `os.path.isabs` instead. It agrees with pathlib on 3.14 and
    DISAGREES on 3.10 — `ntpath.isabs` changed in 3.13 to stop calling a rooted,
    driveless path absolute — so the answer would depend on which interpreter the
    `#!/usr/bin/env python3` shebang happened to find, and a box with both
    installed can select either. Test the property directly instead: a drive
    prefix, or a leading separator in either spelling. That is CLAUDE.md §7's
    "reject a drive prefix as well as a leading slash" rule in the mirror
    direction, and it does not ask the interpreter what "absolute" means.
    """
    text = str(pointer)
    return bool(re.match(r"^[A-Za-z]:", text)) or text[:1] in ("/", "\\")


def resolve_bash(platform=sys.platform, env=None, exists=None):
    """Absolute Git Bash on Windows; plain `bash` everywhere else. None if absent.

    Windows ships `C:\\Windows\\System32\\bash.exe`, a launcher that drops into the
    default WSL distro, and the Store adds another stub under WindowsApps. A bare
    `subprocess.run(["bash", ...])` picks the System32 one, so an Acceptance fence
    calling `docker` ran inside a distro where Docker Desktop integration may be
    off and failed for a reason that has nothing to do with the code under test.
    Measured 2026-08-25 on Windows 11: three bash.exe on PATH, and the interactive
    shell resolved a different one than Python did.

    Same precedence as resolveBashExecutable in scripts/run-shell-hook.mjs — the
    Node hook layer already avoided this stub and the Python gates never got the
    port, so one machine answered "where is bash" two different ways. Parameters
    are injectable for the same reason that resolver's are: the logic has to be
    testable off Windows.
    """
    if platform != "win32":
        return "bash"
    env = os.environ if env is None else env
    exists = os.path.isfile if exists is None else exists

    configured = env.get("CLAUDE_CODE_GIT_BASH_PATH")
    if configured:
        return configured

    for raw in (env.get("PATH") or env.get("Path") or "").split(";"):
        directory = raw.strip().strip('"')
        # Skip both stubs. System32's bash.exe is the WSL launcher; WindowsApps
        # holds a 0-byte Store app-execution alias. os.path.isfile() is True for
        # the alias, so trusting it returned the alias and never reached the
        # ProgramFiles fallback below — measured 2026-08-30 on Windows 11, where
        # the registry PATH carried no bash-bearing directory but WindowsApps.
        # The docstring named both from the start; only one was ever filtered.
        if not directory or re.search(r"[\\/](?:system32|windowsapps)[\\/]?$", directory, re.I):
            continue
        candidate = ntpath.join(directory, "bash.exe")
        if exists(candidate):
            return candidate

    drive = env.get("SystemDrive") or "C:"
    roots = [
        ntpath.join(env["LOCALAPPDATA"], "Programs", "Git") if env.get("LOCALAPPDATA") else None,
        ntpath.join(env.get("ProgramFiles") or drive + "\\Program Files", "Git"),
        ntpath.join(env.get("ProgramFiles(x86)") or drive + "\\Program Files (x86)", "Git"),
    ]
    for root in roots:
        if not root:
            continue
        candidate = ntpath.join(root, "bin", "bash.exe")
        if exists(candidate):
            return candidate
    return None


def decode_stream(raw):
    """Whatever a killed process left behind, as text.

    `TimeoutExpired.stdout` is bytes when the run was started in text mode with
    a timeout that fired, and None when nothing was captured. Both reach the
    reader as "" rather than a traceback.
    """
    if raw is None:
        return ""
    return raw.decode("utf-8", errors="replace") if isinstance(raw, bytes) else raw


def failure_tail(stdout, stderr, keep=10):
    """The lines a reader needs from a failed run, kept PER STREAM.

    The block used to be the last `keep` lines of `stdout + stderr` — the tail of
    a CONCATENATION. When a runner puts its verdict on stdout and its noise on
    stderr, which is ansible's exact shape (play recap to stdout, warnings to
    stderr), every recorded line comes from stderr and the verdict is gone.
    Measured 2026-08-29 with one FAIL line and twelve warnings: the block held
    warnings 3 through 12 and no FAIL, and the reporting session hit it five times
    while every deploy was in fact correct (docs/BACKLOG.md §54).

    Interleaving is lost either way — two captured pipes cannot be re-woven — so
    the honest form is to say which stream each part came from rather than to
    imply an order that was never observed. A stream with nothing in it is
    omitted rather than labelled empty.
    """
    parts = []
    for label, raw in (("stdout", stdout), ("stderr", stderr)):
        lines = (raw or "").strip().splitlines()
        if not lines:
            continue
        # FOLD FIRST, THEN TRUNCATE. Folding the tail counts what SURVIVED the
        # tail, not what happened: a warning that fired five times, with two of
        # them cut by the tail, was reported `(x3)` — accurate about the block and
        # wrong about the world. Measured 2026-08-29 on a deliberately sharp
        # fixture (two runs of the same line separated by unique ones), and the
        # reporter's point is why it matters more after folding than before:
        # tidy lines with explicit counts READ as a full accounting, so the
        # presentation got better and, in that one place, less honest
        # (docs/BACKLOG.md §72).
        #
        # Folding first also makes truncation rarer — their twelve raw lines fold
        # to four, so nothing is cut at all — which is the better outcome for the
        # same change.
        folded = collapse_repeats(lines)
        shown = folded[-keep:]
        head = f"--- last {len(shown)} line(s) of {label}"
        if len(folded) > len(shown):
            head += f" (of {len(folded)} after folding {len(lines)} raw)"
        elif len(folded) < len(lines):
            head += f" ({len(lines)} raw, folded)"
        parts.append(head)
        parts.extend(shown)
    return parts


def collapse_repeats(lines):
    """Consecutive identical lines, folded into one with a count.

    The per-stream tail stopped the verdict being EVICTED and did not stop it
    being BURIED: measured 2026-08-29 on a real fence, fourteen recorded lines of
    which two carried the verdict and ten were the same deprecation warning
    repeated. A reader whose eye lands mid-block concludes the task failed on a
    deprecation. Repeated-identical is the overwhelmingly common shape for build
    and ansible stderr, which is exactly why the tail fills with it.

    Collapsing loses nothing — the count says how many there were — and it is
    preferred over weighting the budget toward stdout, which would be guessing
    which stream carries the answer. Suggested by the session that reported §54
    after reading its own fix in place (docs/BACKLOG.md §70).
    """
    folded = []
    for line in lines:
        if folded and folded[-1][0] == line:
            folded[-1][1] += 1
        else:
            folded.append([line, 1])
    return [text if n == 1 else f"{text}  (x{n})" for text, n in folded]


# The Acceptance fence, whatever the author spelled the language. `sh` and
# `shell` are reasonable things to type and the fence runs through bash either
# way; refusing them bought nothing and cost a reader a minute of guessing
# (docs/BACKLOG.md §70). `bash` stays first because it is what the template says.
ACCEPTANCE_FENCE = re.compile(r"```(?:bash|sh|shell)\s*\n(.*?)```", re.S)


def bash_or_exit():
    """`resolve_bash` or a usable failure. Never silently falls back to the stub."""
    shell = resolve_bash()
    if shell is None:
        print("[adr-verify] Git Bash was not found. Set CLAUDE_CODE_GIT_BASH_PATH to "
              "Git for Windows bin/bash.exe.", file=sys.stderr)
        sys.exit(2)
    return shell


ENVIRONMENT_SIGNATURES = [
    (r"could not be found in this WSL 2 distro|WSL integration",
     "the acceptance command ran inside a WSL distro that cannot see the tool. "
     "Docker Desktop's WSL integration is likely off for that distro "
     "(Settings -> Resources -> WSL Integration)."),
    (r"Cannot connect to the Docker daemon|Is the docker daemon running|error during connect",
     "the Docker daemon was unreachable. Start Docker Desktop, or the engine, and re-run."),
]


def environment_failure(output, cmd):
    """A machine problem this output is evidence OF, or None. Never a verdict.

    A fence that cannot reach its tools exits non-zero exactly like a fence whose
    code is wrong, and the Verification Log records both the same way. Measured
    2026-08-25 on Windows 11: four tasks read as failing implementations when the
    real cause was Docker Desktop's WSL integration being off. Naming the class
    costs nothing and removes an hour of looking in the wrong place.

    This only ever ADDS a line. It does not change the exit code, downgrade a
    failure, or suppress the entry — an environment excuse that could turn red
    into green would be far worse than the confusion it set out to fix, because
    it would let genuinely broken code through.
    """
    for pattern, explanation in ENVIRONMENT_SIGNATURES:
        if re.search(pattern, output, re.I):
            return explanation
    # `foo: command not found` counts only when `foo` is the fence's own first
    # word. A tool missing deep inside a script is the task's problem to state.
    head = (cmd.strip().split() or [""])[0]
    if head and re.search(
            r"(?:^|[:\s])%s: (?:command not found|not found)|'%s' is not recognized"
            % (re.escape(head), re.escape(head)), output, re.I):
        return (f"`{head}` was not found on PATH for the shell that ran the fence. "
                f"It may exist in an interactive shell and not in this one.")
    return None


# Cheap, universally-available parsers. A language absent here is simply not
# syntax-checked — saying so beats inventing a check that needs a toolchain the
# runner may not have. `.sh` resolves its shell at call time, not import time,
# so the Windows lookup happens once a check is actually requested.
SYNTAX_CHECK = {
    ".sh": ["bash", "-n"], ".bash": ["bash", "-n"],
    ".php": ["php", "-l"],
    ".go": ["gofmt", "-e"],
}


def strip_comments(text, marker):
    """The text with whole-line comments and blank lines removed."""
    if not marker:
        return text
    keep = []
    for ln in text.splitlines():
        st = ln.strip()
        if not st or st.startswith(marker):
            continue
        keep.append(ln)
    return "\n".join(keep)


def syntax_ok(path):
    """(ok, detail). False only when a parser we actually ran rejected the file."""
    suf = path.suffix.lower()
    if suf in (".yml", ".yaml"):
        try:
            import yaml
        except ImportError:
            return True, "no yaml module — not checked"
        try:
            yaml.safe_load(path.read_text(errors="replace", encoding="utf-8"))
            return True, "yaml parses"
        except Exception as e:
            return False, f"yaml: {e}"
    if suf == ".json":
        import json
        try:
            json.loads(path.read_text(errors="replace", encoding="utf-8"))
            return True, "json parses"
        except Exception as e:
            return False, f"json: {e}"
    if suf == ".py":
        import ast
        try:
            ast.parse(path.read_text(errors="replace", encoding="utf-8"))
            return True, "python parses"
        except Exception as e:
            return False, f"python: {e}"
    cmd = SYNTAX_CHECK.get(suf)
    if cmd and cmd[0] == "bash":
        cmd = [bash_or_exit()] + cmd[1:]
    if not cmd:
        return True, f"no cheap parser for {suf or 'this file'} — not checked"
    try:
        r = subprocess.run(cmd + [str(path)], capture_output=True, text=True,
                           encoding="utf-8", errors="replace")
    except FileNotFoundError:
        return True, f"{cmd[0]} not installed — not checked"
    if r.returncode != 0:
        return False, (r.stdout + r.stderr).strip().splitlines()[:3]
    return True, f"{cmd[0]} accepts it"


def fail(msg):
    print(msg)
    sys.exit(2)


def write_source(path, text, newline="\n"):
    """Write text without letting Python translate its line endings.

    Path.write_text opens with newline=None, which rewrites every "\n" as
    os.linesep — CRLF on Windows. Two things then go wrong that look like
    something else: the mutant `finally` restore does not restore, it rewrites the
    file it was meant to put back; and every evidence append converts the task file
    it edits. Measured 2026-08-25 on windows-latest, where the restore check in
    tests/evidence-chain.test.mjs found the target changed after a REFUSED mutant.

    Writing bytes keeps whatever the file already used, so a CRLF file stays CRLF
    and an LF file stays LF.
    """
    path.write_bytes(source_bytes(text, newline))


def source_bytes(text, newline="\n"):
    """The exact bytes `write_source` would write. Shared so the restore journal
    can record the mutated file before it exists, rather than re-deriving the
    rule and drifting from it."""
    body = text.replace("\r\n", "\n")
    if newline != "\n":
        body = body.replace("\n", newline)
    return body.encode("utf-8")


def file_newline(path):
    """The line ending a file already uses, so a rewrite does not convert it."""
    try:
        return "\r\n" if b"\r\n" in path.read_bytes() else "\n"
    except OSError:
        return "\n"


def redact_home(block, home=None, platform=None):
    """Replace this machine's home directory with `~` before it reaches a task file.

    A failing fence's output is quoted verbatim into the Verification Log, and a
    stack trace or an assertion diff names absolute paths. In a repository that
    publishes its own corpus that puts the author's home directory — and their
    username — into a public commit. It happened on 2026-08-28: the fence proving
    ADR-008's boundary failed, and its excerpt carried the path into the task
    file, where the repository's own leak check caught it.

    BOTH SEPARATOR SPELLINGS, and case-insensitively where the filesystem is.
    A literal `str.replace` covered only the exact bytes, which on the one
    platform this cannot be developed on is the wrong spelling: Windows
    `Path.home()` returns `C:\\Users\\Example` while a Node stack trace in the same
    output prints it with forward slashes. Found by review, not a run.

    ANCHORED, so a sibling that merely shares the prefix keeps its name — a home
    of `/home/example` must not rewrite `/home/example-two` into `~-two`, which would
    corrupt evidence this was never asked to touch.

    A home that cannot be resolved, or that is a filesystem root, leaves the text
    alone: rewriting `/` would redact every path in the block.

    `home` and `platform` are injectable so the Windows spellings are testable
    from anywhere; they default to this machine.
    """
    if home is None:
        try:
            home = str(Path.home())
        except (RuntimeError, OSError, KeyError):
            return block
    if not home or home in ("/", "\\") or re.fullmatch(r"[A-Za-z]:[/\\]?", home):
        return block
    if platform is None:
        platform = sys.platform
    spellings = {home, home.replace("\\", "/"), home.replace("/", "\\")}
    pattern = "|".join(re.escape(s) for s in sorted(spellings, key=len, reverse=True))
    # Not followed by another path-name character: `/home/example` ends before `/x`
    # and before a quote, but `/home/example-two` does not end at all.
    flags = re.IGNORECASE if platform.startswith(("win32", "cygwin", "darwin")) else 0
    return re.sub(f"(?:{pattern})(?![A-Za-z0-9._-])", "~", block, flags=flags)


def append_entry(task, text, block, section="Verification Log"):
    block = redact_home(block)
    m = re.search(rf"(^## {re.escape(section)}\s*\n)(.*?)(?=^## |\Z)", text, re.M | re.S)
    if not m:
        # Say what to DO. "no ## Verification Log section" is accurate and left a
        # first-time reader guessing whether their file was malformed; the fix is
        # one empty heading, and the tool will not add it because writing a
        # section it was not asked for is how a tool starts editing documents
        # (docs/BACKLOG.md §70).
        fail(f"{task.name}: no ## {section} section — add an empty `## {section}` heading to the "
             f"task file and re-run. This tool appends entries; it does not create the section, "
             f"because a task file's shape is the author's.")
    sec = re.sub(r"^<Filled during execution:[^\n]*>\s*$", "", m.group(2), flags=re.M)
    # multi-line template placeholder: from '<Tool-written by' to the line ending in '>'
    sec = re.sub(r"^<Tool-written by.*?>\s*$", "", sec, flags=re.M | re.S)
    body = sec.strip("\n")
    new = m.group(1) + (body + "\n" if body else "") + block + "\n"
    tail = text[m.end():]
    write_source(task, text[:m.start()] + new + ("\n" + tail if tail else ""), file_newline(task))


def git_sha(cwd):
    """Short HEAD sha, `*`-suffixed when the tree is dirty; `no-git` outside a repo."""
    g = subprocess.run(["git", "-C", str(cwd), "rev-parse", "--short", "HEAD"],
                       capture_output=True, text=True, encoding="utf-8", errors="replace")
    if g.returncode != 0:
        return "no-git"
    sha = g.stdout.strip()
    d = subprocess.run(["git", "-C", str(cwd), "status", "--porcelain"],
                       capture_output=True, text=True, encoding="utf-8", errors="replace")
    return sha + ("*" if d.stdout.strip() else "")


def _restore_and_exit(signum, frame):
    """Turn SIGTERM into an unwind so the `finally` restore actually runs."""
    raise SystemExit(128 + signum)


def mutant_journal(cwd):
    """Where an in-flight mutant is recorded, OUTSIDE the repository it edits.

    A gate that runs in other people's repositories does not get to leave files
    in them, so this is keyed by the repository path rather than stored beside
    it. The key is a digest because a path is not a filename on any platform.
    """
    key = hashlib.sha256(str(Path(cwd).resolve()).encode("utf-8")).hexdigest()[:16]
    base = os.environ.get("CLAUDE_PLUGIN_DATA") or tempfile.gettempdir()
    return Path(base) / f"adr-verify-mutant-{key}.json"


JOURNAL_VERSION = 2
_WINDOWS_REPARSE_POINT = getattr(stat, "FILE_ATTRIBUTE_REPARSE_POINT", 0x0400)


def _path_key(path):
    """A local-platform identity key for duplicate transaction members."""
    return os.path.normcase(os.path.normpath(str(Path(path))))


def _is_linklike(path_stat):
    """True for a symlink or Windows reparse point in one lstat result.

    ``Path.is_junction`` arrived after the oldest Python this plugin supports.
    Windows has exposed ``st_file_attributes`` for longer, so its reparse bit is
    the compatibility seam. Non-Windows tests can exercise the same pure
    predicate with a synthetic stat result.
    """
    return stat.S_ISLNK(path_stat.st_mode) or bool(
        getattr(path_stat, "st_file_attributes", 0) & _WINDOWS_REPARSE_POINT
    )


def inspect_transaction_path(cwd, path):
    """Return (absolute path, problem) without following a link component.

    A missing leaf or intermediate directory is valid because a generator may
    create it. Only the leaf joins the transaction; undeclared parent directories
    remain outside its restore authority. The nearest existing ancestor still
    has to be an ordinary directory inside the declared root.
    """
    root = Path(cwd).resolve()
    candidate = Path(path)
    if not candidate.is_absolute():
        candidate = root / candidate
    candidate = Path(os.path.abspath(str(candidate)))
    try:
        relative = candidate.relative_to(root)
    except ValueError:
        return candidate, f"escapes the declared cwd {root}"
    if not relative.parts:
        return candidate, "names the cwd directory rather than a regular file"

    current = root
    for index, part in enumerate(relative.parts):
        current = current / part
        last = index == len(relative.parts) - 1
        try:
            path_stat = current.lstat()
        except FileNotFoundError:
            # Nothing below the first absent component can exist yet. The
            # existing prefix has already been checked without following links;
            # a later live restore walks the newly materialized prefix again.
            break
        except OSError as exc:
            return candidate, f"could not be inspected at {current}: {exc}"
        mode = path_stat.st_mode
        if _is_linklike(path_stat):
            return candidate, f"crosses a symlink, junction, or reparse point at {current}"
        if not last and not stat.S_ISDIR(mode):
            return candidate, f"has a non-directory parent at {current}"
        if last and not stat.S_ISREG(mode):
            return candidate, f"is not a regular file at {current}"

    try:
        candidate.resolve(strict=False).relative_to(root)
    except (OSError, ValueError):
        return candidate, f"resolves outside the declared cwd {root}"
    return candidate, None


def _portable_relative_parts(raw):
    """Repository-relative parts after checking both separator spellings."""
    text = str(raw)
    if not text:
        fail("--also-restore needs a non-empty repository-relative file path")
    if looks_absolute(text):
        fail(f"--also-restore refuses absolute path {text!r}; name a file relative to --cwd")
    portable = text.replace("\\", "/")
    pieces = portable.split("/")
    if any(piece == ".." for piece in pieces):
        fail(f"--also-restore refuses traversal in {text!r}; the transaction cannot leave --cwd")
    parts = [piece for piece in pieces if piece not in ("", ".")]
    if not parts:
        fail(f"--also-restore {text!r} names --cwd, which is a directory, not a generated file")
    return parts


def _same_file(left, right):
    """Same lexical path or, when both exist, the same filesystem object."""
    if _path_key(left) == _path_key(right):
        return True
    try:
        return Path(left).samefile(right)
    except (FileNotFoundError, OSError):
        return False


def secondary_members(cwd, target, declared):
    """Validate and snapshot every repeatable --also-restore value."""
    root = Path(cwd).resolve()
    members, seen = [], []
    for raw in declared:
        candidate, problem = inspect_transaction_path(root, root.joinpath(*_portable_relative_parts(raw)))
        if problem:
            fail(f"--also-restore {raw!r} {problem}")
        if _same_file(candidate, target):
            fail(f"--also-restore {raw!r} repeats the --mutant target; declare it only once")
        if any(_same_file(candidate, prior) for prior in seen):
            fail(f"--also-restore {raw!r} duplicates another generated output")
        try:
            existed = candidate.exists()
            original = candidate.read_bytes() if existed else None
        except OSError as exc:
            fail(f"--also-restore could not snapshot {raw!r}: {exc}")
        members.append({
            "role": "secondary",
            "path": str(candidate),
            "existed": existed,
            "original": base64.b64encode(original).decode("ascii") if existed else None,
        })
        seen.append(candidate)
    return members


def _member_original(member):
    return base64.b64decode(member["original"], validate=True) if member["existed"] else None


def restore_live_transaction(transaction, cwd):
    """Restore every currently safe member; return unresolved descriptions.

    Selection is intentionally one unique line. The mutation catalogue truncates
    it to the source member, and the generated-output CLI fixture must then fail.
    """
    unresolved = []
    members = transaction["members"]
    for member in members:
        path, problem = inspect_transaction_path(cwd, member["path"])
        if problem:
            unresolved.append(f"{member['path']}: {problem}")
            continue
        try:
            if member["existed"]:
                path.write_bytes(_member_original(member))
            elif path.exists():
                path.unlink()
        except (OSError, ValueError, KeyError) as exc:
            unresolved.append(f"{path}: restore failed: {exc}")
    return unresolved


def report_unresolved(journal, unresolved, context):
    print(f"[adr-verify] UNRESOLVED {context}: the transaction could not safely restore:")
    for item in unresolved:
        print(f"  - {item}")
    fail(f"[adr-verify] nothing uncertain was overwritten; the journal remains at {journal}. "
         f"Reconcile the named paths before verifying again.")


def _decode_v2_journal(data, cwd):
    """Validate v2 structure without changing any recorded path."""
    if not isinstance(data, dict) or data.get("version") != JOURNAL_VERSION:
        raise ValueError("unsupported journal version")
    if data.get("phase") not in ("baseline", "mutant"):
        raise ValueError("phase must be baseline or mutant")
    root = Path(cwd).resolve()
    recorded_root = data.get("cwd")
    if not isinstance(recorded_root, str) or _path_key(Path(recorded_root)) != _path_key(root):
        raise ValueError("recorded cwd does not match this recovery root")
    raw_members = data.get("members")
    if not isinstance(raw_members, list) or not raw_members:
        raise ValueError("members must be a non-empty list")

    members, seen, targets = [], set(), 0
    for raw in raw_members:
        if not isinstance(raw, dict):
            raise ValueError("every member must be an object")
        role, named, existed = raw.get("role"), raw.get("path"), raw.get("existed")
        if role not in ("target", "secondary") or not isinstance(named, str) or not named:
            raise ValueError("every member needs a target/secondary role and path")
        if type(existed) is not bool:
            raise ValueError(f"{named}: existed must be a boolean")
        path = Path(named)
        if not path.is_absolute():
            raise ValueError(f"{named}: recorded path is not absolute")
        lexical = Path(os.path.abspath(str(path)))
        try:
            lexical.relative_to(root)
        except ValueError:
            raise ValueError(f"{named}: recorded path escapes cwd")
        key = _path_key(lexical)
        if key in seen:
            raise ValueError(f"{named}: duplicate member")
        seen.add(key)
        if existed:
            if not isinstance(raw.get("original"), str):
                raise ValueError(f"{named}: existing member has no original bytes")
            try:
                original = base64.b64decode(raw["original"], validate=True)
            except Exception as exc:
                raise ValueError(f"{named}: invalid original bytes: {exc}")
        else:
            if raw.get("original") is not None:
                raise ValueError(f"{named}: absent member unexpectedly has original bytes")
            original = None
        member = {**raw, "path": str(lexical), "_original": original}
        if role == "target":
            targets += 1
            if not existed or not isinstance(raw.get("mutated"), str):
                raise ValueError("target needs original and prospective mutant bytes")
            try:
                member["_mutated"] = base64.b64decode(raw["mutated"], validate=True)
            except Exception as exc:
                raise ValueError(f"{named}: invalid mutant bytes: {exc}")
        members.append(member)
    if targets != 1:
        raise ValueError("journal must contain exactly one target")
    return data["phase"], members


def _entry_state(member, path):
    if member["existed"]:
        try:
            return path.exists() and path.read_bytes() == member["_original"]
        except OSError:
            return False
    return not path.exists()


def _recover_v2(journal, data, cwd):
    phase, members = _decode_v2_journal(data, cwd)
    unresolved, restored = [], []
    for member in members:
        path, problem = inspect_transaction_path(cwd, member["path"])
        if problem:
            unresolved.append(f"{member['path']}: {problem}")
            continue
        if phase == "baseline":
            if not _entry_state(member, path):
                unresolved.append(f"{path}: differs from its command-entry state after the clean fence")
            continue
        if member["role"] == "secondary":
            if not _entry_state(member, path):
                unresolved.append(f"{path}: generated bytes are not known to belong to the killed process")
            continue
        try:
            if not path.exists():
                unresolved.append(f"{path}: target is missing")
            else:
                current = path.read_bytes()
                if current == member["_original"]:
                    pass
                elif current == member["_mutated"]:
                    path.write_bytes(member["_original"])
                    restored.append(str(path))
                else:
                    unresolved.append(f"{path}: target differs from both known source states")
        except OSError as exc:
            unresolved.append(f"{path}: recovery failed: {exc}")

    if unresolved:
        report_unresolved(journal, unresolved, f"{phase} journal recovery")
    try:
        journal.unlink()
    except OSError as exc:
        fail(f"[adr-verify] transaction members are resolved but the journal could not be removed "
             f"({exc}); it remains at {journal}, so verification is blocked.")
    what = ", ".join(restored) if restored else "all members were already at entry state"
    print(f"[adr-verify] RESTORED transaction: {what}. The recovery journal is clear.")
    return "resolved"


def _recover_legacy(journal, data, cwd):
    """The one-target schema released before JOURNAL_VERSION existed."""
    try:
        named = data["file"]
        if not isinstance(named, str) or not named:
            raise ValueError("file must be a non-empty path")
        root_input = Path(os.path.abspath(str(cwd)))
        root = Path(cwd).resolve()
        recorded = Path(named)
        legacy_traversal = not recorded.is_absolute() and ".." in recorded.parts
        original = base64.b64decode(data["original"], validate=True)
        mutated = base64.b64decode(data["mutated"], validate=True)
        phase = data.get("phase", "mutant")
        if phase not in ("baseline", "mutant"):
            raise ValueError("phase must be baseline or mutant")
        candidates = []
        if recorded.is_absolute():
            # macOS commonly spells the same temporary root as both /var and
            # /private/var. Translate only the declared root prefix; resolving
            # the whole target here would follow exactly the in-tree symlink a
            # recovery must inspect and refuse.
            target = recorded
            try:
                target = root / target.relative_to(root_input)
            except ValueError:
                for ancestor in target.parents:
                    try:
                        if ancestor.resolve() == root:
                            target = root / target.relative_to(ancestor)
                            break
                    except OSError:
                        continue
            candidates.append(target)
        elif not legacy_traversal:
            # The old writer stored str(cwd / rel) without resolving cwd. That
            # produced both `file.py` for `--cwd .` and `repo/file.py` for
            # `--cwd repo`. Consider the repository-relative reading, the old
            # launch-directory reading, and a cwd prefix recoverable from the
            # canonical root. More than one contained identity is ambiguous;
            # matching bytes classify a chosen path's state, not its identity.
            candidates.extend((root / recorded, Path.cwd() / recorded))
            parts = recorded.parts
            root_parts = root.parts
            for count in range(1, len(parts)):
                if count <= len(root_parts) and all(
                        os.path.normcase(left) == os.path.normcase(right)
                        for left, right in zip(parts[:count], root_parts[-count:])):
                    candidates.append(root.joinpath(*parts[count:]))
    except Exception as exc:
        fail(f"[adr-verify] unreadable legacy mutant journal retained at {journal}: {exc}")

    if legacy_traversal:
        report_unresolved(journal,
                          [f"{named}: relative traversal has no safe legacy path identity"],
                          "legacy journal recovery")

    identities, outside, seen = [], [], set()
    for candidate in candidates:
        target, problem = inspect_transaction_path(root, candidate)
        key = _path_key(target)
        if key in seen:
            continue
        seen.add(key)
        try:
            target.relative_to(root)
        except ValueError:
            outside.append(f"{target}: {problem or 'escapes the declared cwd'}")
            continue
        if problem:
            state = problem
        else:
            try:
                if not target.exists():
                    state = "is missing"
                else:
                    current = target.read_bytes()
                    if current == original:
                        state = "matches the known original"
                    elif current == mutated:
                        state = "matches the known mutant"
                    else:
                        state = "differs from both known legacy states"
            except OSError as read_error:
                state = f"could not inspect candidate bytes: {read_error}"
        identities.append((target, problem, state))

    if len(identities) != 1:
        unresolved = [f"{path}: {state}" for path, _, state in identities] + outside
        report_unresolved(journal, unresolved or [f"{named}: no contained recovery candidate"],
                          "ambiguous legacy journal recovery")
    target, problem, _ = identities[0]
    if problem:
        report_unresolved(journal, [f"{target}: {problem}"], "legacy journal recovery")

    if not target.exists():
        before = "clean fence" if phase == "baseline" else "mutant run"
        report_unresolved(journal, [f"{target}: a killed {before} left the target missing"],
                          f"legacy {phase} journal recovery")

    try:
        now = target.read_bytes()
    except OSError as exc:
        fail(f"[adr-verify] legacy recovery could not read {target}; journal retained: {exc}")
    if now == original:
        journal.unlink(missing_ok=True)
        return "resolved"
    if phase == "baseline":
        report_unresolved(journal,
                          [f"{target}: a killed clean fence changed the target before mutation"],
                          "legacy baseline journal recovery")
    if now != mutated:
        kept = journal.with_name(journal.stem + "-original.txt")
        try:
            kept.write_bytes(original)
        except OSError:
            kept = None
        print(f"[adr-verify] a killed --mutant run left a mutant in {target}, but that file has "
              f"changed since, so nothing was overwritten.")
        if kept:
            print(f"[adr-verify] the pre-mutation content is at {kept} — compare before you commit.")
        report_unresolved(journal,
                          [f"{target}: differs from both known legacy source states"],
                          "legacy mutant journal recovery")

    target.write_bytes(original)
    journal.unlink(missing_ok=True)
    print(f"[adr-verify] RESTORED {target}: a previous --mutant run was killed before it could "
          f"put the file back. Check nothing was committed in between.")
    return "resolved"


def recover_mutant(cwd):
    """Resolve a durable journal, or stop before an ambiguous tree is measured."""
    journal = mutant_journal(cwd)
    if not journal.exists():
        return "absent"
    try:
        data = json.loads(journal.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        fail(f"[adr-verify] corrupt mutant journal retained at {journal}: {exc}. "
             f"Verification is blocked until it is reconciled.")
    if not isinstance(data, dict):
        fail(f"[adr-verify] corrupt mutant journal retained at {journal}: expected an object. "
             f"Verification is blocked until it is reconciled.")
    if "version" not in data:
        return _recover_legacy(journal, data, cwd)
    if data.get("version") != JOURNAL_VERSION:
        fail(f"[adr-verify] unknown mutant journal version {data.get('version')!r} retained at "
             f"{journal}. Verification is blocked until a compatible tool or person resolves it.")
    try:
        return _recover_v2(journal, data, cwd)
    except ValueError as exc:
        fail(f"[adr-verify] corrupt versioned mutant journal retained at {journal}: {exc}. "
             f"Verification is blocked until it is reconciled.")


def run_mutant(task, text, cmd, cwd, today, rel, frm, to, why, also_restore):
    """Break one mechanism, run the task's own fence, and record whether it noticed.

    Never returns — every path exits. The file is restored in `finally`, which
    covers a normal exit, an exception and a Ctrl-C, and a SIGTERM only because
    one is installed below to turn it into an unwind. It does NOT cover SIGKILL,
    which unwinds nothing. So the restore is also journalled to disk before the
    mutation lands, and the next run puts the file back. That mattered more than
    it sounds: the whole point is to run this on a clean tree, and the failure
    mode is silently committing a deliberate defect.
    """
    if frm is None or to is None:
        fail("--mutant needs --from <text> and --to <text> "
             "(use --to '' to delete). --why <text> is required too.")
    if not why or not why.strip():
        fail("--mutant needs --why '<what this mutant kills>' — a recorded mutant "
             "with no stated target is a row, not evidence.")

    # Check the destination BEFORE mutating anything. Discovered the hard way while
    # building this: a missing section surfaced only at append time, i.e. after the
    # file had been mutated and the whole fence had run. Nothing was lost (the
    # restore is in a `finally`), but doing minutes of work to report a one-line
    # authoring error is the wrong order.
    if not re.search(r"^## Mutation Log\s*$", text, re.M):
        fail(f"{task.name}: no ## Mutation Log section — add one (see "
             f"the bundled task-template.md) before recording mutants.")

    cwd = Path(cwd).resolve()
    target = Path(rel) if looks_absolute(rel) else (cwd / rel)
    if not target.exists():
        fail(f"--mutant file not found: {target}")
    target, target_problem = inspect_transaction_path(cwd, target)
    if target_problem:
        fail(f"--mutant target {rel!r} {target_problem}; a restore transaction cannot own it")

    # Kept as BYTES so the restore below is a restore, not a re-encode.
    original_bytes = target.read_bytes()
    original = original_bytes.decode("utf-8", errors="replace").replace("\r\n", "\n")
    target_newline = "\r\n" if b"\r\n" in original_bytes else "\n"

    # THE check this tool exists for. An edit that does not apply is the silent
    # no-op that reports a clean pass; an edit that applies in several places is
    # a different mutant than the one described.
    n = original.count(frm)
    if n == 0:
        fail(f"MUTANT DID NOT APPLY: --from text is not present in {rel}. "
             f"Nothing was run — a mutation that does not land proves nothing, "
             f"and reporting it as applied is how a decoration test survives.")
    if n != 1:
        fail(f"MUTANT NOT UNIQUE: --from text appears {n} times in {rel}. "
             f"Extend it until it selects exactly the one site you mean.")

    # A DIRECTIVE WEARS A COMMENT'S SYNTAX. `//go:build readcostspec` is lexically
    # a comment and semantically a build constraint: restoring it removes whole
    # test functions from compilation, which is a larger behavioural change than
    # most real mutants. The guard below classifies by SHAPE and cannot see that,
    # so it refused the strongest mutant a task whose deliverable IS the tag can
    # have — reported 2026-08-29 with a hand-verified repro where `go test -run`
    # exited 0 over a suite that executed nothing (docs/BACKLOG.md §67).
    #
    # The family is not Go-only: `// +build`, `//go:generate`, `//go:embed`,
    # `//go:linkname`, `//nolint`, `# type: ignore`, `# noqa`,
    # `// eslint-disable`, `/* istanbul ignore */`, a shebang. Several are
    # exactly what a campaign most wants to test, because a coverage-suppression
    # pragma is a mechanism whose whole job is to make something invisible.
    #
    # Deliberately a LIST rather than a heuristic: "a comment whose first token
    # ends in a colon" would swallow ordinary prose, and this guard exists to
    # refuse mutants, so a loose exemption silently re-opens the hole it closes.
    if DIRECTIVE_COMMENT.search(frm) or DIRECTIVE_COMMENT.search(to):
        pass
    elif (marker := LINE_COMMENT.get(target.suffix.lower())) and \
            strip_comments(frm, marker) == strip_comments(to, marker):
        fail(f"COMMENT-ONLY MUTANT: in {rel} this edit changes only comments or "
             f"blank lines, so it changes nothing the program does. A test cannot "
             f"be expected to notice it, and a 'survived' verdict here would be "
             f"about the mutant, not the test.")

    mutated_bytes = source_bytes(original.replace(frm, to, 1), target_newline)
    members = [{
        "role": "target",
        "path": str(target),
        "existed": True,
        "original": base64.b64encode(original_bytes).decode("ascii"),
        "mutated": base64.b64encode(mutated_bytes).decode("ascii"),
    }]
    members.extend(secondary_members(cwd, target, also_restore))

    verdict, code, detail = "inconclusive", 2, ""
    journal = mutant_journal(cwd)
    previous = None
    cleanup_failure = None
    journal_data = {
        "version": JOURNAL_VERSION,
        "phase": "baseline",
        "cwd": str(cwd),
        "members": members,
        "from": frm, "to": to, "why": why.strip(), "cmd": cmd,
    }

    # The journal protects the CLEAN run too: an Acceptance fence may generate or
    # rewrite the target before a mutant is ever applied. If this write cannot be
    # made, no fence is allowed to start. Continuing would knowingly open a
    # side-effect window with no recovery record.
    try:
        journal.parent.mkdir(parents=True, exist_ok=True)
        journal.write_text(json.dumps(journal_data), encoding="utf-8")
    except OSError as e:
        try:
            journal.unlink(missing_ok=True)
        except OSError:
            pass
        fail(f"[adr-verify] could not arm the mutant journal ({e}); refusing before the "
             f"clean fence. No mutation was applied and no evidence was written.")

    try:
        # Python default-terminates on SIGTERM without unwinding, so `finally`
        # never runs. Measured 2026-08-27: SIGINT restored, SIGTERM and SIGKILL
        # did not. Turning it into SystemExit gives the restore its chance;
        # SIGKILL still cannot be caught, which is what the journal is for.
        try:
            previous = signal.signal(signal.SIGTERM, _restore_and_exit)
        except (OSError, ValueError, AttributeError):
            previous = None

        # A failure that already exists cannot be donated to the mutant. Run the
        # exact normalized fence first, with the same shell, cwd, environment and
        # timeout the mutant will receive. This guard is deliberately one unique
        # branch: the mutation catalogue disables it and the CLI regression must
        # then catch the false verdict.
        try:
            clean = subprocess.run([bash_or_exit(), "-c", cmd], cwd=cwd, capture_output=True,
                                   text=True, encoding="utf-8", errors="replace",
                                   timeout=fence_timeout())
        except subprocess.TimeoutExpired as expired:
            partial = decode_stream(expired.stdout) + decode_stream(expired.stderr)
            print(f"[adr-verify] UNPROVEN: the clean acceptance fence did not finish within "
                  f"{fence_timeout()}s. No mutant was applied and no Mutation Log row was "
                  f"written.")
            if partial.strip():
                print("[adr-verify] what the clean fence had produced when it was killed:")
                for line in partial.strip().splitlines()[-10:]:
                    print(f"  {line}")
            sys.exit(1)

        clean_out = (clean.stdout or "") + (clean.stderr or "")
        clean_usable = clean.returncode == 0 and not scored_nothing(clean_out)
        if not clean_usable:
            machine_reason = environment_failure(clean_out, cmd)
            if machine_reason:
                observed = f"the clean fence failed for a machine reason: {machine_reason}"
            elif clean.returncode != 0:
                observed = f"the clean fence exited {clean.returncode} before any mutant ran"
            else:
                observed = "the clean fence exited 0 but reported that no tests ran"
            print(f"[adr-verify] UNPROVEN: {observed}. No mutant was applied and no Mutation "
                  f"Log row was written.")
            for line in failure_tail(clean.stdout, clean.stderr):
                print(f"  {line}")
            sys.exit(1)

        # The baseline itself may have materialized outputs. Re-establish the
        # complete command-entry state, then advance the durable phase BEFORE
        # changing the source. The mutant fence must generate its own outputs.
        cleanup_failure = restore_live_transaction(journal_data, cwd)
        if cleanup_failure:
            report_unresolved(journal, cleanup_failure, "cleanup after the clean fence")
        cleanup_failure = None
        journal_data["phase"] = "mutant"
        try:
            journal.write_text(json.dumps(journal_data), encoding="utf-8")
        except OSError as e:
            fail(f"[adr-verify] could not advance the mutant journal ({e}); refusing before "
                 f"mutation. The clean fence ran, but no evidence was written.")

        write_source(target, original.replace(frm, to, 1), target_newline)

        # Said BEFORE the fence runs, because the fence is the part that gets
        # killed. Whatever else is lost, the transcript then names the file that
        # was deliberately broken — the only recovery that survives a SIGKILL.
        # flush=True is the whole point of saying it here. Redirected stdout is
        # block-buffered, so without this the warning sits in the buffer and dies
        # with the process — measured 2026-08-27, both kill probes produced an
        # EMPTY log. A notice that survives only when nothing goes wrong is not a
        # notice.
        print(f"[adr-verify] MUTANT APPLIED to {rel}: this file is deliberately broken "
              f"until the fence finishes.", flush=True)
        print(f"[adr-verify] if this run is killed, restore it with `adr-verify --restore "
              f"--cwd {cwd}`, or `git checkout -- {rel}`.", flush=True)

        ok, why_not = syntax_ok(target)
        if not ok:
            print(f"[adr-verify] the mutant does not parse: {why_not}")
            print("[adr-verify] a mutant that does not build has NOT been tested — it has "
                  "been skipped. Rewrite it so it still parses.")
            sys.exit(2)

        try:
            r = subprocess.run([bash_or_exit(), "-c", cmd], cwd=cwd, capture_output=True,
                               text=True, encoding="utf-8", errors="replace",
                               timeout=fence_timeout())
        except subprocess.TimeoutExpired:
            # The mutant is still applied, so the restore below is what matters —
            # `finish()` runs it. UNRUN, not survived and not killed: a fence that
            # never returned observed nothing about the mechanism.
            fail(f"UNRUN: the fence did not finish within {fence_timeout()}s with the "
                 f"mutant applied, so nothing was learned about whether the tests notice it. "
                 f"The file has been restored.")
        out, code = r.stdout + r.stderr, r.returncode

        if code == 0:
            verdict, detail = (
                "survived",
                "the fence passed with the mechanism broken; it may not materialize, compile, "
                "load, or assert on the changed path",
            )
        elif abnormal_termination(code, out):
            verdict, detail = "inconclusive", "the fence terminated abnormally, not on an assertion"
        elif scored_nothing(out):
            # The already-measured clean fence passed and scored tests. If the
            # mutant run now reports none, the mutation removed the runnable lane.
            verdict = "killed"
            detail = ("the mutant fence failed scoring no tests, while the clean fence passed "
                      "scoring tests — so the mutant is what removed them")
        elif any(re.search(pat, out, re.M) for pat in BUILD_BROKE):
            verdict, detail = "inconclusive", "the fence failed on a build/parse error, not an assertion"
        elif environment_failure(out, cmd):
            # A FALSE KILL was reachable here and predates the baseline below: a
            # fence whose runner is absent exits 127 with output that scores
            # nothing this gate recognises, matches no BUILD_BROKE pattern, and
            # fell straight through to "a test went red". Measured 2026-08-29
            # with `nosuchrunner` as the fence — recorded `mutant killed`, which
            # credits a suite with catching something it never ran
            # (docs/BACKLOG.md §71). Crediting an unearned kill is the worst
            # outcome this tool has, because the whole point of a mutation is to
            # find out whether anything NOTICED.
            verdict, detail = "inconclusive", "the fence failed for a machine reason"
        else:
            verdict, detail = "killed", "a test went red"
    finally:
        if cleanup_failure is None:
            cleanup_failure = restore_live_transaction(journal_data, cwd)
        if previous is not None:
            try:
                signal.signal(signal.SIGTERM, previous)
            except (OSError, ValueError):
                pass
        if cleanup_failure:
            report_unresolved(journal, cleanup_failure, "live cleanup")
        try:
            journal.unlink(missing_ok=True)
        except OSError as exc:
            fail(f"[adr-verify] restored every transaction member but could not remove the "
                 f"journal ({exc}); no Mutation Log row was written and {journal} remains.")

    digest = acceptance_digest(cmd)
    sha = git_sha(cwd)
    entry = (f"- {today} · {sha} · mutant {verdict} · exit {code} · "
             f"`{rel}` · {why.strip()} · acceptance-sha256:{digest}")
    refuse_unreadable(entry, sha)
    block = entry
    if verdict != "killed":
        block += f"\n  ```\n  {detail}\n  ```"
    append_entry(task, task.read_text(errors="replace", encoding="utf-8"), block, section="Mutation Log")
    print(block)
    if verdict != "killed":
        # The tool's own exit code, said in the sentence that says the run
        # failed. A survivor's recorded row legitimately contains `exit 0` — that
        # is the FENCE's code, and a fence exiting 0 with the mechanism broken is
        # the definition of a survivor — but it sits four characters from `mutant
        # survived`, so a reader scanning for an exit code finds that one. A
        # session grepping its own runs concluded this tool exits 0 on a survivor
        # and reported it; it exits 1 and always has (docs/BACKLOG.md §63). The
        # grammar of the row is right and is not reordered for this; the remedy
        # is that the verdict line names its own status.
        print(f"[adr-verify] NOT evidence: {detail}. Only `killed` counts "
              f"(adr-verify exits 1; the `exit 0` in the row above is the FENCE's code, "
              f"which is what a survivor means).")
    sys.exit(0 if verdict == "killed" else 1)



def write_human_mutant(task, text, cwd, today, target, frm, to, test, test_exit, why):
    """Record a mutation a PERSON performed, for a fence that cannot run.

    This mode executes NOTHING, which is its premise rather than a limitation: it
    exists because `--mutant` cannot run the Acceptance fence at all. What it can
    still do is make the claim CHECKABLE, and that is the whole trade — a reader
    who cannot trust that a tool observed the kill can at least re-apply the diff
    and re-run the named test.

    So the tool refuses anything it cannot verify about the report itself:

    - the from-text must occur EXACTLY ONCE in the named file. Reported by wcag-43
      before the lane shipped: the most natural mutations sit on the most common
      lines (`return nil`, `if err != nil {`), and "from `return nil`" in a
      400-line file identifies nothing. Such a row parses and is still
      unreproducible, which is the exact property the refusals exist to prevent.
    - the LINE NUMBER is derived here, never typed. A typed one is a second thing
      that can be wrong, and uniqueness already computes it.
    - `--test-exit` must be non-zero, the same constraint the tool arm's `exit`
      carries. A kill claimed on a passing test is refused on its face.

    What it cannot check, and does not pretend to: that the diff was ever applied.
    Nothing observed it. ADR-013 records that as the cost of the lane.
    """
    path = Path(target) if looks_absolute(target) else (cwd / target)
    if not path.exists():
        fail(f"--human-mutant file not found: {target}")
    body = path.read_text(errors="replace", encoding="utf-8")
    hits = body.count(frm)
    if hits == 0:
        fail(f"--from matches nothing in {target}: a row naming a change that is not there "
             f"is not evidence. Paste the line exactly as it appears in the file.")
    if hits > 1:
        fail(f"--from matches {hits} places in {target}, so the row would identify none of "
             f"them. Quote enough of the line to be unique — a reader has to be able to "
             f"apply this diff without guessing which occurrence you meant.")
    # `--from` uniqueness makes the row LOCATABLE; `--to` absence makes it
    # REVERSIBLE. Reported by wcag-43 after checking their own founding case: if
    # the to-text is already in the file, a reader who applies this row cannot
    # afterwards tell whether it was applied or reverted, and a second reader
    # re-applying it double-mutates. Same read of the same file, so it is free.
    if to and to in body:
        fail(f"--to is already present in {target}, so a reader could not tell afterwards "
             f"whether this mutation had been applied or reverted -- and a second reader "
             f"re-applying it would double-mutate. Quote enough of the line that the "
             f"mutated form is not already there.")
    line = body[:body.index(frm)].count("\n") + 1
    rel = relative_to_repo(path, cwd)
    entry = (f"- {today} · human-observed · mutant killed · test exit {test_exit} · "
             f"`{rel}` · line {line} · from {span(frm)} · to {span(to)} · "
             f"test `{test.strip()}` · {why.strip()}")
    refuse_unreadable(entry, "human-observed")
    append_entry(task, text, entry, section="Mutation Log")
    print(entry)
    print(f"[adr-verify] NOTHING WAS RUN. This row records what you report having observed: "
          f"the diff above, applied at {rel}:{line}, and `{test.strip()}` returning "
          f"{test_exit}. It is checkable because a reader can repeat it — that is what this "
          f"lane trades for the tool-written guarantee it cannot give.")
    sys.exit(0)


def span(text):
    """`text` as a Markdown code span whose delimiter is longer than any run inside it.

    Markdown's own rule, reused rather than invented: a run of N backticks
    delimits content containing runs of fewer than N. Without it a mutated line
    holding a backtick cannot be written at all, and Go raw strings, JS template
    literals, shell and Markdown make that routine in what this plugin ships to.
    """
    longest = max((len(m) for m in re.findall(r"`+", text)), default=0)
    fence = "`" * (longest + 1)
    pad = " " if text.startswith("`") or text.endswith("`") else ""
    return f"{fence}{pad}{text}{pad}{fence}"


def relative_to_repo(path, cwd):
    """The path as the corpus names it: repo-relative with forward slashes.

    Never a separator typed into a literal (CLAUDE.md §7) — `relative_to` then
    `as_posix()`, so the row reads identically on all three platforms.
    """
    try:
        return path.resolve().relative_to(Path(cwd).resolve()).as_posix()
    except ValueError:
        return path.as_posix()



# --- --sweep: re-check the corpus's own claims (ADR-010) ---------------------

# A claim is one distinct (task file, acceptance digest) pair carrying an exit-0
# Verification Log entry. Only the digest is read from the line: the command is
# NOT recorded — the entry keeps the fence's first line and a hash of the whole
# thing — so re-running a claim means running the task's CURRENT fence, and the
# digest is what says whether that is the same command the entry proved.
# The sha field, mirrored from adr-lint::SHA_FIELD and pinned to it by
# tests/gate-regressions.py::SHA_GRAMMAR. 4 to 64 hex is what git can actually
# produce: `core.abbrev` goes down to 4, and a SHA-256 repository emits 64.
SHA_FIELD = r"(?:[0-9a-f]{4,64}\*?|no-git)"
CLAIM_RE = re.compile(
    r"^- \d{4}-\d{2}-\d{2} · " + SHA_FIELD + r" · exit 0 · "
    r"`[^`]+` · acceptance-sha256:(?P<digest>[0-9a-f]{64})\s*$", re.M)

# Every shape this tool writes, as the readers will see it. Kept beside
# CLAIM_RE so the writer and its own sweep cannot describe an entry
# differently.
ENTRY_RE = re.compile(
    r"^- \d{4}-\d{2}-\d{2} · (?:" + SHA_FIELD + r" · exit \d+ · `[^`]+`|"
    r"human-observed · mutant killed · test exit [1-9]\d* · `[^`]+` · line [1-9]\d* · "
    # Bounded, backreference-free code spans — the same shape adr-lint reads, and
    # for the same reason: the backreferenced version is catastrophically slow on
    # input it rejects (see adr-lint::_code_span).
    r"from (?:`[^`\n]+`|``(?:[^`\n]|`(?!`))+``|```(?:[^`\n]|`(?!``))+```) · to (?:`[^`\n]*`|``(?:[^`\n]|`(?!`))*``|```(?:[^`\n]|`(?!``))*```) · "
    r"test `[^`]+` · .+?|"
    r"human-observed · .+|" + SHA_FIELD + r" · mutant \w+ · exit \d+ · `[^`]+` · .+?)"
    r"(?: · acceptance-sha256:[0-9a-f]{64})?$")


def refuse_unreadable(entry, sha):
    """Refuse to write an entry the readers cannot parse, and say what to do.

    The one place the writer is held to the readers' grammar. Without it, a
    corpus with an unusual `core.abbrev` gets a log line every gate treats as
    absent — and a `done` row pointing at absent evidence is a BLOCKING adr-lint
    finding, so the tool bricks the record it was recording.

    A refusal is the right shape rather than a silent widening: this cannot know
    whether the reader on the other side has been updated, and writing something
    it can parse but adr-lint cannot would move the failure one step later.
    """
    if readable_entry(entry):
        return
    fail(f"refusing to write an entry the evidence grammar cannot read: `{entry}`. "
         f"The sha field is `{sha}` — git's `core.abbrev` decides its width, and this "
         f"grammar accepts 4 to 64 hex characters (or `no-git`). Set `core.abbrev` to a "
         f"width in that range, or update SHA_FIELD in both gates together.")


def readable_entry(entry):
    """Whether an entry this tool is about to write can be read back.

    The width of the sha is decided by `core.abbrev`, in a config file this
    tool does not own, so widening the readers closes today's gap and THIS is
    what closes the next one. An entry the grammar cannot parse is refused
    rather than written: a log line nothing can read is worse than no line,
    because the `done` row it was written for then points at evidence that
    reads as absent, and adr-lint blocks on exactly that.
    """
    return bool(ENTRY_RE.match(entry.strip()))

_UNSET = object()
# A fence that hangs holds the session forever, and `capture_output` means it
# holds the OUTPUT too — a hang produces nothing at all to read, which is worse
# than a slow failure. `sweep_corpus` has always passed a timeout; the recording
# runs did not, so three call sites carried two contracts (docs/BACKLOG.md §54).
# Generous, because a real acceptance suite is allowed to be slow: this is the
# line between "slow" and "never returning", not a performance budget.
FENCE_TIMEOUT_DEFAULT = 1800


def fence_timeout(env=None):
    """Seconds before a recording fence is called hung, as a PARAMETER.

    A branch reachable only after thirty minutes is a branch with no test, and
    this project's own rule is to make the awkward thing injectable rather than
    to trust it (CLAUDE.md §7, written about platforms and true of clocks).
    `QUALITY_HARNESS_FENCE_TIMEOUT` is that seam: the suite sets it to a couple of
    seconds and asserts the UNRUN path end to end.

    A value that is not a positive integer is IGNORED rather than honoured — a
    typo must not silently disable the timeout, which would restore the hang this
    exists to bound.
    """
    raw = (env if env is not None else os.environ).get("QUALITY_HARNESS_FENCE_TIMEOUT")
    if raw is None:
        return FENCE_TIMEOUT_DEFAULT
    try:
        seconds = int(str(raw).strip())
    except ValueError:
        return FENCE_TIMEOUT_DEFAULT
    return seconds if seconds > 0 else FENCE_TIMEOUT_DEFAULT

SWEEP_TIMEOUT_DEFAULT = 900

# A nested sweep refuses ITSELF. The substring check on a fence is evadable —
# bash turns `--swee''p` into `--sweep`, so the text can invoke this mode without
# containing it — and no amount of reading the fence fixes that, because the
# shell decides what the words are. An inherited environment variable is decided
# by the process, not by its spelling.
# It carries the CORPUS being swept, not a boolean. A boolean was inherited by
# the whole process tree, so a fence running a test suite that legitimately
# exercises --sweep over its own temp fixtures was refused as recursive — three
# real claims in this repository left the denominator that way, which is the
# direction that flatters the rate. Recursion is a sweep of a corpus an ancestor
# is ALREADY sweeping; a sweep of somewhere else is just a nested tool call.
SWEEP_REENTRY_ENV = "QUALITY_HARNESS_SWEEPING"
SWEEP_REENTRY_MARKER = "[adr-verify] refusing to sweep from inside a sweep"


CONFIG_NAME = ".quality-harness.json"


def git_says(args, cwd):
    """`git <args>` in cwd, or None when git cannot be run or has nothing to say.

    Every git probe the sweep makes goes through here. Without it a machine with
    no git on PATH ended the whole run in a traceback before a single claim was
    classified — and the sweep's job is to say what it could not check, not to
    fall over when the answer is "all of it".
    """
    try:
        r = subprocess.run(["git", "-C", str(cwd), *args], capture_output=True,
                           text=True, encoding="utf-8", errors="replace")
    except OSError:
        return None
    return r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else None


def strict_from_number(start):
    """The ADR number at which a false success starts failing, and why not.

    Returns `(number|None, note|None)`. THE SAME resolution `adr-lint` uses, and
    duplicated for the same stated reason `normalize_acceptance` is: these gates
    are standalone scripts with no import path between them. The record names
    that duplication rather than calling it a reshape, and the parity cases —
    malformed config, absent config, a value naming no number — are tested here
    because two copies that disagree are worse than one.

    Every failure to resolve is a NOTE, never a silent demotion. A config this
    tool cannot read must not quietly become an amnesty.
    """
    root = git_says(["rev-parse", "--show-toplevel"], start)
    if root is None:
        return None, None
    config = Path(root) / CONFIG_NAME
    if not config.exists():
        return None, None
    try:
        declared = json.loads(config.read_text(encoding="utf-8", errors="replace")).get("strictFrom")
    except Exception as exc:
        return None, (f"{CONFIG_NAME} could not be read ({exc.__class__.__name__}); "
                      f"every record is checked in full")
    if declared is None:
        return None, None
    m = re.search(r"(\d+)", str(declared))
    if not m:
        return None, (f"{CONFIG_NAME}: strictFrom={declared!r} names no ADR number; "
                      f"write it as `ADR-0012` or `12`. Every record is checked in full")
    return int(m.group(1)), None


def record_number_of(task):
    """The ADR number of the record that OWNS this task, or None when it has none.

    None is NOT "below the cutoff". A record named outside the ADR-NNN convention
    has no number to compare, and demoting it would be silent and permanent —
    the direction of that mistake is the one nobody ever notices.

    THE OWNING RECORD, not any ancestor that looks like one. This scanned every
    path component in reverse, so a task under `~/adr-42-notes/proj/probe/tasks/`
    resolved as ADR-42 and was judged against a cutoff it has nothing to do with —
    a number read from somebody's directory name. The owning record is the
    directory the `tasks/` directory sits in, and its number is read the way
    `adr-lint::adr_number` reads it: the record's own title first, then its name.
    One rule, two call sites, pinned by tests/gate-regressions.py.
    """
    directory = task.resolve().parent
    if directory.name.lower() == "tasks":
        directory = directory.parent
    record = directory.with_suffix(".md")
    if record.is_file():
        title = re.search(r"^#\s+ADR[-_ ]?(\d{1,4})\b",
                          record.read_text(errors="replace", encoding="utf-8"), re.M | re.I)
        if title:
            return int(title.group(1))
    name = re.search(r"(?:adr[-_]?)?(\d{3,4})[-._]", directory.name, re.I)
    return int(name.group(1)) if name else None


def demoted_by(number, cutoff):
    """Whether a record's findings are advisory under `strictFrom`.

    Spelled out because `(record_number_of(t) or cutoff) < cutoff` could not say
    "this record is number zero": `0 or cutoff` is `cutoff`, so ADR-000 read as
    having no number at all. That erred STRICT — an unnumbered record is checked
    in full — so nothing was ever demoted wrongly by it. It is still wrong, and
    the reason to fix it is that the next reader of that line has to work out
    which direction it fails in before they can trust it.
    """
    if cutoff is None:
        return False
    if number is None:
        # A record named outside the convention has nothing to compare, and
        # demoting it would be silent and permanent.
        return False
    return number < cutoff


def fence_cwd(task):
    """Where a recorded fence must run: the git root of the task file, else its directory.

    THE SAME resolution the recording path uses, and it has to be. A fence is
    written against the tree it was recorded in — `bash scripts/selftest.sh`,
    `node --test tests/x.test.mjs` — so running it from the task's own directory
    measures a command nobody ever ran. Measured 2026-08-28 on this repository's
    corpus before the fix: two claims reported FALSE with exit 127, purely because
    the sweep stood in the wrong directory, and 127 is exactly the shape a real
    regression does not have.
    """
    root = git_says(["rev-parse", "--show-toplevel"], task.parent)
    return Path(root) if root else task.parent


def claims_in(task):
    """The distinct digests this task file records an exit-0 entry for.

    A `human-observed` entry is not a claim: it carries no digest, so there is
    nothing to re-check and nothing to be right or wrong about. A non-zero entry
    is not a claim either — it is TDD-red evidence, and this project keeps it on
    purpose.
    """
    section = re.search(r"^## Verification Log\s*\n(.*?)(?=^## |\Z)",
                        task.read_text(errors="replace", encoding="utf-8"), re.M | re.S)
    if not section:
        return set()
    return {m.group("digest") for m in CLAIM_RE.finditer(section.group(1))}


def sweep_corpus(root, timeout=SWEEP_TIMEOUT_DEFAULT, as_json=False, shell=_UNSET):
    """Re-check every claim under `root` and report what stopped being true.

    Four buckets, and they are disjoint and total by construction — every claim
    takes exactly one branch below, so a claim can never be invisible:

      held         the digest matches the current fence and it exits 0
      false        the digest matches and it fails on its OWN terms
      superseded   the digest does not match — including when there is no fence
      unrunnable   it could not be checked: no shell, refused, timed out, or the
                   failure was environmental

    Superseded and unrunnable are in NEITHER half of the ratio, which is ADR-006's
    UNPROVEN and ADR-005's UNRUN wearing a third name. A claim that could not be
    re-checked is never counted as a claim that held.

    This writes nothing. It is the read-only half of a tool whose other half
    appends evidence, and `tests/sweep.test.mjs` asserts the corpus is
    byte-identical afterwards rather than trusting this sentence.
    """
    tasks = sorted(q for q in Path(root).rglob("*.md") if q.is_file())
    # Injectable, and the reason is the tri-platform rule this project wrote down
    # the same day it broke it: emptying PATH removes bash on POSIX and removes
    # nothing on Windows, where resolve_bash() finds Git Bash by absolute path.
    # A no-shell test built on PATH therefore asserts an operating system rather
    # than a behaviour. The seam lets one test cover all three.
    if shell is _UNSET:
        shell = resolve_bash()
    cutoff, config_note = strict_from_number(Path(root))
    held, false, superseded, unrunnable = [], [], [], []

    for task in tasks:
        digests = claims_in(task)
        if not digests:
            continue
        text = task.read_text(errors="replace", encoding="utf-8")
        fence = acceptance_of(text)
        current = acceptance_digest(normalize_acceptance(fence)) if fence else None
        for digest in sorted(digests):
            if fence is not None and runs_nothing(fence):
                superseded.append((task, "its Acceptance fence runs nothing, so it proves nothing"))
                continue
            if digest != current:
                # Nothing to compare against is the same answer as "does not
                # match": either way this entry proved a command that is not the
                # one in front of us, and re-running the current fence would
                # measure something the entry never claimed.
                superseded.append((task, "the fence has changed since" if fence
                                   else "the task has no Acceptance fence"))
                continue
            # No substring check on the fence. There was one, and it was both
            # evadable and wrong in the other direction: bash turns --swee''p
            # into --sweep so it missed the real case, and it refused a fence
            # that legitimately sweeps a DIFFERENT corpus — a test suite over its
            # own fixtures — which cost three real claims their place in the
            # denominator. The corpus-scoped sentinel above answers both, because
            # it is decided by the process rather than by the spelling.
            if shell is None:
                unrunnable.append((task, "no usable shell was found to run it"))
                continue
            try:
                # stdin is /dev/null because a fence that reads it is waiting for
                # input nobody will type. NOT provable by a test from here: the
                # runner hands its children an empty stdin, so `cat` exits at once
                # either way, and the catalogue carries no mutation for this line.
                # It is defensive, and saying so beats implying a proof.
                #
                # Output to FILES, not pipes. A fence that backgrounds anything —
                # `(sleep 60 &)` — leaves a grandchild holding the inherited pipe,
                # so capture_output waits for a process the fence itself finished
                # with, and the run burns the whole timeout for nothing. Measured
                # 2026-08-28: 15s for a fence that exited immediately. Files also
                # bound memory when a fence prints a great deal.
                chain = os.environ.get(SWEEP_REENTRY_ENV, "")
                child_env = dict(os.environ, **{SWEEP_REENTRY_ENV:
                    (chain + os.pathsep if chain else "") + str(Path(root).resolve())})
                with tempfile.TemporaryFile() as out, tempfile.TemporaryFile() as err:
                    r = subprocess.run([shell, "-c", fence], cwd=str(fence_cwd(task)),
                                       env=child_env, stdin=subprocess.DEVNULL,
                                       stdout=out, stderr=err, timeout=timeout)
                    out.seek(0); err.seek(0)
                    r = subprocess.CompletedProcess(
                        r.args, r.returncode,
                        out.read().decode("utf-8", "replace"),
                        err.read().decode("utf-8", "replace"))
            except subprocess.TimeoutExpired:
                unrunnable.append((task, f"it did not finish within {timeout}s"))
                continue
            except OSError as exc:
                # resolve_bash() returns a bare "bash" on POSIX without checking
                # that it exists, so launching can raise FileNotFoundError — and
                # an uncaught OSError ended the whole sweep in a traceback with
                # every remaining claim unclassified. A claim we could not launch
                # is one we could not check.
                unrunnable.append((task, f"it could not be launched ({exc.__class__.__name__})"))
                continue
            if r.returncode == 0 and scored_nothing(r.stdout + r.stderr):
                # The same rule the recording path applies: a filter that matches
                # nothing is not a passing gate. Without this, deleting the tests
                # a claim was about turns it from held into... still held.
                false.append((task, "exit 0, scored no tests"))
                continue
            if r.returncode == 0:
                held.append(task)
                continue
            if SWEEP_REENTRY_MARKER in (r.stdout + r.stderr):
                unrunnable.append((task, "its fence invoked the sweep; running it would recurse"))
                continue
            diagnosis = environment_failure(r.stdout + r.stderr, fence)
            if diagnosis and not scored_anything(r.stdout + r.stderr):
                # environment_failure() alone is not enough, and the difference
                # matters: it exists never to downgrade a failure, and here it
                # downgrades one. A suite that RAN and failed is a verdict about
                # the code however its output reads, so a real failure whose text
                # merely contains an environment string must not escape.
                unrunnable.append((task, diagnosis))
            else:
                false.append((task, r.returncode))

    checked = len(held) + len(false)
    # The cutoff decides the EXIT CODE and nothing else. Every false success is
    # still counted and still printed, so a corpus cannot use strictFrom to make
    # one disappear — only to say "not mine to fix today".
    demoted = [t for t, _ in false if demoted_by(record_number_of(t), cutoff)]
    if as_json:
        print(json.dumps({
            "claims": checked + len(superseded) + len(unrunnable),
            "held": len(held), "false": len(false),
            "superseded": len(superseded), "unrunnable": len(unrunnable),
            "false_claims": [str(t) for t, _ in false],
        }, indent=2))
    else:
        if config_note:
            print(f"[adr-verify] {config_note}")
        for task, code in false:
            mark = " [strictFrom]" if task in demoted else ""
            print(f"FALSE      exit {code} · {task}{mark}")
        for task, why in superseded:
            print(f"superseded {task} — {why}")
        for task, why in unrunnable:
            print(f"unrunnable {task} — {why}")
        if checked == 0:
            # 0/0 is not a clean bill of health. A corpus this tool could not
            # find a single re-checkable claim in has told us nothing, and saying
            # "0 false" would be the vacuity ADR-003 forbids.
            print(f"\nNo claim in {root} could be re-checked "
                  f"({len(superseded)} superseded, {len(unrunnable)} unrunnable). "
                  f"There is no rate to report.")
        else:
            demotion = (f" {len(demoted)} of them are below the strictFrom cutoff "
                        f"(ADR-{cutoff:03d}) and are reported as advice."
                        if demoted else "")
            print(f"\n{len(false)}/{checked} recorded claims no longer hold "
                  f"({len(superseded)} superseded, {len(unrunnable)} unrunnable, "
                  f"neither counted).{demotion}")
    if checked == 0:
        return 1
    # Only findings the cutoff does not cover can fail the run.
    return 1 if [t for t, _ in false if t not in demoted] else 0


def scored_anything(output):
    """Whether the run reports having actually executed tests.

    The inverse of `scored_nothing`'s second half, reused so the two answers
    cannot drift: if a runner says it ran something, the failure is the code's.
    """
    return any(re.search(p, output, re.M) for p in SOMETHING_RAN)


def acceptance_of(text):
    """The ```bash fence under ## Acceptance, or None.

    THE SAME two-step the recording path uses, and it has to be. This was one
    regex demanding the fence immediately after the heading, while the writer
    takes the whole section and then finds the fence inside it — so a task with a
    sentence of prose before its fence, or a space after ```bash, could be
    RECORDED by this tool and then read back as having no fence at all, which the
    sweep calls superseded. A claim disappearing from the denominator makes the
    rate look better, which is the direction that matters.
    """
    section = re.search(r"^## Acceptance\s*$(.*?)(?=^## |\Z)", text, re.M | re.S)
    if not section:
        return None
    fence = ACCEPTANCE_FENCE.search(section.group(1))
    return fence.group(1) if fence else None


def runs_nothing(fence):
    """True when a fence has no executable content at all.

    Empty, whitespace, or only comments. All of them exit 0, so a reader trusting
    the exit code calls the claim held — a claim proved by a command that does
    nothing, which is the vacuity this whole mode exists to refuse. adr-verify
    will not RECORD such a fence, so it can only arrive by hand.
    """
    return not any(line.strip() and not line.strip().startswith("#")
                   for line in (fence or "").splitlines())


def main():
    args, task, cwd, human = sys.argv[1:], None, None, None

    def value(i, flag):
        """The operand after a flag, or a usage error rather than a traceback.

        Every value-taking flag here indexed `args[i + 1]` directly, so eight of
        them ended a missing operand with `IndexError: list index out of range`
        and a Python traceback — which reads like the tool is broken rather than
        like the command was. Found 2026-08-28 by a stress case on `--sweep`;
        fixed for the class, because the other seven had the same line.
        """
        if i >= len(args):
            fail(f"{flag} needs a value")
        return args[i]

    mutant = frm = to = why = None
    restore = False
    sweep = None
    human_mutant = None
    test_name = None
    test_exit = None
    also_restore = []
    timeout = SWEEP_TIMEOUT_DEFAULT
    as_json = False
    saw_timeout = False
    i = 0
    while i < len(args):
        if args[i] == "--cwd":
            i += 1
            cwd = Path(value(i, "--cwd"))
        elif args[i] == "--human":
            i += 1
            human = value(i, "--human")
        elif args[i] == "--mutant":
            i += 1
            mutant = value(i, "--mutant")
        elif args[i] == "--also-restore":
            i += 1
            also_restore.append(value(i, "--also-restore"))
        elif args[i] == "--human-mutant":
            i += 1
            human_mutant = value(i, "--human-mutant")
        elif args[i] == "--test":
            i += 1
            test_name = value(i, "--test")
        elif args[i] == "--test-exit":
            i += 1
            # Validated here rather than at use: a non-number would otherwise
            # reach the row as text and be refused by the grammar with a message
            # about the grammar, which tells the author nothing about what they
            # typed.
            raw = value(i, "--test-exit")
            try:
                test_exit = int(raw)
            except ValueError:
                fail(f"--test-exit wants the exit code the test returned, not {raw!r}")
            if test_exit <= 0:
                fail(f"--test-exit must be non-zero: a test that returned {test_exit} PASSED, "
                     f"so nothing was killed. This is the same constraint the tool-written "
                     f"arm carries; a kill claimed on a passing test is refused on its face.")
        elif args[i] == "--from":
            i += 1
            frm = value(i, "--from")
        elif args[i] == "--to":
            i += 1
            to = value(i, "--to")
        elif args[i] == "--why":
            i += 1
            why = value(i, "--why")
        elif args[i] == "--sweep":
            i += 1
            sweep = value(i, "--sweep")
        elif args[i] == "--timeout":
            i += 1
            # Validated, because the two ways this goes wrong are both silent:
            # a non-number raises a traceback that reads like a crash, and 0 or a
            # negative means "no bound" to subprocess.run — so the guard against a
            # fence that never finishes would itself never finish.
            try:
                timeout = int(value(i, "--timeout"))
                saw_timeout = True
            except ValueError:
                fail(f"--timeout wants a whole number of seconds, not {args[i]!r}")
            if timeout <= 0:
                fail(f"--timeout must be a positive number of seconds, not {timeout}")
        elif args[i] == "--json":
            as_json = True
        elif args[i] == "--restore":
            restore = True
        elif args[i].startswith("--"):
            # Without this an unknown flag becomes the task path, and its VALUE
            # becomes the next one: `--why probe` with --why renamed reported
            # `task file not found: probe`, which reads like a missing file
            # rather than a gate that no longer speaks the documented interface.
            fail(f"unknown option: {args[i]}")
        else:
            task = Path(args[i])
        i += 1
    # Recovery needs no task file: the run that needs recovering is the one that
    # did not get far enough to finish, and asking for its paperwork first would
    # make the repair harder than the damage.
    if sweep is not None:
        here = Path(sweep).resolve()
        ancestors = [Path(p) for p in os.environ.get(SWEEP_REENTRY_ENV, "").split(os.pathsep) if p]
        if any(here == a or a in here.parents or here in a.parents for a in ancestors):
            # Exit 2 (usage), not 1: this is not a verdict about the corpus.
            print(f"{SWEEP_REENTRY_MARKER} — a task's Acceptance fence invoked "
                  f"--sweep, which would recurse without bound.", file=sys.stderr)
            sys.exit(2)
        if not Path(sweep).is_dir():
            fail(f"not a directory: {sweep}")
        for flag, given in (("--human", human), ("--mutant", mutant),
                            ("--human-mutant", human_mutant), ("--cwd", cwd),
                            ("--also-restore", also_restore or None)):
            if given is not None:
                fail(f"{flag} cannot be combined with --sweep")
        if restore:
            fail("--restore cannot be combined with --sweep")
        sys.exit(sweep_corpus(sweep, timeout=timeout, as_json=as_json))

    if restore:
        if also_restore:
            fail("--also-restore cannot be combined with --restore; recovery reads the durable "
                 "manifest already on disk")
        where = cwd if cwd is not None else Path.cwd()
        if recover_mutant(where) == "absent":
            print(f"[adr-verify] no mutant is recorded for {Path(where).resolve()} — "
                  f"nothing to restore.")
        sys.exit(0)

    if saw_timeout or as_json:
        # Both were unknown options before --sweep existed, so a command carrying
        # one was refused. Accepting and ignoring them is worse than either:
        # `adr-verify task.md --timeout 1` would have run with no timeout at all,
        # and looked like it had one.
        fail("--timeout and --json apply to --sweep only")

    if also_restore and mutant is None:
        fail("--also-restore is valid only with the tool-run --mutant mode")
    if also_restore and human is not None:
        fail("--also-restore cannot be combined with --human; no source mutation runs there")

    if task is None:
        fail(__doc__)
    if not task.exists():
        fail(f"task file not found: {task}")
    text = task.read_text(errors="replace", encoding="utf-8")
    today = datetime.date.today().isoformat()

    if human_mutant is not None:
        # The modes that RUN something are mutually exclusive with the one that
        # does not, for the same reason the existing pair are: a command asking
        # for both has not decided what it is claiming.
        if mutant is not None:
            fail("--human-mutant cannot be combined with --mutant — one records a mutation a "
                 "tool performed and the other one a person did, and a row cannot be both. "
                 "If the fence can run, use --mutant: it is the stronger evidence.")
        if human is not None:
            fail("--human-mutant cannot be combined with --human — they write different logs "
                 "(Mutation Log and Verification Log). Run them separately.")
        if restore:
            fail("--human-mutant cannot be combined with --restore")
        missing = [f for f, v in (("--from", frm), ("--to", to), ("--test", test_name),
                                  ("--test-exit", test_exit), ("--why", why)) if v is None]
        if missing:
            fail(f"--human-mutant needs {', '.join(missing)}. Every one of them is what makes "
                 f"the row checkable by a reader: the diff to re-apply, the test to re-run, the "
                 f"code it returned, and why the Acceptance fence could not run it itself.")
        where = cwd if cwd is not None else Path.cwd()
        write_human_mutant(task, text, where, today, human_mutant, frm, to,
                           test_name, test_exit, why)

    if human is not None:
        entry = f"- {today} · human-observed · {human.strip()}"
        refuse_unreadable(entry, "human-observed")
        append_entry(task, text, entry)
        print(entry)
        sys.exit(0)

    m = re.search(r"^## Acceptance\s*$(.*?)(?=^## |\Z)", text, re.M | re.S)
    if not m:
        fail(f"{task.name}: no ## Acceptance section")
    fm = ACCEPTANCE_FENCE.search(m.group(1))
    if not fm:
        fail(f"{task.name}: no non-empty ```bash fence under ## Acceptance "
             f'(```sh and ```shell are read too; human-observed task? '
             f'use --human "<sign-off>")')
    cmd = normalize_acceptance(fm.group(1))
    if not cmd:
        fail(f"{task.name}: no non-empty ```bash fence under ## Acceptance "
             f'(```sh and ```shell are read too; human-observed task? '
             f'use --human "<sign-off>")')

    if cwd is None:
        r = subprocess.run(["git", "-C", str(task.parent), "rev-parse", "--show-toplevel"],
                           capture_output=True, text=True, encoding="utf-8", errors="replace")
        cwd = Path(r.stdout.strip()) if r.returncode == 0 else task.parent

    # Before anything else touches this tree: a mutant a killed run left behind
    # would otherwise be measured as if it were the code under test, and every
    # verdict after it would be about the defect rather than the change.
    recover_mutant(cwd)

    if mutant is not None:
        run_mutant(task, text, cmd, cwd, today, mutant, frm, to, why, also_restore)

    try:
        r = subprocess.run([bash_or_exit(), "-c", cmd], cwd=cwd, capture_output=True, text=True,
                           encoding="utf-8", errors="replace", timeout=fence_timeout())
    except subprocess.TimeoutExpired as expired:
        # UNRUN, not FAILED. A fence that never returned has not judged the code,
        # and recording exit 1 would put a verdict in the log that nothing
        # observed — the distinction this project holds every gate to (ADR-005).
        # Nothing is written to the task file: an entry claiming a run that did
        # not finish is worse than no entry.
        partial = decode_stream(expired.stdout) + decode_stream(expired.stderr)
        print(f"[adr-verify] UNRUN: the acceptance fence did not finish within "
              f"{fence_timeout()}s and was killed. NOTHING has been written to "
              f"{task.name} — a run that did not finish is not evidence either way. "
              f"Fix the hang, or run the fence yourself and use --human if it is "
              f"genuinely a human-observed check.")
        if partial.strip():
            print("[adr-verify] what it had produced when it was killed:")
            for line in partial.strip().splitlines()[-10:]:
                print(f"  {line}")
        sys.exit(2)

    sha = git_sha(cwd)

    output = r.stdout + r.stderr
    code = r.returncode
    stdout_text, stderr_text = r.stdout or "", r.stderr or ""
    empty = code == 0 and scored_nothing(output)
    if empty:
        # Recorded as a failure, because that is what it is. The task's tests do
        # not exist yet, or the filter no longer matches their names.
        code = 1
        stderr_text += ("\n[adr-verify] the acceptance command exited 0 but scored NO tests. "
                   "A filter that matches nothing is not a passing gate — write the tests "
                   "the Tests table names, or fix the filter so it selects them.")

    if code != 0:
        diagnosis = environment_failure(output, cmd)
        if diagnosis:
            note = (f"\n[adr-verify] ENVIRONMENT: {diagnosis}\n"
                    "             This is a machine problem, not a verdict about the code. "
                    "The run still counts as failed.")
            output += note
            # Into stderr_text too, or the note is printed and not RECORDED: the
            # block is built per stream now, so anything appended to the merged
            # text alone reaches the reader and never the task file
            # (docs/BACKLOG.md §54).
            stderr_text += note

    lines = cmd.splitlines()
    first = lines[0].strip().replace("`", "'") + (" …" if len(lines) > 1 else "")
    digest = acceptance_digest(cmd)
    entry = (f"- {today} · {sha} · exit {code} · `{first}` · "
             f"acceptance-sha256:{digest}")
    refuse_unreadable(entry, sha)
    block = entry
    if code != 0:
        out = failure_tail(stdout_text, stderr_text)
        block += "\n" + "\n".join(["  ```"] + ["  " + ln for ln in out] + ["  ```"])
    append_entry(task, text, block)
    # Say that the file was WRITTEN. Recording the run is the point of this tool —
    # evidence is tool-written or it is not evidence — but nothing said so, and a
    # session that ran it on a hint from the session hook watched `git status` go
    # dirty from what read as a read-only verification. Reported 2026-08-29
    # (docs/BACKLOG.md §57). The surprise is not the write; it is the silence.
    print(f"[adr-verify] WROTE this entry into {task}'s ## Verification Log — "
          f"recording the run IS this tool's job, so the file is now modified; "
          f"commit it with the work it evidences.")
    print(block)
    sys.exit(code)


if __name__ == "__main__":
    main()
