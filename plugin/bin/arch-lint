#!/usr/bin/env python3
"""arch-lint — executable gate for per-repo architecture docs (bundled architecture template).

Usage: arch-lint <architecture.md>

Checks:
  Header   : **Status:** line · **Gate command:** line with a backticked command
  Sections : Module Map, Dependency Contracts, Concept Ownership (DRY), Composition Root,
             Test Doubles, Trust & Data Boundaries, Superseded — all present;
             all but Module Map may be `None — <reason>`
  Module   : Module Map has ≥1 data row (backticked path)
  Checks   : every rule-table data row's last cell is an executable check —
             backticked command/test path or `(deferred: <pointer>)` ·
             sync-prose ("keep in sync", "manually", "by review", …) rejected ·
             unfilled template placeholders (<…>) rejected
  Symbols  : a backticked symbol in a check cell must EXIST — in the file the same cell
             names, or somewhere in the repo. A row citing a check that is not there is
             the same defect as a missing path, one level in. If the symbol reads as a
             test, a failure call must be reachable in its body: a test that cannot go
             red is evidence of nothing. Rows tagged (deferred: …) are skipped.
  Vacuous  : gates that cannot fail — markdown-escaped \\| inside a command matches
             nothing · path-like tokens in check cells and the Gate command must exist
             in the repo ('! grep PAT missing-path' inverts exit 2 into a permanent
             pass). A check whose path doesn't exist yet is tagged (deferred: <pointer>).

Exit: 0 pass · 1 failures found

`--version` prints this gate's name, the version read from the manifest beside
IT, and that root. Ask the gate whose output you are questioning rather than a
resolver: `qh-root` and `qh-doctor` answer which copy is newest on the machine,
which on a box carrying both PATH mechanisms can be a different install from the
one that just ran (ADR-031).
"""
import re
import subprocess
import sys
from pathlib import Path

# --- win32 utf-8 io (D1 fix) -------------------------------------------------
# Windows defaults stdout/stderr and open() to the ANSI codepage. These tools
# print and WRITE `·` and `—`; under cp1252 a `·` lands as a bare 0xB7 byte,
# which is not valid UTF-8, so an append-only evidence file becomes undecodable.
# Child process output decodes with that same default, so the git probe below
# names its encoding rather than inheriting the codepage.
import sys as _sys
for _s in (_sys.stdout, _sys.stderr):
    try:
        _s.reconfigure(encoding="utf-8", errors="replace")
    except Exception:
        pass
# ---------------------------------------------------------------------------

RULE_SECTIONS = ["Dependency Contracts", "Concept Ownership (DRY)", "Composition Root",
                 "Test Doubles", "Trust & Data Boundaries"]
ALL_SECTIONS = ["Module Map"] + RULE_SECTIONS + ["Superseded"]
SYNC_PROSE = re.compile(r"keep.{0,12}sync|manually|by review|remember|be careful|discipline",
                        re.I)


def sections_of(text):
    out, cur, fence = {}, None, False
    for line in text.splitlines():
        if line.lstrip().startswith("```"):
            fence = not fence
        m = None if fence else re.match(r"^## (.+?)\s*$", line)
        if m:
            cur = m.group(1)
            out[cur] = []
        elif cur is not None:
            out[cur].append(line)
    return out


def data_rows(lines):
    """Table data rows: skip the header row and |---| separators."""
    rows = [ln for ln in lines if ln.strip().startswith("|")]
    return [r for r in rows[1:] if not re.match(r"^\|[\s\-|:]+\|?$", r.strip())]


def is_none_section(lines):
    return any(re.match(r"^\s*`?None( yet)?\b", ln) for ln in lines)


def repo_roots(doc):
    roots = [doc.parent, doc.parent.parent]
    try:
        r = subprocess.run(["git", "-C", str(doc.parent), "rev-parse", "--show-toplevel"],
                           capture_output=True, text=True, timeout=10,
                           encoding="utf-8", errors="replace")
        if r.returncode == 0:
            roots.append(Path(r.stdout.strip()))
    except Exception:
        pass
    return roots


class Findings(list):
    """Findings that block, and a second channel for the ones that should not.

    Most of this gate blocks, and that is not an oversight: nearly every rule
    here asks whether a claimed check EXISTS and can fail. A rule row citing a
    path that is not in the repo, a symbol that is nowhere, a test with no
    failure call, or an escaped `\\|` that matches nothing in a shell — each is a
    check written down as evidence with nothing behind it, which is the failure
    this gate was built for.

    What advises is form: a header or section that is ABSENT. The line is between
    form and content — a section present and EMPTY is content.
    """

    def __init__(self):
        super().__init__()
        self.advice = []

    def advise(self, message):
        self.advice.append(message)


def vacuous_gate_errors(label, cell, roots):
    """Static vacuous-pass detection for one check cell / gate command."""
    errs = []
    if r"\|" in cell:
        errs.append(f"{label}: markdown-escaped \\| inside the command — copied from a table "
                    f"cell, matches nothing in a shell: {cell[:60]}")
    for cmd in re.findall(r"`([^`]+)`", cell):
        for tok in cmd.split():
            tok = tok.strip("'\";,").split("::")[0]
            if tok.startswith("-") or "/" not in tok or "*" in tok or tok.startswith("$"):
                continue
            if not any((r / tok).exists() for r in roots):
                errs.append(f"{label}: path '{tok}' does not exist in the repo — a gate on a "
                            f"missing path cannot fail ('! grep' turns exit 2 into a permanent "
                            f"pass); tag the row '(deferred: <pointer>)' until the check exists: "
                            f"{cmd[:60]}")
    return errs

# A check cell names two kinds of thing: a PATH and, usually, a SYMBOL — the test
# or function that does the checking. arch-lint already required the path to
# exist. These two require the same of the symbol, and of its ability to fail.
#
# Both are deliberately language-agnostic: they work on tokens and file text, not
# on a parser, so the same flaw is caught in a Go repo, a PHP one and a Rust one.
# The flaw class is one this pipeline has now hit three times in three different
# artefacts — a name written down as evidence, which nothing behind it supports.

# Words that appear in backticks but are not symbols to resolve.
NOT_A_SYMBOL = re.compile(
    r"^(none|n/?a|tbd|todo|yes|no|true|false|all|any|each|every|deferred|permanent|"
    r"make|go|npm|yarn|cargo|pytest|phpunit|composer|docker|bash|sh|test|tests|"
    r"lint|build|check|ci|main|master|head)$", re.I)

# A failure must be REACHABLE from a test's body or it can never go red. Covers
# the common runners rather than one language.
FAIL_CALLS = re.compile(
    r"\bt\.(Error|Errorf|Fatal|Fatalf|FailNow|Fail)\b"        # go
    r"|\b(assert|require|expect)\s*[.(]"                       # testify / js / rust / jest
    r"|\bself\.assert|\bassert\s"                            # python
    r"|\$this->assert|\bassertThat\b"                         # php / java
    r"|\bpanic!|\bunreachable!",                               # rust
    re.I)

SKIP_DIRS = {".git", "node_modules", "vendor", "dist", "target", "build", ".claude",
             "__pycache__", ".venv", "venv"}


def code_only(text):
    """Remove comments and string bodies before resolving definitions/assertions."""
    # ⚠ LITERALS FIRST, COMMENT MARKERS SECOND. Reported 2026-09-02 (issue #7):
    # with comments stripped first, a bare `"//"` literal is read as the start of
    # a comment and everything to end of line is deleted — the closing quote, and
    # any `}` or `{` that followed it. `symbol_body` then brace-matches mangled
    # text and either returns the REST OF THE FILE (a vacuous test borrows a later
    # test's assertion and is certified able to fail) or a truncated body (a real
    # assertion below the cut is invisible). The `(^|[^:])` guard protects
    # `"https://…"` and nothing protects the scheme-less form.
    #
    # Blanking literals first also fixes the same class for `/*` and `*/` inside
    # strings, which the old order paired across unrelated lines.
    text = re.sub(r"`(?:[^`])*`", "``", text)
    text = re.sub(r'"(?:[^"\\\n]|\\.)*"', '""', text)
    text = re.sub(r"'(?:[^'\\\n]|\\.)*'", "''", text)
    text = re.sub(r"/\*.*?\*/", " ", text, flags=re.S)
    text = re.sub(r"(?m)(^|[^:])//.*$", r"\1 ", text)
    text = re.sub(r"(?m)#(?!\s*\[).*?$", " ", text)
    return text


def symbol_body(text, symbol):
    """Return only the claimed function body; never borrow from a later test."""
    match = re.search(r"\b" + re.escape(symbol) + r"\b\s*\([^)]*\)[^{;]*?\{", text, re.S)
    if match:
        start, depth = match.end() - 1, 0
        for index in range(start, len(text)):
            if text[index] == "{":
                depth += 1
            elif text[index] == "}":
                depth -= 1
                if depth == 0:
                    return text[start:index + 1]
        return text[start:]
    match = re.search(r"(?m)^([ \t]*)(?:async\s+)?def\s+" + re.escape(symbol)
                      + r"\b[^\n]*:\s*$", text)
    if not match:
        return None
    indent = len(match.group(1).replace("\t", "    "))
    start = match.end()
    for next_line in re.finditer(r"(?m)^([ \t]*)(?:async\s+def|def|class)\s+", text[start:]):
        next_indent = len(next_line.group(1).replace("\t", "    "))
        if next_indent <= indent:
            return text[start:start + next_line.start()]
    return text[start:]


def tracked_paths(root):
    """What git tracks under `root`, plus files staged or newly added but not ignored.

    `rglob` answers "is this on THIS machine", not "is this in the repository"
    (CLAUDE.md §8). An architecture document could cite a symbol that exists only
    in the author's working tree — untracked, or gitignored — and pass here while
    failing for everyone else. `--cached` covers tracked AND STAGED, so a file
    being added in the same commit counts once it is `git add`ed.

    Deliberately NOT `--others --exclude-standard`, which §8 offers for the
    same-commit case: it admits every non-ignored file on disk, so it cannot tell a
    file being added from one that only exists on this laptop — which is the defect
    itself. Staging is the cheap, explicit signal that a file is meant to ship.

    Returns None when git cannot answer, so the caller can SAY it fell back rather
    than reporting a narrower search as a finding (ADR-005).
    """
    try:
        r = subprocess.run(["git", "-C", str(root), "ls-files", "--cached"],
                           capture_output=True, timeout=30, text=True, encoding="utf-8", errors="replace")
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0:
        return None
    return {(root / line).resolve() for line in r.stdout.splitlines() if line.strip()}


def repo_files(root, limit=6000):
    """Text files under root, cheaply — enough to resolve a symbol name."""
    out = []
    tracked = tracked_paths(root)
    for q in root.rglob("*"):
        if len(out) >= limit:
            break
        if not q.is_file():
            continue
        if any(part in SKIP_DIRS for part in q.parts):
            continue
        # A file git does not know about cannot satisfy an architecture claim.
        if tracked is not None and q.resolve() not in tracked:
            continue
        if q.suffix.lower() in {".png", ".jpg", ".jpeg", ".gif", ".pdf", ".zip", ".gz",
                                ".ico", ".woff", ".woff2", ".ttf", ".mp4", ".bin", ".so",
                                ".dylib", ".exe", ".wasm"}:
            continue
        out.append(q)
    return out


def symbol_tokens(cell):
    """Backticked tokens in a check cell that name a symbol rather than a path."""
    out = []
    for tok in re.findall(r"`([^`]+)`", cell):
        tok = tok.strip()
        if " " in tok or "/" in tok or tok.startswith("-") or tok.startswith("$"):
            continue  # a command or a path, handled elsewhere
        if "." in tok and not tok.replace("_", "").replace(".", "").isalnum():
            continue
        if len(tok) < 3 or NOT_A_SYMBOL.match(tok):
            continue
        if not re.match(r"^[A-Za-z_][A-Za-z0-9_:.\-]*$", tok):
            continue
        if "." in tok and re.search(r"\.[a-z]{1,4}$", tok):
            continue  # looks like a bare filename; the path check owns it
        out.append(tok)
    return out


def path_tokens(cell, roots):
    """Existing files a check cell names, so a symbol can be looked for in them."""
    found = []
    for tok in re.findall(r"`([^`]+)`", cell):
        for t in tok.split():
            t = t.strip("'\";,")
            if "/" not in t or "*" in t:
                continue
            for r in roots:
                if (r / t).is_file():
                    found.append(r / t)
    return found


def symbol_errors(label, cell, roots, index):
    """A symbol a check cell names must exist, and if it is a test, must be able to fail."""
    errs = []
    if re.search(r"\(deferred:", cell):
        return errs  # explicitly not built yet
    syms = symbol_tokens(cell)
    if not syms:
        return errs
    named = path_tokens(cell, roots)
    for sym in syms:
        defn = re.compile(r"(?m)^\s*(func|def|fn|class|const|var|let|function|public|private|"
                          r"protected|static|it|test|describe)?\s*[\w\[\]\*\(\)\s]{0,60}?\b"
                          + re.escape(sym) + r"\b")
        hits = [f for f in named if defn.search(code_only(f.read_text(errors="replace", encoding="utf-8")))]
        if not hits and named:
            errs.append(f"{label}: names `{sym}` alongside "
                        f"{', '.join(f.name for f in named)}, but that file does not contain it — "
                        f"the row cites a check that is not in the file it points at")
            continue
        if not hits:
            # A DEFINITION, not a mention: the doc that cites a symbol contains it too,
            # and resolving to the citation is how a check confirms itself.
            hits = [f for f in index
                    if f.suffix.lower() not in {".md", ".markdown", ".rst", ".txt"}
                    and defn.search(code_only(f.read_text(errors="replace", encoding="utf-8")))]
            if not hits:
                errs.append(f"{label}: names `{sym}`, which appears nowhere in the repo — "
                            f"the row cites a check that does not exist")
                continue
        # If it reads as a test, a failure must be reachable from its body.
        if not re.match(r"^(Test|test_|it_|should_|spec_)", sym):
            continue
        body = None
        for f in hits:
            # STRIPPED, deliberately, and NOT the raw-then-strip shape adr-lint
            # uses. Issue #7 suggested mirroring adr-lint; measured 2026-09-02
            # that is the weaker of the two fixes and introduces a defect of the
            # same class: raw text counts a brace INSIDE a string literal, so
            # `if s == "}" {` truncates the body and loses the assertion below
            # it. With code_only blanking literals before comment markers (the
            # root-cause fix above), stripped text is strictly better for brace
            # matching — string braces are blanked away and comment markers
            # inside strings are protected. adr-lint needs raw for an unrelated
            # reason: its BDD tests are NAMED by a string, and pre-stripping
            # deletes the name it searches for.
            text = code_only(f.read_text(errors="replace", encoding="utf-8"))
            body = symbol_body(text, sym)
            if body is None:
                continue
            break
        # A test that delegates its assertions to a helper still fails when the
        # helper does. Follow ONE level: any same-file function the body calls
        # that itself contains a failure call counts as part of the test.
        #
        # Ported from adr-lint, which has had this since its own version of the
        # check and says so in its message. Issue #7 point 2: the two gates
        # diverged here in the same direction as the comment-ordering defect —
        # one hardened, its sibling left carrying the hole — so a Go test whose
        # assertions live in a shared helper read as unable to go red.
        if body is not None and not FAIL_CALLS.search(body):
            for callee in set(re.findall(r"\b([a-z_]\w{2,})\s*\(", body)):
                helper = symbol_body(text, callee)
                if helper and FAIL_CALLS.search(helper):
                    body += helper
                    break
        if body is not None and not FAIL_CALLS.search(body):
            errs.append(f"{label}: names the test `{sym}`, but no failure call is reachable in "
                        f"its body or in a same-file helper it calls — a test that cannot go red "
                        f"is evidence of nothing")
    return errs


def reject_unknown_flags(known=()):
    """A flag this gate does not know is a typo, and a gate that ignores one
    answers a question nobody asked.

    Measured 2026-08-26: `adr-next tasks --jsonn` printed the human report and
    exited 0. lifecycle.mjs asks for `--json` and JSON.parse()s the result inside
    a try/catch that continues on failure, so a renamed or mistyped flag would
    have made session orientation silently empty at exit 0 — the same fail-open,
    by a different route, as the `#!` spawn that BACKLOG item 17 fixed.
    """
    unknown = [a for a in sys.argv[1:] if a.startswith("--") and a not in known]
    if unknown:
        print(f"unknown option: {unknown[0]}", file=sys.stderr)
        sys.exit(1)


# ADR-031. Every gate answers for ITSELF, and the answer is read from the
# manifest beside the gate rather than from a resolver. A central answer —
# `qh-root`, `qh-doctor`, a `qh-version` gate — reports whichever copy of
# ITSELF resolved, which on a machine carrying both PATH mechanisms
# (CLAUDE.md §2) is a different install from the gate whose output is being
# questioned. A version that can be about another binary is worse than none,
# because it resolves.
#
# Imports are local so this block is byte-identical in all eleven gates, which
# is what lets a test assert they have not drifted apart. Read at run time and
# never baked at release: a substituted constant is a stored count, and this
# corpus keeps finding stored counts wrong.
def report_version():
    import json as _json
    from pathlib import Path as _Path
    here = _Path(__file__).resolve()
    manifest = here.parent.parent / ".claude-plugin" / "plugin.json"
    try:
        version = _json.loads(manifest.read_text(encoding="utf-8"))["version"]
    except Exception as exc:
        # ADR-005: could not read is not a version. Never guess, and never fall
        # back to a resolver — that would answer about a different tree and look
        # exactly like success.
        print(f"{here.name} (version unreadable: {manifest} — {exc})")
        return
    print(f"{here.name} {version} ({here.parent.parent})")


def main():
    if "--version" in sys.argv[1:]:
        report_version()
        sys.exit(0)
    reject_unknown_flags()
    if len(sys.argv) != 2:
        print(__doc__)
        sys.exit(1)
    path = Path(sys.argv[1])
    if not path.exists():
        print(f"file not found: {path}")
        sys.exit(1)
    text = path.read_text(errors="replace", encoding="utf-8")
    errors = Findings()

    if not re.search(r"^\*\*Status:\*\*", text, re.M):
        errors.advise("no **Status:** line")
    roots = repo_roots(path)
    gm = re.search(r"^\*\*Gate command:\*\*\s*(`[^`]+`)", text, re.M)
    if not gm:
        errors.advise("no **Gate command:** line with a backticked command")
    else:
        errors.extend(vacuous_gate_errors("Gate command", gm.group(1), roots))

    # One cheap file listing, reused for every symbol lookup below. It must be built
    # from the REPO root, not the first candidate: the doc's own directory is first
    # in `roots`, and indexing that made the architecture document the only file
    # containing its own test names — every symbol "resolved" to the doc that cited
    # it, and every test then read as unable to fail. A lookup whose corpus is the
    # claim being checked confirms itself.
    index = []
    widest = None
    for r in roots:
        if not r.is_dir():
            continue
        if (r / ".git").exists() or (r / "go.mod").exists() or (r / "package.json").exists():
            widest = r
            break
    if widest is None:
        widest = roots[-1] if roots else None
    if widest is not None and widest.is_dir():
        index = repo_files(widest)

    secs = sections_of(text)
    for s in ALL_SECTIONS:
        if s not in secs:
            errors.advise(f"missing section ## {s}")

    mm = data_rows(secs.get("Module Map", []))
    mm = [r for r in mm if "`" in r]
    if "Module Map" in secs and not mm:
        errors.append("Module Map has no data rows (a row with a backticked module path)")

    for s in RULE_SECTIONS:
        lines = secs.get(s, [])
        if not lines:
            continue
        if is_none_section(lines):
            continue
        rows = data_rows(lines)
        if not rows:
            errors.append(f"{s}: no data rows and no 'None — <reason>' escape")
            continue
        for r in rows:
            # \| is an escaped pipe INSIDE a cell (e.g. a grep alternation) — not a delimiter
            cells = [c.strip() for c in re.split(r"(?<!\\)\|", r.strip().strip("|"))]
            check = cells[-1] if cells else ""
            if not check:
                errors.append(f"{s}: row has empty check cell: {r.strip()[:70]}")
                continue
            if re.search(r"<[^>]+>", check) and "deferred" not in check:
                errors.append(f"{s}: check cell is an unfilled template placeholder: {check[:60]}")
                continue
            if SYNC_PROSE.search(check):
                errors.append(f"{s}: check cell is sync-prose, not an executable check: "
                              f"{check[:60]}")
                continue
            if re.search(r"\(deferred:\s*[^)\s][^)]*\)", check):
                continue
            if "`" not in check:
                errors.append(f"{s}: check cell has no backticked command/test path and no "
                              f"'(deferred: <pointer>)': {check[:60]}")
                continue
            errors.extend(vacuous_gate_errors(s, check, roots))
            errors.extend(symbol_errors(s, check, roots, index))

    status = "PASS" if not errors else "FAIL"
    print(f"[{status}] {path}")
    for e in errors:
        print(f"  {e}")
    # Printed on a PASS too: acceptable and finished are different things.
    for a in errors.advice:
        print(f"  advice: {a}")
    sys.exit(1 if errors else 0)


if __name__ == "__main__":
    main()
