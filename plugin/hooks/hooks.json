{
  "description": "Universal quality lifecycle hooks",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/qh-hook.sh",
              "hook",
              "SessionStart"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/qh-hook.sh",
              "bridge",
              "branch-state",
              "--cached",
              "120"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/qh-hook.sh",
              "bridge",
              "branch-state",
              "--brief",
              "--cached",
              "120"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/qh-hook.sh",
              "hook",
              "SubagentStart"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/qh-hook.sh",
              "hook",
              "SubagentStop"
            ],
            "timeout": 120
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/qh-hook.sh",
              "hook",
              "TaskCompleted"
            ],
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/qh-hook.sh",
              "hook",
              "Stop"
            ],
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit|mcp__mrw__mrw_write",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/qh-hook.sh",
              "hook",
              "PreToolUse"
            ],
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/qh-hook.sh",
              "hook",
              "PreToolUse"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/qh-hook.sh",
              "bridge",
              "shell-hook",
              "facts-gate-dispatch.sh"
            ],
            "timeout": 120
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/qh-hook.sh",
              "bridge",
              "shell-hook",
              "post-edit-check.sh"
            ],
            "timeout": 120
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/qh-hook.sh",
              "hook",
              "PostToolUse"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "mcp__mrw__mrw_write",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/qh-hook.sh",
              "hook",
              "PostToolUse"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/qh-hook.sh",
              "hook",
              "PreCompact"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/qh-hook.sh",
              "hook",
              "SessionEnd"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
