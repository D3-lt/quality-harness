{
  "mutations": [
    {
      "label": "ADR-131: a verified launch repeats platform utility invocations",
      "file": "plugin/scripts/qh-hook.sh",
      "tests": [
        "tests/launcher-cost.test.mjs"
      ],
      "from": "platform=$(uname -sm)",
      "to": "platform=$(uname -s); platform=\"$platform $(uname -m)\"",
      "only": "^verified launcher avoids redundant utilities while preserving native paths, payload and checksums$"
    },
    {
      "label": "Go cutover: a tampered cached binary runs",
      "file": "plugin/scripts/qh-hook.sh",
      "tests": [
        "tests/qh-launcher.test.mjs"
      ],
      "from": "[ \"${actual%% *}\" = \"$expected\" ]",
      "to": "return 0"
    },
    {
      "label": "Go cutover: a later hook event fetches the core",
      "file": "plugin/scripts/qh-hook.sh",
      "tests": [
        "tests/qh-launcher.test.mjs"
      ],
      "from": "[ \"${2:-}\" = SessionStart ]",
      "to": "[ -n \"${2:-}\" ]"
    },
    {
      "label": "Go cutover: bootstrap consumes the native hook payload",
      "file": "plugin/scripts/qh-hook.sh",
      "tests": [
        "tests/qh-launcher.test.mjs"
      ],
      "from": "\"$data\" </dev/null",
      "to": "\"$data\""
    },
    {
      "label": "ADR-132: installed bundles use a cache instead of their own binary",
      "file": "plugin/scripts/qh-hook.sh",
      "tests": [
        "tests/bundled-core.test.mjs"
      ],
      "from": "binary=\"$root/native/$asset\"",
      "to": "binary=\"$data/qh/$version/$asset\""
    },
    {
      "label": "ADR-132: a missing bundled native directory becomes a source-checkout fetch",
      "file": "plugin/scripts/qh-hook.sh",
      "tests": [
        "tests/bundled-core.test.mjs"
      ],
      "from": "[ -f \"$root/.claude-plugin/bundle.json\" ] || [ -d \"$root/native\" ]",
      "to": "[ -d \"$root/native\" ]"
    }
  ]
}
